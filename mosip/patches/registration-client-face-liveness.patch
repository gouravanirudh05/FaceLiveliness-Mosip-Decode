+	@Test
+	public void deviceDisconnectEndsTheSessionAsADeviceError() throws Exception {
+		assumeTrue("liveness engine not running", listening(LIVENESS_PORT));
+		PipedOutputStream device = new PipedOutputStream();
+		streamer.startStream(new PipedInputStream(device), new ImageView(), null); // sends no frames
+		CompletableFuture<FaceLivenessGuard.Verdict> result = CompletableFuture
+				.supplyAsync(() -> guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app1"));
+		Thread.sleep(1500);
+		device.close();                                  // unplugged: the stream ends (EOF), not stopped by the client
+		FaceLivenessGuard.Verdict verdict = result.get(30, TimeUnit.SECONDS);
+		assertDeviceError(verdict, FaceLivenessGuard.DEVICE_DISCONNECTED_MESSAGE);
+		assertFalse("the streamer must notice the end of the stream", streamer.isStreaming());
+	}
+
+	@Test
+	public void deviceThatSendsNoFramesIsReportedQuickly() throws Exception {
+		assumeTrue("liveness engine not running", listening(LIVENESS_PORT));
+		set("device.frame.timeout.seconds", "2");
+		PipedOutputStream device = new PipedOutputStream();
+		streamer.startStream(new PipedInputStream(device), new ImageView(), null); // connected, silent
+		long start = System.nanoTime();
+		FaceLivenessGuard.Verdict verdict = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app1");
+		long seconds = TimeUnit.NANOSECONDS.toSeconds(System.nanoTime() - start);
+		assertDeviceError(verdict, FaceLivenessGuard.DEVICE_UNAVAILABLE_MESSAGE);
+		assertTrue("took " + seconds + " s", seconds < 10);
+		device.close();
+	}
+
+	@Test
+	public void deviceThatSendsInvalidFramesIsReported() throws Exception {
+		assumeTrue("liveness engine not running", listening(LIVENESS_PORT));
+		PipedOutputStream device = new PipedOutputStream();
+		streamer.startStream(new PipedInputStream(device, 1 << 16), new ImageView(), null);
+		Thread garbage = new Thread(() -> {
+			try {
+				byte[] notJpeg = new byte[64];
+				notJpeg[0] = (byte) 0xFF;                    // passes the MJPEG reader, is not a JPEG (no FFD8)
+				for (int i = 0; i < 200; i++) {
+					device.write(mjpegPart(notJpeg));
+					Thread.sleep(20);
+				}
+			} catch (Exception stopped) {
+				// pipe closed
+			}
+		});
+		garbage.setDaemon(true);
+		garbage.start();
+		FaceLivenessGuard.Verdict verdict = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app1");
+		assertDeviceError(verdict, FaceLivenessGuard.DEVICE_INVALID_FRAMES_MESSAGE);
+		device.close();
+	}
