index 0000000000000000000000000000000000000000..ae81d5832d283f84008443eb105c1facbb6e0bfa
--- /dev/null
+++ b/registration/registration-client/src/main/java/io/mosip/registration/controller/device/LivenessOverlayPane.java
@@ -0,0 +1,172 @@
+package io.mosip.registration.controller.device;
+
+import io.mosip.extensions.liveness.client.LivenessUpdate;
+import javafx.animation.PauseTransition;
+import javafx.application.Platform;
+import javafx.geometry.Insets;
+import javafx.geometry.Pos;
+import javafx.scene.control.Label;
+import javafx.scene.control.ProgressBar;
+import javafx.scene.layout.StackPane;
+import javafx.scene.layout.VBox;
+import javafx.scene.paint.Color;
+import javafx.scene.shape.Ellipse;
+import javafx.util.Duration;
+
+/**
+ * Face liveness feedback drawn over the live face preview (spec 10.1-10.7): a positioning oval, the liveness
+ * status ("Checking face liveness…", the challenge prompt, "Action detected", retry guidance, the result), and a
+ * progress bar.
+ *
+ * <p>Declared in the face capture / authentication FXML in the same cell (or bounds) as the preview ImageView, so
+ * it overlays the stream. Hidden while no liveness session runs; never intercepts mouse events. All public methods
+ * may be called from any thread.
+ */
+public class LivenessOverlayPane extends StackPane {
+
+	private static final String BAND_STYLE = "-fx-background-color: rgba(0,0,0,0.72); -fx-background-radius: 6;";
+	private static final String STATUS_STYLE = "-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;";
+	private static final String GUIDANCE_STYLE = "-fx-text-fill: #ffd54f; -fx-font-size: 13px;";
+
+	private final Ellipse guide = new Ellipse();
+	private final Label status = new Label();
+	private final Label guidance = new Label();
+	private final ProgressBar progress = new ProgressBar(0);
+	private String currentPrompt = "";
+
+	public LivenessOverlayPane() {
+		setMouseTransparent(true);
+		setPickOnBounds(false);
+		setVisible(false);
+		setMaxSize(Double.MAX_VALUE, Double.MAX_VALUE);
+
+		guide.setFill(Color.TRANSPARENT);
+		guide.setStroke(Color.web("#ffffffcc"));
+		guide.setStrokeWidth(2);
+		guide.getStrokeDashArray().addAll(10.0, 8.0);
+		guide.radiusXProperty().bind(widthProperty().multiply(0.28));
+		guide.radiusYProperty().bind(heightProperty().multiply(0.36));
+		guide.setManaged(false);
+		guide.centerXProperty().bind(widthProperty().divide(2));
+		guide.centerYProperty().bind(heightProperty().multiply(0.45));
+
+		status.setStyle(STATUS_STYLE);
+		status.setWrapText(true);
+		guidance.setStyle(GUIDANCE_STYLE);
+		guidance.setWrapText(true);
+		progress.setMaxWidth(Double.MAX_VALUE);
+		VBox band = new VBox(4, status, guidance, progress);
+		band.setPadding(new Insets(6, 10, 6, 10));
+		band.setStyle(BAND_STYLE);
+		band.setMaxHeight(USE_PREF_SIZE);
+		StackPane.setAlignment(band, Pos.BOTTOM_CENTER);
+		StackPane.setMargin(band, new Insets(4));
+
+		getChildren().addAll(guide, band);
+	}
+
+	/** Shows the overlay in its initial passive-check state. */
+	public void start(String text) {
+		fx(() -> {
+			currentPrompt = "";
+			guide.setStroke(Color.web("#ffffffcc"));
+			status.setText(text);
+			guidance.setText("");
+			progress.setProgress(0);
+			setVisible(true);
+		});
+	}
+
+	public void show(LivenessUpdate update) {
+		if (update == null) {
+			return;
+		}
+		fx(() -> apply(update));
+	}
+
+	/** Shows the final message (green when passed, red otherwise), then hides after a short pause. */
+	public void finish(String text, boolean passed) {
+		fx(() -> {
+			guide.setStroke(passed ? Color.web("#66bb6a") : Color.web("#ef5350"));
+			status.setText(text == null ? "" : text);
+			guidance.setText("");
+			progress.setProgress(passed ? 1 : 0);
+			setVisible(true);
+			PauseTransition pause = new PauseTransition(Duration.seconds(passed ? 1.5 : 3));
+			pause.setOnFinished(e -> setVisible(false));
+			pause.play();
+		});
+	}
+
+	public void hide() {
+		fx(() -> setVisible(false));
+	}
+
+	String getStatusText() {
+		return status.getText();
+	}
+
+	String getGuidanceText() {
+		return guidance.getText();
+	}
+
+	private void apply(LivenessUpdate update) {
+		setVisible(true);
+		switch (update.getKind()) {
+		case CHECKING:
+			status.setText(update.getText());
+			guidance.setText(String.join("  ", update.getGuidance()));
+			progress.setProgress(update.getProgress());
+			break;
+		case CHALLENGE:
+			currentPrompt = update.getText();
+			status.setText(currentPrompt);
+			guidance.setText(challengeLine(update));
+			progress.setProgress(0);
+			break;
+		case FEEDBACK:
+			status.setText(currentPrompt.isEmpty() ? update.getText() : currentPrompt);
+			guidance.setText(update.getText());
+			progress.setProgress(update.getProgress());
+			break;
+		case CHALLENGE_RESULT:
+			if (update.isPassed()) {
+				guidance.setText(update.getText());
+				progress.setProgress(1);
+			}
+			break;
+		case RETRY:
+			status.setText(update.getText());
+			guidance.setText(retryLine(update.getRetriesRemaining()) + "  " + String.join("  ", update.getGuidance()));
+			progress.setProgress(0);
+			break;
+		default:
+			break; // DONE is shown through finish()
+		}
+	}
+
+	/** "Step 2 of 3 · 6 s" (challenge progress and time limit). */
+	static String challengeLine(LivenessUpdate update) {
+		String time = String.format("%d s", Math.max(1, update.getTimeoutMs() / 1000));
+		return update.getTotalSteps() > 0
+				? String.format("Step %d of %d \u00b7 %s", update.getStep(), update.getTotalSteps(), time)
+				: time;
+	}
+
+	/** Spec 10.7: say clearly that a retry is available, and how many are left. */
+	static String retryLine(int retriesRemaining) {
+		if (retriesRemaining < 0) {
+			return "Retrying…";
+		}
+		return "Retry available \u2013 starting again shortly"
+				+ (retriesRemaining == 0 ? " (last attempt)." : " (" + retriesRemaining + " more after this).");
+	}
+
+	private static void fx(Runnable r) {
+		if (Platform.isFxApplicationThread()) {
+			r.run();
+		} else {
+			Platform.runLater(r);
+		}
+	}
+}
