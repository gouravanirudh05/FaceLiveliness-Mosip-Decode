+package io.mosip.registration.controller.device;
+
+import java.io.File;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BooleanSupplier;
+
+import io.mosip.kernel.core.logger.spi.Logger;
+import io.mosip.registration.config.AppConfig;
+
+/**
+ * Starts the bundled local liveness engine (face-liveness-passive service, which also runs active challenges)
+ * when the client needs it and it is not already running, and stops it again when the client exits.
+ *
+ * <p>The engine is a local child process, so liveness keeps working offline. If the engine is already running
+ * (e.g. installed as a system service) it is used as is and never stopped by the client.
+ */
+final class LivenessEngineManager {
+
+	private static final Logger LOGGER = AppConfig.getLogger(LivenessEngineManager.class);
+
+	private Process process;
+
+	/**
+	 * Ensures the engine answers {@code available}. Starts {@code command} in {@code workDir} if needed and waits up
+	 * to {@code startupSeconds}. Returns true if the engine is available afterwards.
+	 */
+	synchronized boolean ensureRunning(BooleanSupplier available, String command, String workDir, String logFile,
+			int startupSeconds) {
+		if (available.getAsBoolean()) {
+			return true;
+		}
+		if (command == null || command.trim().isEmpty()) {
+			LOGGER.warn("Face liveness engine is not running and no start command is configured");
+			return false;
+		}
+		if (process == null || !process.isAlive()) {
+			List<String> argv = new ArrayList<>(Arrays.asList(command.trim().split("\\s+")));
+			ProcessBuilder pb = new ProcessBuilder(argv);
+			if (workDir != null && !workDir.trim().isEmpty()) {
+				pb.directory(new File(workDir.trim()));
+			}
+			pb.redirectErrorStream(true);
+			File log = new File(logFile == null || logFile.trim().isEmpty() ? "../logs/face-liveness-engine.log" : logFile);
+			if (log.getParentFile() != null) {
+				log.getParentFile().mkdirs();
+			}
+			pb.redirectOutput(ProcessBuilder.Redirect.appendTo(log));
+			try {
+				LOGGER.info("Starting face liveness engine: {} (log {})", argv, log.getAbsolutePath());
+				process = pb.start();
+			} catch (IOException e) {
+				LOGGER.error("Face liveness engine could not be started", e);
+				return false;
+			}
+		}
+		long deadline = System.nanoTime() + TimeUnit.SECONDS.toNanos(Math.max(1, startupSeconds));
+		while (System.nanoTime() < deadline) {
+			if (available.getAsBoolean()) {
+				LOGGER.info("Face liveness engine is up");
+				return true;
+			}
+			if (!process.isAlive()) {
+				LOGGER.error("Face liveness engine exited with code {} during start-up", process.exitValue());
+				process = null;
+				return false;
+			}
+			try {
+				Thread.sleep(500);
+			} catch (InterruptedException e) {
+				Thread.currentThread().interrupt();
+				return false;
+			}
+		}
+		LOGGER.error("Face liveness engine did not become available within {} s", startupSeconds);
+		return false;
+	}
+
+	boolean startedByClient() {
+		return process != null && process.isAlive();
+	}
+
+	/** Stops the engine only if this client started it. */
+	synchronized void stop() {
+		if (process == null) {
+			return;
+		}
+		process.destroy();
+		try {
+			if (!process.waitFor(10, TimeUnit.SECONDS)) {
+				process.destroyForcibly();
+			}
+		} catch (InterruptedException e) {
+			process.destroyForcibly();
+			Thread.currentThread().interrupt();
+		}
+		LOGGER.info("Face liveness engine stopped");
+		process = null;
+	}
+}
diff --git a/registration/registration-client/src/main/java/io/mosip/registration/controller/device/LivenessMetrics.java b/registration/registration-client/src/main/java/io/mosip/registration/controller/device/LivenessMetrics.java
new file mode 100644
index 0000000000000000000000000000000000000000..c3869a094c61d1d877e22c90a6d273daa29e4377
--- /dev/null
+++ b/registration/registration-client/src/main/java/io/mosip/registration/controller/device/LivenessMetrics.java
@@ -0,0 +1,106 @@
+package io.mosip.registration.controller.device;
+
+import java.util.EnumMap;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import io.mosip.extensions.liveness.api.LivenessWorkflow;
+import io.mosip.extensions.liveness.client.LivenessOutcome;
+
+/**
+ * Anonymised liveness performance metrics per workflow (spec good-to-have: average processing time, challenge
+ * completion time, retry rate, failure rate). Counters only: no user, registration, image or score data.
+ * Thread-safe.
+ */
+final class LivenessMetrics {
+
+	private static final class Counters {
+		long sessions;
+		long passed;
+		long failed;
+		long attacks;
+		long engineErrors;
+		long timedOut;
+		long cancelled;
+		long blocked;
+		long deviceErrors;
+		long sessionsWithChallenges;
+		long retries;
+		long processingMs;
+		long challengesPassed;
+		long challengeMs;
+	}
+
+	private final Map<LivenessWorkflow, Counters> counters = new EnumMap<>(LivenessWorkflow.class);
+
+	synchronized void record(LivenessWorkflow workflow, LivenessOutcome outcome, long processingMs, int retries,
+			int challengesPassed, long challengeMs, boolean hadChallenges) {
+		Counters c = counters.computeIfAbsent(workflow, w -> new Counters());
+		c.sessions++;
+		c.processingMs += processingMs;
+		c.retries += retries;
+		c.challengesPassed += challengesPassed;
+		c.challengeMs += challengeMs;
+		if (hadChallenges) {
+			c.sessionsWithChallenges++;
+		}
+		LivenessOutcome.Status status = outcome == null ? LivenessOutcome.Status.FAILED : outcome.getStatus();
+		switch (status) {
+		case PASSED:
+			c.passed++;
+			break;
+		case ENGINE_ERROR:
+			c.engineErrors++;
+			break;
+		case TIMED_OUT:
+			c.timedOut++;
+			break;
+		case CANCELLED:
+			c.cancelled++;
+			break;
+		default:
+			c.failed++;
+		}
+		if (outcome != null && outcome.isAttackDetected()) {
+			c.attacks++;
+		}
+	}
+
+	synchronized void recordBlocked(LivenessWorkflow workflow) {
+		counters.computeIfAbsent(workflow, w -> new Counters()).blocked++;
+	}
+
+	/** A session ended by the device (no stream, disconnect, invalid frames); also counted as cancelled. */
+	synchronized void recordDeviceError(LivenessWorkflow workflow) {
+		counters.computeIfAbsent(workflow, w -> new Counters()).deviceErrors++;
+	}
+
+	/** Snapshot per workflow, e.g. for the diagnostic log or a support view. */
+	synchronized Map<String, Map<String, Object>> snapshot() {
+		Map<String, Map<String, Object>> out = new LinkedHashMap<>();
+		for (Map.Entry<LivenessWorkflow, Counters> e : counters.entrySet()) {
+			Counters c = e.getValue();
+			Map<String, Object> m = new LinkedHashMap<>();
+			m.put("sessions", c.sessions);
+			m.put("passed", c.passed);
+			m.put("failed", c.failed);
+			m.put("presentation_attacks", c.attacks);
+			m.put("timed_out", c.timedOut);
+			m.put("cancelled", c.cancelled);
+			m.put("engine_errors", c.engineErrors);
+			m.put("device_errors", c.deviceErrors);
+			m.put("blocked_after_repeated_failures", c.blocked);
+			m.put("avg_processing_ms", c.sessions == 0 ? 0 : c.processingMs / c.sessions);
+			m.put("avg_challenge_completion_ms", c.challengesPassed == 0 ? 0 : c.challengeMs / c.challengesPassed);
+			m.put("retry_rate", ratio(c.retries, c.sessionsWithChallenges));
+			m.put("failure_rate", ratio(c.failed + c.timedOut, c.sessions - c.cancelled - c.engineErrors));
+			m.put("active_challenge_rate", ratio(c.sessionsWithChallenges, c.sessions));
+			out.put(e.getKey().name(), m);
+		}
+		return out;
+	}
+
+	private static double ratio(long a, long b) {
+		return b <= 0 ? 0.0 : Math.round(1000.0 * a / b) / 1000.0;
+	}
+}
