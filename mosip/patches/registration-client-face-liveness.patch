+	@Test
+	public void endToEndWithMockMdsStreamAndOverlay() throws Exception {
+		needsServices();
+		set("session.timeout.seconds", "90");
+		AtomicInteger frames = new AtomicInteger();
+		Streamer.FrameListener counter = jpeg -> frames.incrementAndGet();
+		streamFromMockMds();
+		Thread.sleep(500);
+		streamer.setFrameListener(counter);
+		Thread.sleep(500);
+		streamer.removeFrameListener(counter);
+		assertTrue("MockMDS delivered no frames through Streamer", frames.get() > 0);
+
+		LivenessOverlayPane overlay = onFx(LivenessOverlayPane::new);
+		long t0 = System.nanoTime();
+		FaceLivenessGuard.Verdict verdict = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, overlay, null,
+				"app-e2e");
+		LivenessOutcome outcome = verdict.getOutcome();
+		System.out.println("[e2e] MockMDS face stream -> " + outcome + " allowed=" + verdict.isAllowed() + " in "
+				+ TimeUnit.NANOSECONDS.toMillis(System.nanoTime() - t0) + " ms");
+		assertNotNull(outcome);
+		assertTrue(outcome.getStatus() == LivenessOutcome.Status.PASSED
+				|| outcome.getStatus() == LivenessOutcome.Status.FAILED);
+		assertTrue("passive liveness analysed the device frames", outcome.getPassiveScore().isPresent());
+		assertEquals(Components.REG_BIOMETRICS, audit.components.get(0));
+		String shown = onFx(overlay::getStatusText);
+		assertFalse("the overlay showed the result", shown.isEmpty());
+		Map<String, Object> m = guard.getMetrics().get("RESIDENT_REGISTRATION");
+		assertEquals(1L, m.get("sessions"));
+	}
+
+	@Test
+	public void configuredThresholdAndActiveSwitchReachTheEngine() throws Exception {
+		needsServices();
+		// MockMDS's photo scores ~0.87 passively. With accept 0.99 it is inconclusive; with challenges switched
+		// off for residents that must fail as "active disabled": both settings came from client configuration.
+		set("resident.passive.threshold", "0.99");
+		set("resident.active.enable", "N");
+		streamFromMockMds();
+		FaceLivenessGuard.Verdict verdict = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app2");
+		assertFalse(verdict.isAllowed());
+		assertEquals("HYBRID_REASON_ACTIVE_DISABLED", verdict.getOutcome().getReason());
+	}
+
+	@Test
+	public void repeatedFailuresBlockFurtherAttemptsForThatSubjectOnly() throws Exception {
+		needsServices();
+		set("resident.passive.threshold", "0.99");
+		set("resident.active.enable", "N");                  // every session fails deterministically
+		set("resident.repeated.failure.max.sessions", "2");
+		streamFromMockMds();
+		for (int i = 0; i < 2; i++) {
+			FaceLivenessGuard.Verdict v = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app3");
+			assertFalse(v.isAllowed());
+			assertFalse(v.isBlocked());
+		}
+		FaceLivenessGuard.Verdict blocked = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app3");
+		assertTrue(blocked.isBlocked());
+		assertNull("no session was run", blocked.getOutcome());
+		assertTrue(blocked.getUserMessage().contains("recovery process"));
+		assertEquals(AuditEvent.REG_FACE_LIVENESS_BLOCKED, audit.events.get(audit.events.size() - 1));
+
+		FaceLivenessGuard.Verdict other = guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app4");
+		assertFalse("another registration is not blocked", other.isBlocked());
+
+		set("resident.repeated.failure.action", "CONTINUE");
+		assertFalse(guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app3").isBlocked());
+		assertEquals(1L, guard.getMetrics().get("RESIDENT_REGISTRATION").get("blocked_after_repeated_failures"));
+	}
+
+	@Test
+	public void clientStartsTheBundledEngineWhenItIsNotRunningAndStopsItOnExit() throws Exception {
+		File python = new File(System.getProperty("user.home"), "miniconda3/envs/face-liveness-passive/bin/python");
+		File engineDir = new File("../../../../face-liveness-passive").getCanonicalFile();
+		assumeTrue("engine environment not installed", python.canExecute() && engineDir.isDirectory());
+		int port = 50061;
+		assumeTrue("port " + port + " busy", !listening(port));
+		set("service.port", String.valueOf(port));
+		set("service.command", python.getPath() + " -m passive_liveness.server --port " + port);
+		set("service.workdir", engineDir.getPath());
+		set("service.log", new File("target/face-liveness-engine-test.log").getAbsolutePath());
+		set("session.timeout.seconds", "10");               // no stream in this test: end the session quickly
+
+		String diagnostics = CompletableFuture.supplyAsync(() -> {
+			guard.verify(LivenessWorkflow.OPERATOR_AUTHENTICATION, null, null, "op9"); // no stream: times out/cancels
+			return guard.getDiagnostics();
+		}).get(5, TimeUnit.MINUTES);
+		assertTrue(diagnostics, diagnostics.contains("available (started by this client)"));
+		assertTrue(diagnostics, diagnostics.contains("\"unified\""));
+		guard.destroy();
+		Thread.sleep(1000);
+		assertFalse("engine stopped with the client", listening(port));
+	}
+
+	private static <T> T onFx(java.util.concurrent.Callable<T> c) throws Exception {
+		CompletableFuture<T> f = new CompletableFuture<>();
+		Platform.runLater(() -> {
+			try {
+				f.complete(c.call());
+			} catch (Exception e) {
+				f.completeExceptionally(e);
+			}
+		});
+		return f.get(10, TimeUnit.SECONDS);
+	}
+}
