+	@Test(expected = IllegalStateException.class)
+	public void verifyRefusesToBlockTheJavaFxThread() throws Throwable {
+		CompletableFuture<Throwable> failure = new CompletableFuture<>();
+		Platform.runLater(() -> {
+			try {
+				guard.verify(LivenessWorkflow.RESIDENT_REGISTRATION, null, null, "app1");
+				failure.complete(null);
+			} catch (Throwable t) {
+				failure.complete(t);
+			}
+		});
+		Throwable t = failure.get(10, TimeUnit.SECONDS);
+		assertNotNull("verify must throw on the FX thread", t);
