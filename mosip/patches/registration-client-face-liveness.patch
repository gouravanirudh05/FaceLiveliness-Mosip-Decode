+	private static void needsServices() {
+		assumeTrue("liveness engine not running on " + LIVENESS_PORT, listening(LIVENESS_PORT));
+		assumeTrue("MockMDS not running on " + MDS_PORT, listening(MDS_PORT));
+	}
