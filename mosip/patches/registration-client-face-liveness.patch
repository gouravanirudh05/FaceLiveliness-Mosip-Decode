+		for (int i = 0; i < 2; i++) {
+			FaceLivenessGuard.Verdict verdict = guard.verify(LivenessWorkflow.OPERATOR_AUTHENTICATION, null, null, "op9");
+			assertTrue(verdict.isDeviceError());
+			assertFalse(verdict.isBlocked());
+		}
+		device.close();
+	}
