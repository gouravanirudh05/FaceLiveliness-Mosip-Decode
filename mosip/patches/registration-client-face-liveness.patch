+		assertEquals(Arrays.asList("blink", "smile", "turn_left"), resident.getChallengeTypes());
+		assertFalse(resident.getCompoundChallenges());
+		assertEquals(Arrays.asList(10f, 7f), resident.getStepTimeoutsSeconds());
+		assertNull(resident.getMaxRetries());
+
+		LivenessPolicy supervisor = guard.policy(LivenessWorkflow.SUPERVISOR_AUTHENTICATION);
+		assertEquals(0.95f, supervisor.getAcceptThreshold(), 1e-6);
+		assertEquals(Integer.valueOf(1), supervisor.getMaxRetries());
