+		io.mosip.registration.mdm.dto.MdmBioDevice face = new io.mosip.registration.mdm.dto.MdmBioDevice();
+		face.setDeviceMake("MOSIP");
+		face.setDeviceModel("Face");
+		face.setSpecVersion("0.9.5");
+		face.setPurpose("Registration");
