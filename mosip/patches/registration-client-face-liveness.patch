+	/** Opens the MockMDS face stream exactly like the client's SBI providers: HTTP method STREAM. */
+	private static InputStream openMockMdsFaceStream() throws Exception {
+		CloseableHttpClient http = HttpClients.createDefault();
+		CloseableHttpResponse response = http.execute(RequestBuilder.create("STREAM")
+				.setUri("http://127.0.0.1:" + MDS_PORT + "/stream")
+				.setEntity(new StringEntity("{\"deviceId\":\"3\",\"deviceSubId\":\"0\",\"timeout\":\"120000\"}",
+						ContentType.APPLICATION_JSON))
+				.build());
+		return response.getEntity().getContent();
+	}
+
+	private void streamFromMockMds() throws Exception {
+		streamer.startStream(openMockMdsFaceStream(), new ImageView(), null);
+	}
