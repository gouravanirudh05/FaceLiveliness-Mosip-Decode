+		Map<String, String> r = guard.diagnosticsReport(face);
+		assertTrue(r.get("Liveness engine"), r.get("Liveness engine").endsWith(" available"));
+		assertTrue(r.get("Frame stream").startsWith("SBI STREAM"));
+		assertTrue(r.get("Supported challenges").contains("blink"));
+		assertEquals("deepfake, presentation_attack, synthetic", r.get("Detected attack classes"));
+		assertEquals("SHA-256 verified at start-up", r.get("Model integrity check"));
+		assertTrue(r.get("Policy supervisor").startsWith("threshold 0.9,"));
