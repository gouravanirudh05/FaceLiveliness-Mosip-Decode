+
+	/** One MJPEG part as MDS streams it. */
+	private static byte[] mjpegPart(byte[] body) {
+		byte[] head = ("--mosipframe\r\nContent-Type: image/jpeg\r\nContent-Length: " + body.length + "\r\n\r\n")
+				.getBytes(java.nio.charset.StandardCharsets.US_ASCII);
+		byte[] out = Arrays.copyOf(head, head.length + body.length);
+		System.arraycopy(body, 0, out, head.length, body.length);
+		return out;
+	}
+
+	private void assertDeviceError(FaceLivenessGuard.Verdict verdict, String message) {
+		assertFalse(verdict.isAllowed());
+		assertTrue(verdict.isDeviceError());
+		assertNull(verdict.getOutcome());
+		assertEquals(message, verdict.getUserMessage());
+		assertEquals(Arrays.asList(AuditEvent.REG_FACE_LIVENESS_DEVICE_ERROR), audit.events);
+		assertEquals(1L, guard.getMetrics().get("RESIDENT_REGISTRATION").get("device_errors"));
+	}
