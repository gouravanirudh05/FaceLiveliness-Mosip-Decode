+/**
+ * Face liveness and PAD gate for resident face capture, operator login/authentication and supervisor
+ * authentication.
+ *
+ * <p>Before the face is captured from the device, {@link #verify} runs a hybrid liveness session on the frames the
+ * {@link Streamer} receives from the L0/L1 device stream: passive liveness and PAD first, active challenges when
+ * the passive confidence does not meet the threshold. The capture may only proceed when the verdict allows it.
+ * The engine runs on this machine (127.0.0.1), so liveness is enforced offline as well as online.
+ *
+ * <p>Configuration: Registration Client global parameters (synced from the server when online, used offline),
+ * with {@code -D} system properties as a machine-local fallback. A per-workflow key
+ * ({@code ...liveness.resident.<key>}, {@code operator}, {@code supervisor}) wins over the shared key
+ * ({@code ...liveness.<key>}); unset policy keys keep the engine's defaults.
+ *
+ * <pre>
+ * mosip.registration.face.liveness.enable                         Y | N  (default Y)
+ * mosip.registration.face.liveness.[wf.]enable                    Y | N  (default Y)
+ * mosip.registration.face.liveness.[wf.]passive.threshold         0..1   accept: passive score >= this proceeds
+ * mosip.registration.face.liveness.[wf.]passive.reject.threshold  0..1   PAD: score < this is an attack
+ * mosip.registration.face.liveness.[wf.]passive.no.response.action ACTIVE | FAIL (no usable face in passive)
+ * mosip.registration.face.liveness.[wf.]active.enable             Y | N
+ * mosip.registration.face.liveness.[wf.]active.min.challenges     integer >= 1
+ * mosip.registration.face.liveness.[wf.]active.challenge.types    comma list: blink,smile,open_mouth,turn_left,...
+ * mosip.registration.face.liveness.[wf.]active.compound.challenges Y | N
+ * mosip.registration.face.liveness.[wf.]active.challenge.timeout.seconds comma list per step, last repeats
+ * mosip.registration.face.liveness.[wf.]active.max.retries        integer >= 0 (retries within one session)
+ * mosip.registration.face.liveness.[wf.]repeated.failure.max.sessions integer >= 1 (default 3)
+ * mosip.registration.face.liveness.[wf.]repeated.failure.action   BLOCK | CONTINUE (default BLOCK)
+ * mosip.registration.face.liveness.engine.error.policy            DENY | ALLOW (default DENY)
+ * mosip.registration.face.liveness.service.host / .port           default 127.0.0.1 / 50052
+ * mosip.registration.face.liveness.service.autostart              Y | N  (default Y)
+ * mosip.registration.face.liveness.service.command                engine start command (e.g. bundled python -m ...)
+ * mosip.registration.face.liveness.service.workdir / .log         working directory / log file of the engine
+ * mosip.registration.face.liveness.service.startup.timeout.seconds default 120
+ * mosip.registration.face.liveness.session.timeout.seconds        default 180
+ * mosip.registration.face.liveness.max.fps                        default 15
+ * mosip.registration.face.liveness.retry.delay.ms                 default 3000 (retry guidance shown before retrying)
+ * mosip.registration.face.liveness.device.frame.timeout.seconds   default 10: no (valid) frame from the device for
+ *                                                                 this long ends the session as a device error
+ * </pre>
+ */
+@Component
+public class FaceLivenessGuard implements DisposableBean {
+
+	private static final Logger LOGGER = AppConfig.getLogger(FaceLivenessGuard.class);
+
+	static final String PREFIX = "mosip.registration.face.liveness.";
+	static final String ENABLE = PREFIX + "enable";
+	static final String HOST = PREFIX + "service.host";
+	static final String PORT = PREFIX + "service.port";
+	static final String AUTOSTART = PREFIX + "service.autostart";
+	static final String COMMAND = PREFIX + "service.command";
+	static final String WORKDIR = PREFIX + "service.workdir";
+	static final String ENGINE_LOG = PREFIX + "service.log";
+	static final String STARTUP_TIMEOUT = PREFIX + "service.startup.timeout.seconds";
+	static final String SESSION_TIMEOUT = PREFIX + "session.timeout.seconds";
+	static final String MAX_FPS = PREFIX + "max.fps";
+	static final String RETRY_DELAY = PREFIX + "retry.delay.ms";
+	static final String ENGINE_ERROR_POLICY = PREFIX + "engine.error.policy";
+	static final String DEVICE_FRAME_TIMEOUT = PREFIX + "device.frame.timeout.seconds";
+
+	public static final String LIVENESS_ERROR_CODE = "REG-LIVENESS-001";
+	static final String CHECKING_TEXT = "Checking face liveness…";
+	static final String RECOVERY_MESSAGE = "Face verification could not be completed. "
+			+ "Please follow the applicable recovery process.";
+	static final String DEVICE_UNAVAILABLE_MESSAGE = "The face camera is not sending images. "
+			+ "Check that the device is connected and try again.";
+	static final String DEVICE_DISCONNECTED_MESSAGE = "The face camera was disconnected. "
+			+ "Reconnect the device and try again.";
+	static final String DEVICE_INVALID_FRAMES_MESSAGE = "The face camera is sending unreadable images. "
+			+ "Check the device and try again.";
+	/** Consecutive frames that are not JPEG before the stream counts as invalid. */
+	static final int MAX_INVALID_FRAMES = 30;
+
+	/** Result of {@link #verify}: whether the capture may proceed, and the text to show if not. */
+	public static final class Verdict {
+		private final boolean allowed;
+		private final boolean skipped;
+		private final boolean blocked;
+		private final String userMessage;
+		private final LivenessOutcome outcome;
+		private final boolean deviceError;
+
+		Verdict(boolean allowed, boolean skipped, boolean blocked, String userMessage, LivenessOutcome outcome) {
+			this(allowed, skipped, blocked, userMessage, outcome, false);
+		}
+
+		Verdict(boolean allowed, boolean skipped, boolean blocked, String userMessage, LivenessOutcome outcome,
+				boolean deviceError) {
+			this.deviceError = deviceError;
+			this.allowed = allowed;
+			this.skipped = skipped;
+			this.blocked = blocked;
+			this.userMessage = userMessage;
+			this.outcome = outcome;
+		}
+
+		public boolean isAllowed() {
+			return allowed;
+		}
+
+		/** Liveness is disabled for this workflow by configuration. */
+		public boolean isSkipped() {
+			return skipped;
+		}
+
+		/** Refused without a session: too many failed sessions for this subject (repeated-failure policy). */
+		public boolean isBlocked() {
+			return blocked;
+		}
+
+		public String getUserMessage() {
+			return userMessage;
+		}
+
+		/** The face device was unavailable, disconnected or sent invalid frames (not counted as a failure). */
+		public boolean isDeviceError() {
+			return deviceError;
+		}
+
+		/** The session outcome; {@code null} when skipped, blocked or on a device error. */
+		public LivenessOutcome getOutcome() {
+			return outcome;
+		}
+	}
+
+	/** Thrown from capture tasks when liveness does not allow the capture; carries the user-facing text. */
+	public static class LivenessRejectedException extends RegBaseCheckedException {
+		private static final long serialVersionUID = 1L;
+		private final String userMessage;
+
+		public LivenessRejectedException(String userMessage) {
+			super(LIVENESS_ERROR_CODE, userMessage);
+			this.userMessage = userMessage;
+		}
+
+		public String getUserMessage() {
+			return userMessage;
+		}
+	}
+
+	@Autowired
+	private Streamer streamer;
+
+	@Autowired
+	private AuditManagerService auditFactory;
+
+	private final Object clientLock = new Object();
+	private FaceLivenessClient client;
+	private LivenessClientConfig clientConfig;
+	private volatile HybridLivenessSession activeSession;
+	private final LivenessEngineManager engine = new LivenessEngineManager();
+	private final LivenessMetrics metrics = new LivenessMetrics();
+	private final Map<String, AtomicInteger> failures = new ConcurrentHashMap<>();
+	private final ScheduledExecutorService watchdog = Executors.newSingleThreadScheduledExecutor(r -> {
+		Thread t = new Thread(r, "face-liveness-device-watchdog");
+		t.setDaemon(true);
+		return t;
+	});
+
+	public FaceLivenessGuard() {
+	}
+
+	/** For tests. */
+	FaceLivenessGuard(Streamer streamer, AuditManagerService auditFactory) {
+		this.streamer = streamer;
+		this.auditFactory = auditFactory;
+	}
+
+	public boolean isEnabled(LivenessWorkflow workflow) {
+		return flag(ENABLE, true) && flag(PREFIX + workflowKey(workflow) + ".enable", true);
+	}
+
+	/**
+	 * Runs one hybrid liveness session on the live device stream and blocks until it is decided. Must be called
+	 * from a background task, never from the JavaFX thread.
+	 *
+	 * @param workflow          resident registration, operator or supervisor authentication
+	 * @param overlay           the liveness pane over the face preview (may be null)
+	 * @param startStreamIfIdle starts the device stream when it is not running yet (may be null)
+	 * @param subjectId         who is verified (registration application ID for residents, user ID otherwise);
+	 *                          used for the repeated-failure policy and the audit trail
+	 */
+	public Verdict verify(LivenessWorkflow workflow, LivenessOverlayPane overlay, Runnable startStreamIfIdle,
+			String subjectId) {
+		Objects.requireNonNull(workflow, "workflow");
+		if (Platform.isFxApplicationThread()) {
+			throw new IllegalStateException("FaceLivenessGuard.verify must not run on the JavaFX thread");
+		}
+		if (!isEnabled(workflow)) {
+			LOGGER.info("Face liveness disabled for workflow {}", workflow);
+			return new Verdict(true, true, false, null, null);
+		}
+		String failureKey = workflowKey(workflow) + ":" + (subjectId == null ? "" : subjectId);
+		if (isBlocked(workflow, failureKey)) {
+			LOGGER.warn("Face liveness: {} blocked after {} failed sessions", workflow, maxFailedSessions(workflow));
+			audit(AuditEvent.REG_FACE_LIVENESS_BLOCKED, workflow, subjectId);
+			metrics.recordBlocked(workflow);
+			if (overlay != null) {
+				overlay.finish(RECOVERY_MESSAGE, false);
+			}
+			return new Verdict(false, false, true, RECOVERY_MESSAGE, null);
+		}
+		cancelActive();
+
+		LivenessPolicy policy;
+		try {
+			policy = policy(workflow);
+		} catch (IllegalArgumentException e) {
+			LOGGER.error("Face liveness configuration is invalid: {}", e.getMessage());
+			audit(AuditEvent.REG_FACE_LIVENESS_ENGINE_ERROR, workflow, subjectId);
+			return new Verdict(false, false, false, LivenessOutcome.GENERIC_FAILURE_MESSAGE, null);
+		}
+
+		FaceLivenessClient livenessClient = client();
+		if (flag(AUTOSTART, true)) {
+			engine.ensureRunning(livenessClient::isAvailable, string(COMMAND, null), string(WORKDIR, null),
+					string(ENGINE_LOG, null), integer(STARTUP_TIMEOUT, 120));
+		}
+		if (!streamer.isStreaming() && startStreamIfIdle != null) {
+			LOGGER.info("Face liveness: starting device stream");
+			startStreamIfIdle.run();
+		}
+
+		if (overlay != null) {
+			overlay.start(CHECKING_TEXT);
+		}
+		SessionStats stats = new SessionStats();
+		AtomicReference<String> deviceError = new AtomicReference<>();
+		AtomicLong lastFrameNanos = new AtomicLong(System.nanoTime());
+		AtomicInteger invalidFrames = new AtomicInteger();
+		HybridLivenessSession session = livenessClient.startHybrid(workflow, policy, update -> {
+			if (overlay != null) {
+				overlay.show(update);
+			}
+			stats.on(update);
+			logUpdate(workflow, update);
+		});
+		activeSession = session;
+		Streamer.FrameListener listener = new Streamer.FrameListener() {
+			@Override
+			public void onFrame(byte[] jpeg) {
+				if (!isJpeg(jpeg)) {
+					if (invalidFrames.incrementAndGet() >= MAX_INVALID_FRAMES
+							&& deviceError.compareAndSet(null, DEVICE_INVALID_FRAMES_MESSAGE)) {
+						LOGGER.warn("Face liveness: device sends invalid frames, cancelling session {}",
+								session.getSessionId());
+						session.cancel();
+					}
+					return;
+				}
+				invalidFrames.set(0);
+				lastFrameNanos.set(System.nanoTime());
+				session.offerFrame(jpeg);
+			}
+
+			@Override
+			public void onStreamStopped() {
+				LOGGER.info("Face liveness: device stream stopped, cancelling session {}", session.getSessionId());
+				deviceError.compareAndSet(null, DEVICE_DISCONNECTED_MESSAGE);
+				session.cancel();
+			}
+		};
+		streamer.setFrameListener(listener);
+		long frameTimeoutNanos = TimeUnit.SECONDS.toNanos(Math.max(1, integer(DEVICE_FRAME_TIMEOUT, 10)));
+		ScheduledFuture<?> deviceCheck = watchdog.scheduleWithFixedDelay(() -> {
+			if (!session.isDone() && System.nanoTime() - lastFrameNanos.get() > frameTimeoutNanos
+					&& deviceError.compareAndSet(null, DEVICE_UNAVAILABLE_MESSAGE)) {
+				LOGGER.warn("Face liveness: no frame from the device for {} s, cancelling session {}",
+						TimeUnit.NANOSECONDS.toSeconds(frameTimeoutNanos), session.getSessionId());
+				session.cancel();
+			}
+		}, 1, 1, TimeUnit.SECONDS);
+
+		LivenessOutcome outcome;
+		try {
+			outcome = session.awaitOutcome(livenessClient.getConfig().getSessionTimeout().plusSeconds(5));
+		} catch (InterruptedException e) {
+			Thread.currentThread().interrupt();
+			session.cancel();
+			outcome = session.outcome().getNow(null);
+		} finally {
+			deviceCheck.cancel(false);
+			streamer.removeFrameListener(listener);
+			activeSession = null;
+		}
+		metrics.record(workflow, outcome, stats.elapsedMs(), stats.retries.get(), stats.challengesPassed.get(),
+				stats.challengeMs.get(), stats.hadChallenges.get());
+		LOGGER.info("Face liveness metrics (anonymised): {}", metrics.snapshot());
+		if (outcome != null && !outcome.getSessionId().isEmpty()) {
+			LOGGER.info("Face liveness effective policy for session {}: {}", outcome.getSessionId(),
+					session.getEffectivePolicyJson());
+		}
+
+		Verdict verdict = deviceError.get() != null && (outcome == null
+				|| outcome.getStatus() == LivenessOutcome.Status.CANCELLED)
+						? deviceFailure(workflow, deviceError.get(), subjectId)
+						: decide(workflow, outcome, subjectId);
+		trackFailures(workflow, failureKey, verdict);
+		if (overlay != null) {
+			overlay.finish(verdict.isAllowed() ? (outcome != null ? outcome.getUserMessage() : "")
+					: verdict.getUserMessage(), verdict.isAllowed());
+		}
+		return verdict;
+	}
+
+	/** Cancels a running session, e.g. when the screen is left. */
+	public void cancelActive() {
+		HybridLivenessSession session = activeSession;
+		if (session != null && !session.isDone()) {
+			session.cancel();
+		}
+	}
+
+	/** Anonymised liveness metrics per workflow (diagnostics). */
+	public Map<String, Map<String, Object>> getMetrics() {
+		return metrics.snapshot();
+	}
+
+	/** Diagnostics: engine availability and the engine's models, versions and thresholds. */
+	public String getDiagnostics() {
+		FaceLivenessClient c = client();
+		StringBuilder sb = new StringBuilder();
+		sb.append("service ").append(c.getConfig().getHost()).append(':').append(c.getConfig().getPort());
+		boolean up = c.isAvailable();
+		sb.append(up ? " available" : " NOT available");
+		sb.append(engine.startedByClient() ? " (started by this client)" : "");
+		if (up) {
+			try {
+				sb.append("\nengine: ").append(c.getServiceInfoJson());
+			} catch (RuntimeException e) {
+				sb.append("\nengine info failed: ").append(e.getMessage());
+			}
+		}
+		sb.append("\nmetrics: ").append(metrics.snapshot());
+		return sb.toString();
+	}
+
+	/**
+	 * Diagnostic report for the Device Settings screen (diagnostic mode): face device as discovered over SBI,
+	 * liveness engine availability and discovered capabilities, the effective policy of every workflow and the
+	 * anonymised metrics. Contains no images, scores of individuals or personal data. Blocking; call it off the FX
+	 * thread.
+	 *
+	 * @param faceDevice the face device the client discovered (MOSIPDINFO), or null when none was found
+	 */
+	public Map<String, String> diagnosticsReport(MdmBioDevice faceDevice) {
+		Map<String, String> r = new LinkedHashMap<>();
+		r.put("Face liveness", flag(ENABLE, true) ? "enabled" : "disabled");
+		if (faceDevice == null) {
+			r.put("Face device", "not found (scan for devices; check that the SBI service is running)");
+		} else {
+			r.put("Face device", faceDevice.getDeviceMake() + " " + faceDevice.getDeviceModel() + " (SBI "
+					+ faceDevice.getSpecVersion() + ", purpose " + faceDevice.getPurpose() + ", status "
+					+ faceDevice.getDeviceStatus() + ", port " + faceDevice.getPort() + ")");
+			r.put("Frame stream", "Registration".equalsIgnoreCase(faceDevice.getPurpose())
+					? "SBI STREAM (MJPEG) - required for purpose Registration"
+					: "not available: purpose " + faceDevice.getPurpose() + " devices do not stream");
+		}
+		r.put("Frame stream state", streamer.isStreaming() ? "streaming" : "idle");
+
+		FaceLivenessClient c = client();
+		boolean up = c.isAvailable();
+		r.put("Liveness engine", c.getConfig().getHost() + ":" + c.getConfig().getPort() + (up ? " available" : " NOT available")
+				+ (engine.startedByClient() ? " (started by this client)" : "")
+				+ (!up && flag(AUTOSTART, true) ? " - started automatically at the next capture" : ""));
+		if (up) {
+			try {
+				JsonNode info = new ObjectMapper().readTree(c.getServiceInfoJson());
+				JsonNode caps = info.path("capabilities");
+				r.put("Engine modes", join(caps.path("modes")));
+				r.put("Supported challenges", join(caps.path("challenge_types")));
+				r.put("Detected attack classes", join(caps.path("attack_classes")));
+				r.put("Frame formats", join(caps.path("frame_encodings")));
+				r.put("Model integrity check", caps.path("model_integrity_verified").asBoolean() ? "SHA-256 verified at start-up"
+						: "OFF");
+				List<String> models = new ArrayList<>();
+				info.path("models").fields().forEachRemaining(m -> models.add(m.getKey() + " sha256:"
+						+ m.getValue().path("sha256").asText().substring(0, Math.min(12, m.getValue().path("sha256").asText().length()))));
+				r.put("Models", String.join(", ", models));
+			} catch (Exception e) {
+				r.put("Engine info", "failed: " + e.getMessage());
+			}
+		}
+		for (LivenessWorkflow wf : LivenessWorkflow.values()) {
+			String text;
+			if (!isEnabled(wf)) {
+				text = "disabled";
+			} else {
+				try {
+					LivenessPolicy p = policy(wf);
+					text = "threshold " + orDefault(p.getAcceptThreshold()) + ", reject " + orDefault(p.getRejectThreshold())
+							+ ", active " + orDefault(p.getActiveEnabled()) + ", min challenges " + orDefault(p.getMinChallenges())
+							+ ", challenges " + (p.getChallengeTypes().isEmpty() ? "engine default" : p.getChallengeTypes())
+							+ ", max retries " + orDefault(p.getMaxRetries()) + ", on repeated failure "
+							+ wfValueOr(workflowKey(wf), "repeated.failure.action", "BLOCK") + " after "
+							+ maxFailedSessions(wf);
+				} catch (IllegalArgumentException e) {
+					text = "INVALID configuration: " + e.getMessage();
+				}
+			}
+			r.put("Policy " + workflowKey(wf), text);
+		}
+		r.put("Metrics (anonymised)", String.valueOf(metrics.snapshot()));
+		return r;
+	}
+
+	private static String orDefault(Object o) {
+		return o == null ? "engine default" : String.valueOf(o);
+	}
+
+	private static String join(JsonNode array) {
+		List<String> out = new ArrayList<>();
+		array.forEach(n -> out.add(n.asText()));
+		return out.isEmpty() ? "-" : String.join(", ", out);
+	}
+
+	/** Cancels a running session, closes the connection and stops an engine this client started. */
+	@Override
+	public void destroy() {
+		cancelActive();
+		watchdog.shutdownNow();
+		synchronized (clientLock) {
+			if (client != null) {
+				client.close();
+				client = null;
+				clientConfig = null;
+			}
+		}
+		engine.stop();
+	}
+
+	// ------------------------------------------------------------------ policy and decisions
+
+	/** The per-session policy for a workflow from configuration; unset keys keep the engine defaults. */
+	LivenessPolicy policy(LivenessWorkflow workflow) {
+		String wf = workflowKey(workflow);
+		LivenessPolicy.Builder b = LivenessPolicy.builder()
+				.acceptThreshold(floatOrNull(wfValue(wf, "passive.threshold")))
+				.rejectThreshold(floatOrNull(wfValue(wf, "passive.reject.threshold")))
+				.activeEnabled(boolOrNull(wfValue(wf, "active.enable")))
+				.minChallenges(intOrNull(wfValue(wf, "active.min.challenges")))
+				.challengeTypes(list(wfValue(wf, "active.challenge.types")))
+				.compoundChallenges(boolOrNull(wfValue(wf, "active.compound.challenges")))
+				.maxRetries(intOrNull(wfValue(wf, "active.max.retries")));
+		String noResponse = wfValue(wf, "passive.no.response.action");
+		if (noResponse != null) {
+			if (!"FAIL".equalsIgnoreCase(noResponse) && !"ACTIVE".equalsIgnoreCase(noResponse)) {
+				throw new IllegalArgumentException("passive.no.response.action must be ACTIVE or FAIL");
+			}
+			b.failOnPassiveNoResponse("FAIL".equalsIgnoreCase(noResponse));
+		}
+		List<Float> timeouts = new ArrayList<>();
+		for (String t : list(wfValue(wf, "active.challenge.timeout.seconds"))) {
+			timeouts.add(Float.parseFloat(t));
+		}
+		return b.stepTimeoutsSeconds(timeouts).build();
+	}
+
+	Verdict decide(LivenessWorkflow workflow, LivenessOutcome outcome, String subjectId) {
+		if (outcome == null) {
+			audit(AuditEvent.REG_FACE_LIVENESS_FAILED, workflow, subjectId);
+			return new Verdict(false, false, false, LivenessOutcome.GENERIC_FAILURE_MESSAGE, null);
+		}
+		// Diagnostic log for audit: decision and scores only, never images or landmarks.
+		LOGGER.info("Face liveness result: workflow={} status={} reason={} passiveScore={} attack={} session={}",
+				workflow, outcome.getStatus(), outcome.getReason(), outcome.getPassiveScore().orElse(null),
+				outcome.isAttackDetected(), outcome.getSessionId());
+
+		switch (outcome.getStatus()) {
+		case PASSED:
+			audit(AuditEvent.REG_FACE_LIVENESS_PASSED, workflow, subjectId);
+			return new Verdict(true, false, false, outcome.getUserMessage(), outcome);
+		case ENGINE_ERROR:
+			audit(AuditEvent.REG_FACE_LIVENESS_ENGINE_ERROR, workflow, subjectId);
+			if ("ALLOW".equalsIgnoreCase(string(ENGINE_ERROR_POLICY, "DENY"))) {
+				LOGGER.warn("Face liveness engine error ({}); capture ALLOWED by {}", outcome.getReason(),
+						ENGINE_ERROR_POLICY);
+				return new Verdict(true, false, false, null, outcome);
+			}
+			return new Verdict(false, false, false, outcome.getUserMessage(), outcome);
+		default:
+			audit(outcome.isAttackDetected() ? AuditEvent.REG_FACE_LIVENESS_PAD_FAILED
+					: AuditEvent.REG_FACE_LIVENESS_FAILED, workflow, subjectId);
+			return new Verdict(false, false, false, outcome.getUserMessage(), outcome);
+		}
+	}
+
+	/** The device stopped, never streamed or streamed garbage: not a liveness failure of the subject. */
+	private Verdict deviceFailure(LivenessWorkflow workflow, String message, String subjectId) {
+		LOGGER.warn("Face liveness: device error for {}: {}", workflow, message);
+		audit(AuditEvent.REG_FACE_LIVENESS_DEVICE_ERROR, workflow, subjectId);
+		metrics.recordDeviceError(workflow);
+		return new Verdict(false, false, false, message, null, true);
+	}
+
+	static boolean isJpeg(byte[] b) {
+		return b != null && b.length > 4 && (b[0] & 0xFF) == 0xFF && (b[1] & 0xFF) == 0xD8;
+	}
+
+	private boolean isBlocked(LivenessWorkflow workflow, String key) {
+		if (!"BLOCK".equalsIgnoreCase(wfValueOr(workflowKey(workflow), "repeated.failure.action", "BLOCK"))) {
+			return false;
+		}
+		AtomicInteger n = failures.get(key);
+		return n != null && n.get() >= maxFailedSessions(workflow);
+	}
+
+	private int maxFailedSessions(LivenessWorkflow workflow) {
+		Integer n = intOrNull(wfValue(workflowKey(workflow), "repeated.failure.max.sessions"));
+		return n == null || n < 1 ? 3 : n;
+	}
+
+	/** Failed / timed-out sessions count; a pass resets; cancellations and engine errors do not count. */
+	private void trackFailures(LivenessWorkflow workflow, String key, Verdict verdict) {
+		LivenessOutcome o = verdict.getOutcome();
+		if (verdict.isAllowed()) {
+			failures.remove(key);
+		} else if (verdict.isDeviceError()) {
+			return;
+		} else if (o == null || o.getStatus() == LivenessOutcome.Status.FAILED
+				|| o.getStatus() == LivenessOutcome.Status.TIMED_OUT) {
+			int n = failures.computeIfAbsent(key, k -> new AtomicInteger()).incrementAndGet();
+			LOGGER.info("Face liveness: {} failed session(s) of {} allowed for {}", n, maxFailedSessions(workflow),
+					workflow);
+		}
+	}
+
+	private void audit(AuditEvent event, LivenessWorkflow workflow, String subjectId) {
+		String refId = subjectId == null || subjectId.isEmpty() ? RegistrationConstants.AUDIT_DEFAULT_USER : subjectId;
+		Components component = workflow == LivenessWorkflow.RESIDENT_REGISTRATION ? Components.REG_BIOMETRICS
+				: Components.REG_OS_AUTH;
+		String refType = workflow == LivenessWorkflow.RESIDENT_REGISTRATION
+				? AuditReferenceIdTypes.APPLICATION_ID.getReferenceTypeId()
+				: AuditReferenceIdTypes.USER_ID.getReferenceTypeId();
+		try {
+			auditFactory.audit(event, component, refId, refType);
+		} catch (RuntimeException exception) {
+			LOGGER.error("Face liveness audit failed", exception);
+		}
+	}
+
+	/** Diagnostic log of the prompts shown (text only; no frames or scores). */
+	private static void logUpdate(LivenessWorkflow workflow, LivenessUpdate update) {
+		switch (update.getKind()) {
+		case CHALLENGE:
+			LOGGER.info("Face liveness {}: challenge \"{}\" ({} ms)", workflow, update.getText(), update.getTimeoutMs());
+			break;
+		case CHALLENGE_RESULT:
+			LOGGER.info("Face liveness {}: challenge {}", workflow, update.isPassed() ? "passed" : update.getText());
+			break;
+		case RETRY:
+			LOGGER.info("Face liveness {}: retry offered ({} left): {} {}", workflow, update.getRetriesRemaining(),
+					update.getText(), update.getGuidance());
+			break;
+		default:
+			break;
+		}
+	}
+
+	/** Timing of one session, for the anonymised metrics. */
+	private static final class SessionStats {
+		final long startNanos = System.nanoTime();
+		final AtomicInteger retries = new AtomicInteger();
+		final AtomicInteger challengesPassed = new AtomicInteger();
+		final AtomicLong challengeMs = new AtomicLong();
+		final AtomicBoolean hadChallenges = new AtomicBoolean();
+		volatile long challengeStartNanos;
+
+		void on(LivenessUpdate u) {
+			switch (u.getKind()) {
+			case CHALLENGE:
+				hadChallenges.set(true);
+				challengeStartNanos = System.nanoTime();
+				break;
+			case CHALLENGE_RESULT:
+				if (u.isPassed() && challengeStartNanos != 0) {
+					challengesPassed.incrementAndGet();
+					challengeMs.addAndGet((System.nanoTime() - challengeStartNanos) / 1_000_000);
+				}
+				break;
+			case RETRY:
+				retries.incrementAndGet();
+				break;
+			default:
+				break;
+			}
+		}
+
+		long elapsedMs() {
+			return (System.nanoTime() - startNanos) / 1_000_000;
+		}
+	}
+
+	// ------------------------------------------------------------------ client and configuration
+
+	private FaceLivenessClient client() {
+		LivenessClientConfig wanted = LivenessClientConfig.builder()
+				.host(string(HOST, "127.0.0.1"))
+				.port(integer(PORT, 50052))
+				.sessionTimeout(Duration.ofSeconds(integer(SESSION_TIMEOUT, 180)))
+				.maxFramesPerSecond(integer(MAX_FPS, 15))
+				.autoRetryDelay(Duration.ofMillis(Math.max(0, integer(RETRY_DELAY, 3000))))
+				.build();
+		synchronized (clientLock) {
+			if (client == null || !sameConfig(clientConfig, wanted)) {
+				if (client != null) {
+					client.close();
+				}
+				LOGGER.info("Face liveness service at {}:{}", wanted.getHost(), wanted.getPort());
+				client = new FaceLivenessClient(wanted);
+				clientConfig = wanted;
+			}
+			return client;
+		}
+	}
+
+	private static boolean sameConfig(LivenessClientConfig a, LivenessClientConfig b) {
+		return a != null && a.getHost().equals(b.getHost()) && a.getPort() == b.getPort()
+				&& a.getSessionTimeout().equals(b.getSessionTimeout())
+				&& a.getMaxFramesPerSecond() == b.getMaxFramesPerSecond()
+				&& Objects.equals(a.getAutoRetryDelay(), b.getAutoRetryDelay());
+	}
+
+	static String workflowKey(LivenessWorkflow workflow) {
+		switch (workflow) {
+		case RESIDENT_REGISTRATION:
+			return "resident";
+		case OPERATOR_AUTHENTICATION:
+			return "operator";
+		case SUPERVISOR_AUTHENTICATION:
+			return "supervisor";
+		default:
+			throw new IllegalArgumentException("unknown workflow " + workflow);
+		}
+	}
+
+	/** Global parameter, else -D system property, else null. */
+	private static String value(String key) {
+		Object v = null;
+		try {
+			Map<String, Object> map = ApplicationContext.map();
+			v = map == null ? null : map.get(key);
+		} catch (RuntimeException notInitialised) {
+			// application context not loaded yet
+		}
+		if (v == null || String.valueOf(v).trim().isEmpty()) {
+			v = System.getProperty(key);
+		}
+		return v == null || String.valueOf(v).trim().isEmpty() ? null : String.valueOf(v).trim();
+	}
+
+	private static String wfValue(String wf, String key) {
+		String v = value(PREFIX + wf + "." + key);
+		return v != null ? v : value(PREFIX + key);
+	}
+
+	private static String wfValueOr(String wf, String key, String def) {
+		String v = wfValue(wf, key);
+		return v == null ? def : v;
+	}
+
+	static boolean flag(String key, boolean def) {
+		String s = value(key);
+		return s == null ? def : isYes(s);
+	}
+
+	private static boolean isYes(String s) {
+		return "Y".equalsIgnoreCase(s) || "true".equalsIgnoreCase(s) || "yes".equalsIgnoreCase(s);
+	}
+
+	static String string(String key, String def) {
+		String v = value(key);
+		return v == null ? def : v;
+	}
+
+	static int integer(String key, int def) {
+		try {
+			return Integer.parseInt(string(key, String.valueOf(def)));
+		} catch (NumberFormatException e) {
+			LOGGER.warn("Invalid value for {}, using {}", key, def);
+			return def;
+		}
+	}
+
+	private static Float floatOrNull(String s) {
+		return s == null ? null : Float.parseFloat(s);
+	}
+
+	private static Integer intOrNull(String s) {
+		return s == null ? null : Integer.parseInt(s);
+	}
+
+	private static Boolean boolOrNull(String s) {
+		return s == null ? null : isYes(s);
+	}
+
+	private static List<String> list(String s) {
+		if (s == null) {
+			return Collections.emptyList();
+		}
+		List<String> out = new ArrayList<>();
+		for (String part : Arrays.asList(s.split(","))) {
+			if (!part.trim().isEmpty()) {
+				out.add(part.trim().toLowerCase());
+			}
+		}
+		return out;
+	}
+}
