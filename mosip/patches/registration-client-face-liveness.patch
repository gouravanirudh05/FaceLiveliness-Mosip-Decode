+			assertEquals(Integer.valueOf(2), guard.policy(LivenessWorkflow.OPERATOR_AUTHENTICATION).getMaxRetries());
+			set("operator.active.max.retries", "0");    // global parameter wins
+			assertEquals(Integer.valueOf(0), guard.policy(LivenessWorkflow.OPERATOR_AUTHENTICATION).getMaxRetries());
+		} finally {
+			System.clearProperty(P + "operator.active.max.retries");
+		}
+	}
