new file mode 100644
index 0000000000000000000000000000000000000000..299de38c264ef5d6471bc56821631c3f3197aa3d
--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/Quality.java
@@ -0,0 +1,113 @@
+package io.mosip.registration.livenessmanager.core;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Capture-quality gate (port of face-liveness-passive {@code quality.assess}). Frames that fail are ISO/IEC 30107-3
+ * non-responses, not attack decisions. Measurements are taken on the crop resized to 224 x 224 grey (area
+ * averaging, as OpenCV INTER_AREA): sharpness = variance of the 3x3 Laplacian, brightness = mean, contrast = std.
+ */
+public final class Quality {
+
+    public enum Reason {
+        NO_FACE, MULTIPLE_FACES, FACE_TOO_SMALL, TOO_BLURRY, TOO_DARK, TOO_BRIGHT, POSE_OUT_OF_RANGE, FACE_CUT_OFF,
+        INSUFFICIENT_FRAMES
+    }
+
+    /** Limits (defaults = face-liveness-passive config/default.yaml quality section). */
+    public static final class Limits {
+        public boolean enforce = true;
+        public int minFacePx = 96;
+        public double minSharpness = 15.0;
+        public double minBrightness = 40.0;
+        public double maxBrightness = 220.0;
+        public double maxAbsYawDeg = 35.0;
+        public double maxAbsPitchDeg = 30.0;
+        public double maxCropClip = 0.20;
+    }
+
+    public final double sharpness, brightness, contrast;
+    public final List<Reason> reasons;
+
+    private Quality(double sharpness, double brightness, double contrast, List<Reason> reasons) {
+        this.sharpness = sharpness;
+        this.brightness = brightness;
+        this.contrast = contrast;
+        this.reasons = Collections.unmodifiableList(reasons);
+    }
+
+    public boolean passed() { return reasons.isEmpty(); }
+
+    public static Quality assess(double faceSizePx, double yawDeg, double pitchDeg, byte[] cropRgb, int w, int h,
+                                 double clip, Limits l) {
+        double[] m = measure(cropRgb, w, h);
+        List<Reason> reasons = new ArrayList<>();
+        if (faceSizePx < l.minFacePx) reasons.add(Reason.FACE_TOO_SMALL);
+        if (m[0] < l.minSharpness) reasons.add(Reason.TOO_BLURRY);
+        if (m[1] < l.minBrightness) reasons.add(Reason.TOO_DARK);
+        if (m[1] > l.maxBrightness) reasons.add(Reason.TOO_BRIGHT);
+        if (Math.abs(yawDeg) > l.maxAbsYawDeg || Math.abs(pitchDeg) > l.maxAbsPitchDeg) reasons.add(Reason.POSE_OUT_OF_RANGE);
+        if (clip > l.maxCropClip) reasons.add(Reason.FACE_CUT_OFF);
+        return new Quality(m[0], m[1], m[2], reasons);
+    }
+
+    /** {sharpness, brightness, contrast} of an RGB crop. */
+    static double[] measure(byte[] rgb, int w, int h) {
+        final int side = 224;
+        double[] grey = areaResizeGrey(rgb, w, h, side, side);
+        double sum = 0, sq = 0;
+        for (double v : grey) {
+            sum += v;
+            sq += v * v;
+        }
+        int n = side * side;
+        double mean = sum / n;
+        double std = Math.sqrt(Math.max(0, sq / n - mean * mean));
+        // 3x3 Laplacian [0 1 0; 1 -4 1; 0 1 0] with reflect-101 borders (OpenCV default), variance over all pixels
+        double ls = 0, lsq = 0;
+        for (int y = 0; y < side; y++) {
+            int yu = y == 0 ? 1 : y - 1, yd = y == side - 1 ? side - 2 : y + 1;
+            for (int x = 0; x < side; x++) {
+                int xl = x == 0 ? 1 : x - 1, xr = x == side - 1 ? side - 2 : x + 1;
+                double c = grey[y * side + x];
+                double lap = grey[yu * side + x] + grey[yd * side + x] + grey[y * side + xl] + grey[y * side + xr] - 4 * c;
+                ls += lap;
+                lsq += lap * lap;
+            }
+        }
+        double lmean = ls / n;
+        return new double[]{lsq / n - lmean * lmean, mean, std};
+    }
+
+    /** Area-average resize to grey (BT.601 luma, as cv2 RGB2GRAY), rounded to 8-bit like OpenCV's uint8 output. */
+    static double[] areaResizeGrey(byte[] rgb, int w, int h, int outW, int outH) {
+        double[] out = new double[outW * outH];
+        double sx = (double) w / outW, sy = (double) h / outH;
+        for (int oy = 0; oy < outH; oy++) {
+            double y0 = oy * sy, y1 = y0 + sy;
+            for (int ox = 0; ox < outW; ox++) {
+                double x0 = ox * sx, x1 = x0 + sx;
+                double r = 0, g = 0, b = 0, area = 0;
+                for (int y = (int) Math.floor(y0); y < Math.min(h, (int) Math.ceil(y1)); y++) {
+                    double wy = Math.min(y + 1, y1) - Math.max(y, y0);
+                    if (wy <= 0) continue;
+                    for (int x = (int) Math.floor(x0); x < Math.min(w, (int) Math.ceil(x1)); x++) {
+                        double wx = Math.min(x + 1, x1) - Math.max(x, x0);
+                        if (wx <= 0) continue;
+                        double a = wx * wy;
+                        int p = (y * w + x) * 3;
+                        r += (rgb[p] & 0xff) * a;
+                        g += (rgb[p + 1] & 0xff) * a;
+                        b += (rgb[p + 2] & 0xff) * a;
+                        area += a;
+                    }
+                }
+                double rr = Math.round(r / area), gg = Math.round(g / area), bb = Math.round(b / area);
+                out[oy * outW + ox] = Math.round(0.299 * rr + 0.587 * gg + 0.114 * bb);
+            }
+        }
+        return out;
+    }
+}
