index 0000000000000000000000000000000000000000..a37fffd951f40b9729f20b8c52aced75f747b6c7
--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/android/ModelStore.java
@@ -0,0 +1,138 @@
+package io.mosip.registration.livenessmanager.android;
+
+import android.content.Context;
+import android.util.Log;
+
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.Iterator;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Liveness model package management (spec bonus: model version management, secure offline model updates).
+ *
+ * <p>The approved models and their SHA-256 are pinned in the app ({@code assets/liveness_models.json}). A model
+ * package is provisioned offline by copying the files into the app's import folder
+ * ({@code Android/data/<package>/files/liveness-models/}, e.g. {@code adb push} or device management). Each file is
+ * verified against the pinned hash and only then moved into private storage, which other apps and USB access cannot
+ * modify. Files that fail verification are rejected and left in the import folder.
+ */
+public final class ModelStore {
+
+    private static final String TAG = "LivenessModelStore";
+    public static final String PINNED_ASSET = "liveness_models.json";
+    public static final String DIR = "liveness-models";
+
+    private final Context context;
+    private final String version;
+    private final Map<String, String> pinned = new LinkedHashMap<>();
+
+    public ModelStore(Context context) throws IOException {
+        this.context = context.getApplicationContext();
+        try (InputStream in = this.context.getAssets().open(PINNED_ASSET)) {
+            JSONObject json = new JSONObject(new String(readAll(in), StandardCharsets.UTF_8));
+            version = json.getString("version");
+            JSONObject files = json.getJSONObject("files");
+            for (Iterator<String> it = files.keys(); it.hasNext(); ) {
+                String name = it.next();
+                pinned.put(name, files.getString(name).toLowerCase());
+            }
+        } catch (org.json.JSONException e) {
+            throw new IOException("invalid " + PINNED_ASSET, e);
+        }
+    }
+
+    public String version() { return version; }
+
+    public File privateDir() { return new File(context.getFilesDir(), DIR); }
+
+    public File importDir() { return context.getExternalFilesDir(DIR); }
+
+    public File file(String name) { return new File(privateDir(), name); }
+
+    /** Imports verified files from the import folder; returns true when every pinned file is installed. */
+    public synchronized boolean ensureInstalled() {
+        File priv = privateDir();
+        if (!priv.isDirectory() && !priv.mkdirs()) return false;
+        File imp = importDir();
+        for (Map.Entry<String, String> e : pinned.entrySet()) {
+            File target = new File(priv, e.getKey());
+            if (target.isFile()) continue;
+            File candidate = imp == null ? null : new File(imp, e.getKey());
+            if (candidate == null || !candidate.isFile()) {
+                Log.w(TAG, "liveness model " + e.getKey() + " not provisioned (expected in " + imp + ")");
+                continue;
+            }
+            try {
+                String got = sha256(candidate);
+                if (!got.equals(e.getValue())) {
+                    Log.e(TAG, "liveness model " + e.getKey() + " rejected: sha256 " + got + " is not the approved "
+                            + e.getValue());
+                    continue;
+                }
+                File tmp = new File(priv, e.getKey() + ".part");
+                copy(candidate, tmp);
+                if (!sha256(tmp).equals(e.getValue()) || !tmp.renameTo(target)) {
+                    tmp.delete();
+                    continue;
+                }
+                candidate.delete();
+                Log.i(TAG, "liveness model " + e.getKey() + " installed (" + version + ")");
+            } catch (IOException ex) {
+                Log.e(TAG, "liveness model import failed for " + e.getKey(), ex);
+            }
+        }
+        for (String name : pinned.keySet()) if (!new File(priv, name).isFile()) return false;
+        return true;
+    }
+
+    /** Full re-verification of the installed package (diagnostics). */
+    public boolean verifyInstalled() {
+        try {
+            for (Map.Entry<String, String> e : pinned.entrySet()) {
+                File f = file(e.getKey());
+                if (!f.isFile() || !sha256(f).equals(e.getValue())) return false;
+            }
+            return true;
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    static String sha256(File f) throws IOException {
+        try (InputStream in = new FileInputStream(f)) {
+            MessageDigest md = MessageDigest.getInstance("SHA-256");
+            byte[] buf = new byte[1 << 20];
+            int n;
+            while ((n = in.read(buf)) > 0) md.update(buf, 0, n);
+            StringBuilder sb = new StringBuilder();
+            for (byte b : md.digest()) sb.append(String.format("%02x", b));
+            return sb.toString();
+        } catch (java.security.NoSuchAlgorithmException e) {
+            throw new IOException(e);
+        }
+    }
+
+    private static void copy(File from, File to) throws IOException {
+        try (InputStream in = new FileInputStream(from); java.io.OutputStream out = new java.io.FileOutputStream(to)) {
+            byte[] buf = new byte[1 << 20];
+            int n;
+            while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        }
+    }
+
+    private static byte[] readAll(InputStream in) throws IOException {
+        java.io.ByteArrayOutputStream out = new java.io.ByteArrayOutputStream();
+        byte[] buf = new byte[8192];
+        int n;
+        while ((n = in.read(buf)) > 0) out.write(buf, 0, n);
+        return out.toByteArray();
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/FaceCrop.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/FaceCrop.java
