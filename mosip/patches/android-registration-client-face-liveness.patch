@@ -0,0 +1,90 @@
+package io.mosip.registration.livenessmanager.android;
+
+import android.app.Activity;
+import android.content.Intent;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+
+import io.mosip.registration.livenessmanager.core.HybridSession;
+
+/**
+ * Intent contract of {@link LivenessActivity}: the workflow and the per-workflow policy from the Registration
+ * Client's global parameters in, the decision out.
+ */
+public final class LivenessContract {
+
+    public static final int REQUEST_CODE = 41;
+
+    public static final String EXTRA_WORKFLOW = "liveness.workflow";               // resident | operator | supervisor
+    public static final String EXTRA_ACCEPT = "liveness.passive.threshold";
+    public static final String EXTRA_REJECT = "liveness.passive.reject.threshold";
+    public static final String EXTRA_FAIL_NO_RESPONSE = "liveness.passive.fail.no.response";
+    public static final String EXTRA_FRAMES_REQUIRED = "liveness.passive.frames.required";
+    public static final String EXTRA_MAX_DURATION_MS = "liveness.passive.max.duration.ms";
+    public static final String EXTRA_ACTIVE_ENABLED = "liveness.active.enable";
+    public static final String EXTRA_MIN_CHALLENGES = "liveness.active.min.challenges";
+    public static final String EXTRA_CHALLENGE_TYPES = "liveness.active.challenge.types";   // comma list
+    public static final String EXTRA_COMPOUND = "liveness.active.compound.challenges";
+    public static final String EXTRA_MAX_RETRIES = "liveness.active.max.retries";
+    public static final String EXTRA_TIMEOUTS = "liveness.active.challenge.timeout.seconds"; // comma list
+    public static final String EXTRA_RETRY_DELAY_MS = "liveness.retry.delay.ms";
+    public static final String EXTRA_SESSION_TIMEOUT_S = "liveness.session.timeout.seconds";
+
+    public static final String RESULT_STATUS = "liveness.result.status";      // PASSED | FAILED | CANCELLED | ENGINE_ERROR
+    public static final String RESULT_REASON = "liveness.result.reason";      // audit only
+    public static final String RESULT_MESSAGE = "liveness.result.message";    // user text
+    public static final String RESULT_PASSIVE_SCORE = "liveness.result.passive.score";
+    public static final String RESULT_ATTACK = "liveness.result.attack";      // audit only
+    public static final String RESULT_DURATION_MS = "liveness.result.duration.ms";
+    public static final String RESULT_RETRIES = "liveness.result.retries";
+    public static final String RESULT_CHALLENGES = "liveness.result.challenges";
+
+    private LivenessContract() {
+    }
+
+    /** Settings for one session from the intent; absent extras keep the engine defaults. */
+    static HybridSession.Settings settings(Intent in) {
+        HybridSession.Settings s = new HybridSession.Settings();
+        if (in.hasExtra(EXTRA_ACCEPT)) s.passive.acceptThreshold = in.getDoubleExtra(EXTRA_ACCEPT, s.passive.acceptThreshold);
+        if (in.hasExtra(EXTRA_REJECT)) s.passive.rejectThreshold = in.getDoubleExtra(EXTRA_REJECT, s.passive.rejectThreshold);
+        if (s.passive.rejectThreshold > s.passive.acceptThreshold || s.passive.acceptThreshold > 1
+                || s.passive.rejectThreshold < 0) {
+            throw new IllegalArgumentException("thresholds must satisfy 0 <= reject <= accept <= 1");
+        }
+        if (in.hasExtra(EXTRA_FRAMES_REQUIRED)) s.passive.framesRequired = in.getIntExtra(EXTRA_FRAMES_REQUIRED, s.passive.framesRequired);
+        if (in.hasExtra(EXTRA_MAX_DURATION_MS)) s.passive.maxDurationMs = in.getLongExtra(EXTRA_MAX_DURATION_MS, s.passive.maxDurationMs);
+        if (s.passive.framesRequired < 1 || s.passive.maxDurationMs <= 0) {
+            throw new IllegalArgumentException("passive frames required must be >= 1 and max duration > 0");
+        }
+        if (in.hasExtra(EXTRA_FAIL_NO_RESPONSE)) s.failOnPassiveNoResponse = in.getBooleanExtra(EXTRA_FAIL_NO_RESPONSE, false);
+        s.active.withOverrides(
+                in.hasExtra(EXTRA_ACTIVE_ENABLED) ? in.getBooleanExtra(EXTRA_ACTIVE_ENABLED, true) : null,
+                in.hasExtra(EXTRA_MIN_CHALLENGES) ? in.getIntExtra(EXTRA_MIN_CHALLENGES, 3) : null,
+                csv(in.getStringExtra(EXTRA_CHALLENGE_TYPES)),
+                in.hasExtra(EXTRA_COMPOUND) ? in.getBooleanExtra(EXTRA_COMPOUND, true) : null,
+                in.hasExtra(EXTRA_MAX_RETRIES) ? in.getIntExtra(EXTRA_MAX_RETRIES, 3) : null,
+                doubles(in.getStringExtra(EXTRA_TIMEOUTS)));
+        return s;
+    }
+
+    static List<String> csv(String s) {
+        List<String> out = new ArrayList<>();
+        if (s == null) return out;
+        for (String p : s.split(",")) if (!p.trim().isEmpty()) out.add(p.trim().toLowerCase());
+        return out;
+    }
+
+    static List<Double> doubles(String s) {
+        List<Double> out = new ArrayList<>();
+        for (String p : csv(s)) out.add(Double.parseDouble(p));
+        return out;
+    }
+
+    public static boolean passed(int resultCode, Intent data) {
+        return resultCode == Activity.RESULT_OK && data != null && "PASSED".equals(data.getStringExtra(RESULT_STATUS));
+    }
+
+    static final List<String> WORKFLOWS = Arrays.asList("resident", "operator", "supervisor");
+}
