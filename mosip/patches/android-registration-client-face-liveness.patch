+++ b/android/livenessmanager/src/test/java/io/mosip/registration/livenessmanager/ParityTest.java
@@ -0,0 +1,168 @@
+package io.mosip.registration.livenessmanager;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertTrue;
+import static org.junit.Assume.assumeTrue;
+
+import java.io.File;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.file.Files;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.List;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+
+import org.junit.AfterClass;
+import org.junit.BeforeClass;
+import org.junit.Test;
+
+import io.mosip.registration.livenessmanager.core.OnnxClassifier;
+import io.mosip.registration.livenessmanager.core.Passive;
+import io.mosip.registration.livenessmanager.core.Preprocess;
+import io.mosip.registration.livenessmanager.core.Quality;
+
+/**
+ * The Android pipeline against the Python engine it was ported from, using fixtures written by
+ * face-liveness-passive/scripts/export_onnx.py: Pillow-exact preprocessing, ONNX vs PyTorch probabilities, and the
+ * whole per-frame result (crop, quality gate, fusion, decision) on full frames.
+ */
+public class ParityTest {
+
+    static File dir;
+    static File fixtures;
+    static OnnxClassifier unified, fas;
+
+    @BeforeClass
+    public static void load() throws Exception {
+        dir = new File(System.getProperty("liveness.onnx.dir", "missing"));
+        assumeTrue("export_onnx.py fixtures not found in " + dir, new File(dir, "manifest.json").isFile());
+        fixtures = new File(dir, "fixtures");
+        unified = new OnnxClassifier(Passive.UNIFIED, new File(dir, "fsfm_unified.onnx").getPath(), 0);
+        fas = new OnnxClassifier(Passive.FAS, new File(dir, "fsfm_fas.onnx").getPath(), 0);
+    }
+
+    @AfterClass
+    public static void close() {
+        if (unified != null) unified.close();
+        if (fas != null) fas.close();
+    }
+
+    static List<String> list(String key) throws IOException {
+        String json = new String(Files.readAllBytes(new File(dir, "manifest.json").toPath()));
+        Matcher m = Pattern.compile("\"" + key + "\":\\s*\\[([^\\]]*)\\]").matcher(json);
+        assertTrue(key + " missing in manifest", m.find());
+        List<String> out = new ArrayList<>();
+        for (String s : m.group(1).split(",")) out.add(s.trim().replace("\"", ""));
+        return out;
+    }
+
+    /** Binary PPM (P6, maxval 255) written by export_onnx.py: width, height and raw RGB. */
+    static final class Rgb {
+        final int width, height;
+        final byte[] pixels;
+
+        Rgb(File f) throws IOException {
+            byte[] all = Files.readAllBytes(f.toPath());
+            int[] pos = {0};
+            assertEquals("P6", token(all, pos));
+            width = Integer.parseInt(token(all, pos));
+            height = Integer.parseInt(token(all, pos));
+            assertEquals("255", token(all, pos));
+            int start = pos[0] + 1;                       // single whitespace after maxval
+            pixels = Arrays.copyOfRange(all, start, start + width * height * 3);
+            assertEquals(width * height * 3, all.length - start);
+        }
+
+        private static String token(byte[] b, int[] pos) {
+            while (Character.isWhitespace(b[pos[0]])) pos[0]++;
+            int s = pos[0];
+            while (!Character.isWhitespace(b[pos[0]])) pos[0]++;
+            return new String(b, s, pos[0] - s);
+        }
+    }
+
+    static float[] floats(File f) throws IOException {
+        ByteBuffer b = ByteBuffer.wrap(Files.readAllBytes(f.toPath())).order(ByteOrder.LITTLE_ENDIAN);
+        float[] out = new float[b.remaining() / 4];
+        b.asFloatBuffer().get(out);
+        return out;
+    }
+
+    static String text(File f) throws IOException {
+        return new String(Files.readAllBytes(f.toPath()));
+    }
+
+    static double[] numbers(String json, String key) {
+        Matcher m = Pattern.compile("\"" + key + "\":\\s*\\[([^\\]]*)\\]").matcher(json);
+        assertTrue(key, m.find());
+        return Arrays.stream(m.group(1).split(",")).mapToDouble(s -> Double.parseDouble(s.trim())).toArray();
+    }
+
+    static Double number(String json, String key) {
+        Matcher m = Pattern.compile("\"" + key + "\":\\s*(null|[-0-9.eE]+)").matcher(json);
+        assertTrue(key, m.find());
+        return "null".equals(m.group(1)) ? null : Double.parseDouble(m.group(1));
+    }
+
+    @Test
+    public void preprocessingIsBitExactWithPillow() throws Exception {
+        for (String name : list("fixtures")) {
+            Rgb img = new Rgb(new File(fixtures, name + ".ppm"));
+            float[] got = Preprocess.toTensor(img.pixels, img.width, img.height);
+            float[] want = floats(new File(fixtures, name + ".input.f32"));
+            assertEquals(want.length, got.length);
+            float max = 0;
+            for (int i = 0; i < got.length; i++) max = Math.max(max, Math.abs(got[i] - want[i]));
+            assertEquals(name + " max |diff|", 0f, max, 0f);
+        }
+    }
+
+    @Test
+    public void onnxModelsReproducePyTorch() throws Exception {
+        for (String name : list("fixtures")) {
+            float[] input = floats(new File(fixtures, name + ".input.f32"));
+            for (OnnxClassifier c : new OnnxClassifier[]{unified, fas}) {
+                double[] want = numbers(text(new File(fixtures, name + "." + c.spec().name + ".json")), "probabilities");
+                float[] got = c.probabilities(input);
+                for (int i = 0; i < want.length; i++) {
+                    assertEquals(name + " " + c.spec().name + "[" + i + "]", want[i], got[i], 1e-4);
+                }
+            }
+        }
+    }
+
+    @Test
+    public void wholeFramePipelineMatchesThePythonEngine() throws Exception {
+        Passive.Config cfg = new Passive.Config();
+        for (String name : list("frame_fixtures")) {
+            String json = text(new File(fixtures, name + ".json"));
+            Rgb img = new Rgb(new File(fixtures, name + ".ppm"));
+            List<Passive.Face> faces = new ArrayList<>();
+            Matcher m = Pattern.compile("\"box\":\\s*\\[([^\\]]*)\\],\\s*\"yaw_deg\":\\s*([-0-9.eE]+),\\s*\"pitch_deg\":\\s*([-0-9.eE]+)")
+                    .matcher(json);
+            while (m.find()) {
+                int[] box = Arrays.stream(m.group(1).split(",")).mapToInt(s -> Integer.parseInt(s.trim())).toArray();
+                faces.add(new Passive.Face(box, Double.parseDouble(m.group(2)), Double.parseDouble(m.group(3))));
+            }
+            Passive.FrameResult r = Passive.analyse(img.pixels, img.width, img.height, faces, 0,
+                    Arrays.asList(unified, fas), cfg);
+            Matcher d = Pattern.compile("\"decision\":\\s*\"([a-z_]+)\"").matcher(json);
+            assertTrue(d.find());
+            assertEquals(name + " decision", d.group(1).toUpperCase(), r.decision.name());
+            Double want = number(json, "bonafide_probability");
+            assertEquals(name + " bona fide probability", want, r.bonafide, 2e-4);
+            List<String> reasons = new ArrayList<>();
+            for (Quality.Reason q : r.reasons) reasons.add(q.name().toLowerCase());
+            Matcher rq = Pattern.compile("\"reasons\":\\s*\\[([^\\]]*)\\]").matcher(json);
+            assertTrue(rq.find());
+            List<String> wantReasons = new ArrayList<>();
+            for (String s : rq.group(1).split(",")) if (!s.trim().isEmpty()) wantReasons.add(s.trim().replace("\"", ""));
+            assertEquals(name + " quality reasons", wantReasons, reasons);
+            System.out.println("[parity] " + name + ": java " + r.decision + " " + r.bonafide + " / python " + want);
+        }
+    }
+}
diff --git a/android/livenessmanager/src/test/java/io/mosip/registration/livenessmanager/SessionTest.java b/android/livenessmanager/src/test/java/io/mosip/registration/livenessmanager/SessionTest.java
new file mode 100644
index 0000000000000000000000000000000000000000..00eeb43eddd9f2743ce6dce8476c701693aac96c
--- /dev/null
+++ b/android/livenessmanager/src/test/java/io/mosip/registration/livenessmanager/SessionTest.java
@@ -0,0 +1,338 @@
+package io.mosip.registration.livenessmanager;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Random;
+
+import org.junit.Test;
+
+import io.mosip.registration.livenessmanager.active.ActivePolicy;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Action;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Tier;
+import io.mosip.registration.livenessmanager.active.ActiveSession;
+import io.mosip.registration.livenessmanager.active.FaceObservation;
+import io.mosip.registration.livenessmanager.active.LivenessEvent;
+import io.mosip.registration.livenessmanager.core.HybridSession;
+import io.mosip.registration.livenessmanager.core.Passive;
+import io.mosip.registration.livenessmanager.core.Quality;
+
+/**
+ * Active and hybrid sessions with synthetic observations (as the Python modules' SimulatedUser): a live user
+ * performing each prompt passes; a static face times out; opposite movements fail; escalation and retries follow
+ * the policy; passive verdicts route to accept / reject / challenges.
+ */
+public class SessionTest {
+
+    static final long FRAME_MS = 40;
+
+    /** Produces the observations of a person performing a prompted action (neutral, action, back to neutral). */
+    static List<FaceObservation> perform(List<Action> actions, ActivePolicy.StepParams step, long[] ts) {
+        List<FaceObservation> out = new ArrayList<>();
+        for (int i = 0; i < 4; i++) out.add(neutral(ts));
+        for (Action a : actions) {
+            for (int i = 0; i < 4; i++) out.add(neutral(ts));
+            for (int i = 0; i < 5; i++) out.add(acting(a, step, ts));
+            for (int i = 0; i < 4; i++) out.add(neutral(ts));
+        }
+        return out;
+    }
+
+    static FaceObservation neutral(long[] ts) {
+        return new FaceObservation(ts[0] += FRAME_MS, 1, new HashMap<>(), 0, 0, 0, 0);
+    }
+
+    static FaceObservation acting(Action a, ActivePolicy.StepParams step, long[] ts) {
+        Map<String, Float> b = new HashMap<>();
+        double yaw = 0, pitch = 0, gaze = 0;
+        switch (a) {
+            case BLINK: b.put("eyeBlinkLeft", 0.9f); b.put("eyeBlinkRight", 0.9f); break;
+            case SMILE: b.put("mouthSmileLeft", 0.8f); b.put("mouthSmileRight", 0.8f); break;
+            case OPEN_MOUTH: b.put("jawOpen", 0.7f); break;
+            case TURN_LEFT: yaw = step.yawDeg + 8; break;
+            case TURN_RIGHT: yaw = -(step.yawDeg + 8); break;
+            case LOOK_UP: pitch = step.pitchDeg + 6; break;
+            case LOOK_DOWN: case NOD: pitch = -(step.pitchDeg + 6); break;
+            case GAZE_LEFT: gaze = 0.4; break;
+            case GAZE_RIGHT: gaze = -0.4; break;
+            case GAZE_UP: b.put("eyeLookUpLeft", 0.7f); b.put("eyeLookUpRight", 0.7f); break;
+            case GAZE_DOWN: b.put("eyeLookDownLeft", 0.7f); b.put("eyeLookDownRight", 0.7f); break;
+            default: break;
+        }
+        return new FaceObservation(ts[0] += FRAME_MS, 1, b, yaw, pitch, 0, gaze);
+    }
+
+    /** Runs an active session; `live` = the user follows every prompt, else a static face. */
+    static List<LivenessEvent> runActive(ActiveSession s, ActivePolicy p, boolean live, int maxFrames) {
+        List<LivenessEvent> all = new ArrayList<>(s.start());
+        long[] ts = {0};
+        List<FaceObservation> queue = new ArrayList<>();
+        int frames = 0;
+        while (frames++ < maxFrames) {
+            if (s.status == ActiveSession.Status.RETRY_AVAILABLE) {
+                all.addAll(s.retry());
+            }
+            if (s.status != ActiveSession.Status.RUNNING) break;
+            LivenessEvent last = lastChallenge(all);
+            if (queue.isEmpty()) {
+                queue.addAll(live ? perform(last.actions, p.stepParams(stepIndex(all)), ts) : List.of(neutral(ts)));
+            }
+            List<LivenessEvent> ev = s.process(queue.remove(0));
+            all.addAll(ev);
+            for (LivenessEvent e : ev) if (e.kind == LivenessEvent.Kind.CHALLENGE) queue.clear();
+        }
+        return all;
+    }
+
+    static LivenessEvent lastChallenge(List<LivenessEvent> events) {
+        for (int i = events.size() - 1; i >= 0; i--) if (events.get(i).kind == LivenessEvent.Kind.CHALLENGE) return events.get(i);
+        throw new AssertionError("no challenge");
+    }
+
+    static int stepIndex(List<LivenessEvent> events) {
+        int n = 0;
+        for (int i = events.size() - 1; i >= 0; i--) {
+            if (events.get(i).kind == LivenessEvent.Kind.RETRY) break;
+            if (events.get(i).kind == LivenessEvent.Kind.CHALLENGE) n++;
+        }
+        return Math.max(0, n - 1);
+    }
+
+    static LivenessEvent decision(List<LivenessEvent> events) {
+        for (int i = events.size() - 1; i >= 0; i--) if (events.get(i).kind == LivenessEvent.Kind.DECISION) return events.get(i);
+        throw new AssertionError("no decision in " + events);
+    }
+
+    static long count(List<LivenessEvent> events, LivenessEvent.Kind k) {
+        return events.stream().filter(e -> e.kind == k).count();
+    }
+
+    // ------------------------------------------------------------------ active
+
+    @Test
+    public void liveUserPassesEscalatingChallenges() {
+        ActivePolicy p = new ActivePolicy();
+        ActiveSession s = new ActiveSession(p, true, 0.6, new Random(7));
+        List<LivenessEvent> ev = runActive(s, p, true, 5000);
+        assertEquals(LivenessEvent.Status.PASSED, decision(ev).status);
+        assertEquals("Good, face captured successfully", decision(ev).text);
+        assertEquals(Arrays.asList(Tier.EASY, Tier.MEDIUM, Tier.HARD), s.plannedTiers().subList(0, 3));
+        for (List<Action> c : s.history) assertTrue(c.size() == 1 || c.size() == 2);
+    }
+
+    @Test
+    public void everyActionCanBePerformed() {
+        for (Action a : Action.values()) {
+            ActivePolicy p = new ActivePolicy().withOverrides(null, 1, List.of(a.code()), false, 0, null);
+            ActiveSession s = new ActiveSession(p, false, 0.9, new Random(1));
+            List<LivenessEvent> ev = runActive(s, p, true, 2000);
+            assertEquals(a + " should pass", LivenessEvent.Status.PASSED, decision(ev).status);
+        }
+    }
+
+    @Test
+    public void staticFaceTimesOutRetriesHarderThenFails() {
+        ActivePolicy p = new ActivePolicy();
+        ActiveSession s = new ActiveSession(p, true, 0.6, new Random(3));
+        List<LivenessEvent> ev = runActive(s, p, false, 20000);
+        assertEquals(p.maxRetries, count(ev, LivenessEvent.Kind.RETRY));
+        LivenessEvent d = decision(ev);
+        assertEquals(LivenessEvent.Status.FAILED, d.status);
+        assertEquals(LivenessEvent.MAX_RETRIES_MESSAGE, d.text);
+        assertEquals("ACTIVE_FAILED", d.reason);
+    }
+
+    @Test
+    public void weakPassiveScoreAddsAHardChallenge() {
+        ActivePolicy p = new ActivePolicy();
+        ActiveSession s = new ActiveSession(p, true, 0.45, new Random(5));
+        runActive(s, p, true, 6000);
+        assertEquals(Arrays.asList(Tier.EASY, Tier.MEDIUM, Tier.HARD, Tier.HARD), s.plannedTiers().subList(0, 4));
+    }
+
+    @Test
+    public void oppositeHeadTurnIsAWrongAction() {
+        ActivePolicy p = new ActivePolicy().withOverrides(null, 1, List.of("turn_left"), false, 0, null);
+        ActiveSession s = new ActiveSession(p, true, 0.9, new Random(1));
+        List<LivenessEvent> ev = new ArrayList<>(s.start());
+        long[] ts = {0};
+        for (int i = 0; i < 4; i++) ev.addAll(s.process(neutral(ts)));
+        for (int i = 0; i < 4 && s.status == ActiveSession.Status.RUNNING; i++) {   // stop once decided
+            ev.addAll(s.process(acting(Action.TURN_RIGHT, p.stepParams(0), ts)));
+        }
+        assertTrue(ev.stream().anyMatch(e -> e.kind == LivenessEvent.Kind.CHALLENGE_RESULT && "WRONG_ACTION".equals(e.reason)));
+        assertEquals(LivenessEvent.Status.FAILED, decision(ev).status);
+    }
+
+    @Test
+    public void overridesApplyChallengePoolTimeoutsAndRetries() {
+        ActivePolicy p = new ActivePolicy().withOverrides(null, 4, List.of("blink", "smile", "nod"), false, 1,
+                List.of(10.0, 7.0));
+        // a live subject walks through the steps: per-step timeouts, the last one repeating
+        List<LivenessEvent> ev = runActive(new ActiveSession(p, true, 0.9, new Random(9)), p, true, 20000);
+        List<Long> timeouts = new ArrayList<>();
+        for (LivenessEvent e : ev) {
+            if (e.kind == LivenessEvent.Kind.CHALLENGE) {
+                timeouts.add(e.timeoutMs);
+                for (Action a : e.actions) assertTrue(List.of(Action.BLINK, Action.SMILE, Action.NOD).contains(a));
+            }
+        }
+        assertTrue(timeouts.size() >= 3);
+        LivenessEvent first = ev.stream().filter(e -> e.kind == LivenessEvent.Kind.CHALLENGE).findFirst().get();
+        assertEquals(1, first.step);
+        assertTrue(first.totalSteps >= 4);                       // min.challenges = 4
+        assertTrue(first.challengeLine(), first.challengeLine().startsWith("Step 1 of "));
+        assertEquals("Retry available \u2013 starting again shortly (last attempt).", LivenessEvent.retryLine(0));
+        assertEquals(Long.valueOf(10000), timeouts.get(0));
+        assertEquals(Long.valueOf(7000), timeouts.get(1));
+        assertEquals(Long.valueOf(7000), timeouts.get(2));
+        assertEquals(LivenessEvent.Status.PASSED, decision(ev).status);
+        // a static face times out: exactly the configured single retry, then failure
+        ev = runActive(new ActiveSession(p, true, 0.9, new Random(9)), p, false, 20000);
+        assertEquals(1, count(ev, LivenessEvent.Kind.RETRY));
+        assertEquals(LivenessEvent.Status.FAILED, decision(ev).status);
+    }
+
+    @Test(expected = IllegalArgumentException.class)
+    public void invalidOverridesAreRejected() {
+        new ActivePolicy().withOverrides(null, null, List.of("jump"), null, null, null);
+    }
+
+    // ------------------------------------------------------------------ hybrid
+
+    static Passive.FrameResult pad(double score, Passive.Config c) {
+        Passive.Decision d = Passive.decide(score, List.of(), true, c);
+        return new PadFrame(score, d).result;
+    }
+
+    /** Builds a FrameResult through the public decision path with a fixed fused score. */
+    static final class PadFrame {
+        final Passive.FrameResult result;
+
+        PadFrame(double score, Passive.Decision d) {
+            Passive.Classifier fixed = new Passive.Classifier() {
+                public Passive.ModelSpec spec() { return Passive.FAS; }
+                public float[] probabilities(float[] in) { return new float[]{(float) (1 - score), (float) score}; }
+            };
+            byte[] frame = new byte[300 * 300 * 3];
+            Arrays.fill(frame, (byte) 120);
+            for (int i = 0; i < frame.length; i += 7) frame[i] = (byte) 250;     // texture so the blur gate passes
+            Passive.Config cfg = new Passive.Config();
+            cfg.weights.clear();
+            cfg.weights.put("fas", 1.0);
+            Passive.FrameResult r = Passive.analyse(frame, 300, 300,
+                    List.of(new Passive.Face(new int[]{80, 80, 220, 220}, 0, 0)), 0, List.of(fixed), cfg);
+            assertEquals("synthetic frame should pass quality: " + r.reasons, List.of(), r.reasons);
+            assertEquals(d, r.decision);
+            result = r;
+        }
+    }
+
+    static List<LivenessEvent> runHybrid(HybridSession h, double score, boolean live, int maxFrames) {
+        List<LivenessEvent> all = new ArrayList<>(h.start());
+        long[] ts = {0};
+        List<FaceObservation> queue = new ArrayList<>();
+        ActivePolicy p = new ActivePolicy();
+        for (int f = 0; f < maxFrames && h.phase() != HybridSession.Phase.DONE; f++) {
+            if (h.retryAvailable()) all.addAll(h.retry());
+            long t = ts[0] + FRAME_MS;
+            Passive.FrameResult pad = h.needsPad(t) ? pad(score, new Passive.Config()) : null;
+            FaceObservation obs;
+            if (h.phase() == HybridSession.Phase.ACTIVE && live) {
+                if (queue.isEmpty()) queue.addAll(perform(lastChallenge(all).actions, p.stepParams(stepIndex(all)), ts));
+                obs = queue.remove(0);
+            } else {
+                obs = neutral(ts);
+            }
+            List<LivenessEvent> ev = h.process(obs.timestampMs, pad, obs);
+            all.addAll(ev);
+            for (LivenessEvent e : ev) if (e.kind == LivenessEvent.Kind.CHALLENGE) queue.clear();
+        }
+        return all;
+    }
+
+    @Test
+    public void hybridBonaFidePassesWithoutChallenges() {
+        HybridSession h = new HybridSession(new HybridSession.Settings(), List.of(), true, new Random(1));
+        List<LivenessEvent> ev = runHybrid(h, 0.95, true, 500);
+        assertEquals("PASSIVE_BONAFIDE", decision(ev).reason);
+        assertEquals(0, count(ev, LivenessEvent.Kind.CHALLENGE));
+        assertEquals(0.95, decision(ev).passiveScore, 1e-4);
+    }
+
+    @Test
+    public void hybridAttackFailsWithoutChallengesOrRevealingWhy() {
+        HybridSession h = new HybridSession(new HybridSession.Settings(), List.of(), true, new Random(1));
+        LivenessEvent d = decision(runHybrid(h, 0.1, true, 500));
+        assertEquals(LivenessEvent.Status.FAILED, d.status);
+        assertTrue(d.isAttack());
+        assertFalse(d.text.toLowerCase().contains("attack"));
+    }
+
+    @Test
+    public void hybridUncertainGoesToChallengesAndALiveUserPasses() {
+        HybridSession h = new HybridSession(new HybridSession.Settings(), List.of(), false, new Random(2));
+        List<LivenessEvent> ev = runHybrid(h, 0.6, true, 6000);
+        assertTrue(count(ev, LivenessEvent.Kind.CHALLENGE) >= 3);
+        assertEquals("ACTIVE_PASSED", decision(ev).reason);
+        assertEquals("Face verified successfully", decision(ev).text);
+    }
+
+    @Test
+    public void attackDuringChallengesEndsTheSession() {
+        HybridSession.Settings s = new HybridSession.Settings();
+        HybridSession h = new HybridSession(s, List.of(), true, new Random(2));
+        List<LivenessEvent> ev = new ArrayList<>(h.start());
+        long[] ts = {0};
+        for (int f = 0; f < 3000 && h.phase() != HybridSession.Phase.DONE; f++) {
+            long t = ts[0] + FRAME_MS;
+            double score = h.phase() == HybridSession.Phase.PASSIVE ? 0.6 : 0.1;   // swap in an attack later
+            Passive.FrameResult pad = h.needsPad(t) ? pad(score, new Passive.Config()) : null;
+            ev.addAll(h.process(t, pad, neutral(ts)));
+        }
+        assertEquals("ATTACK_DETECTED_DURING_ACTIVE", decision(ev).reason);
+    }
+
+    @Test
+    public void passiveNoResponseCanBeConfiguredToFail() {
+        HybridSession.Settings s = new HybridSession.Settings();
+        s.failOnPassiveNoResponse = true;
+        s.passive.maxDurationMs = 500;
+        HybridSession h = new HybridSession(s, List.of(), true, new Random(2));
+        List<LivenessEvent> ev = new ArrayList<>(h.start());
+        long[] ts = {0};
+        for (int f = 0; f < 100 && h.phase() != HybridSession.Phase.DONE; f++) {
+            long t = ts[0] += FRAME_MS;
+            Passive.FrameResult none = h.needsPad(t) ? Passive.analyse(new byte[30], 10, 1, List.of(), t, List.of(),
+                    new Passive.Config()) : null;
+            ev.addAll(h.process(t, none, FaceObservation.noFace(t, 0)));
+        }
+        assertEquals("PASSIVE_NO_RESPONSE", decision(ev).reason);
+        assertTrue(ev.stream().anyMatch(e -> e.guidance.contains("Keep your face within the capture area.")));
+    }
+
+    @Test
+    public void fusionSplitsAttackMassOnlyByTheTypingModel() {
+        double[] fused = Passive.fuse(List.of(Passive.UNIFIED, Passive.FAS),
+                List.of(new float[]{0.6f, 0.1f, 0.1f, 0.2f}, new float[]{0.6f, 0.4f}), new Passive.Config().weights);
+        assertEquals(0.5, fused[0], 1e-6);                       // mean of 0.6 and 0.4
+        assertEquals(0.5 * 0.5, fused[1], 1e-6);                 // presentation attack: 0.2 / 0.4 of the attack mass
+        assertEquals(0.5 * 0.25, fused[2], 1e-6);
+        assertEquals(0.5 * 0.25, fused[3], 1e-6);
+    }
+
+    @Test
+    public void qualityGateFlagsSmallDarkFaces() {
+        byte[] dark = new byte[200 * 200 * 3];
+        Quality q = Quality.assess(50, 0, 0, dark, 200, 200, 0.0, new Quality.Limits());
+        assertTrue(q.reasons.contains(Quality.Reason.FACE_TOO_SMALL));
+        assertTrue(q.reasons.contains(Quality.Reason.TOO_DARK));
+        assertTrue(q.reasons.contains(Quality.Reason.TOO_BLURRY));
+    }
+}
