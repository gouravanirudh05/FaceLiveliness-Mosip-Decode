@@ -0,0 +1,187 @@
+package io.mosip.registration.livenessmanager.core;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.Random;
+
+import io.mosip.registration.livenessmanager.active.ActivePolicy;
+import io.mosip.registration.livenessmanager.active.ActiveSession;
+import io.mosip.registration.livenessmanager.active.FaceObservation;
+import io.mosip.registration.livenessmanager.active.LivenessEvent;
+
+/**
+ * Hybrid liveness on one camera stream (port of face-liveness-passive {@code hybrid.py}):
+ * <pre>
+ *   passive frames -&gt; aggregated score
+ *     ATTACK       -&gt; FAILED (no challenges shown)
+ *     BONAFIDE     -&gt; PASSED
+ *     UNCERTAIN    -&gt; active challenges with the passive score (weak scores add a hard challenge)
+ *     NON_RESPONSE -&gt; active challenges without a score, or FAILED when configured
+ *   while challenges run, PAD keeps sampling frames; consecutive ATTACK frames end the session as FAILED.
+ * </pre>
+ * Each frame comes with its analysis (faces for PAD, observation for the challenges), produced by the caller with
+ * MediaPipe on Android or synthetically in tests.
+ */
+public final class HybridSession {
+
+    public enum Phase { PASSIVE, ACTIVE, DONE }
+
+    /** Session settings (defaults = the service's YAML), overridable from client configuration. */
+    public static final class Settings {
+        public Passive.Config passive = new Passive.Config();
+        public ActivePolicy active = new ActivePolicy();
+        public boolean failOnPassiveNoResponse = false;
+        public boolean monitorDuringActive = true;
+        public long monitorIntervalMs = 1000;
+        public int monitorAttackFrames = 2;
+    }
+
+    private final Settings s;
+    private final List<Passive.Classifier> models;
+    private final boolean resident;
+    private final Random rng;
+    private final Passive.Stream stream;
+    private Phase phase = Phase.PASSIVE;
+    private ActiveSession active;
+    private Double passiveScore;
+    private Long lastMonitorTs;
+    private int attackRun;
+    private LivenessEvent decision;
+
+    public HybridSession(Settings settings, List<Passive.Classifier> models, boolean resident, Random rng) {
+        this.s = settings;
+        this.models = models;
+        this.resident = resident;
+        this.rng = rng;
+        this.stream = new Passive.Stream(settings.passive);
+    }
+
+    public Phase phase() { return phase; }
+
+    public LivenessEvent decision() { return decision; }
+
+    public boolean retryAvailable() {
+        return phase == Phase.ACTIVE && active.status == ActiveSession.Status.RETRY_AVAILABLE;
+    }
+
+    public List<LivenessEvent> start() {
+        return List.of(LivenessEvent.checking(0, null));
+    }
+
+    /** True if the frame at {@code ts} needs PAD scoring (passive phase sampling, or the active-phase monitor). */
+    public boolean needsPad(long ts) {
+        if (phase == Phase.PASSIVE) return stream.due(ts);
+        return phase == Phase.ACTIVE && s.monitorDuringActive
+                && (lastMonitorTs == null || ts - lastMonitorTs >= s.monitorIntervalMs);
+    }
+
+    /**
+     * Advances the session with one frame. {@code pad} is the frame's PAD result when {@link #needsPad} was true
+     * (else null); {@code obs} is its face observation for the challenges.
+     */
+    public List<LivenessEvent> process(long ts, Passive.FrameResult pad, FaceObservation obs) {
+        List<LivenessEvent> events = new ArrayList<>();
+        if (phase == Phase.PASSIVE) {
+            if (pad != null) {
+                stream.add(pad);
+                events.add(LivenessEvent.checking((double) stream.framesUsed() / stream.framesRequired(),
+                        guidance(pad.reasons)));
+            }
+            if (stream.done()) events.addAll(passiveVerdict());
+            return events;
+        }
+        if (phase != Phase.ACTIVE) return events;
+        if (pad != null) {
+            lastMonitorTs = ts;
+            attackRun = pad.decision == Passive.Decision.ATTACK ? attackRun + 1 : 0;
+            if (attackRun >= s.monitorAttackFrames) {
+                events.add(finish(LivenessEvent.Status.FAILED, "ATTACK_DETECTED_DURING_ACTIVE", LivenessEvent.FAILED_MESSAGE));
+                return events;
+            }
+        }
+        if (active.status != ActiveSession.Status.RUNNING || obs == null) return events;   // waiting for retry()
+        for (LivenessEvent e : active.process(obs)) {
+            events.add(e);
+            if (e.kind == LivenessEvent.Kind.DECISION) events.add(fromActive(e));
+        }
+        return events;
+    }
+
+    public List<LivenessEvent> retry() {
+        if (!retryAvailable()) throw new IllegalStateException("no retry is available");
+        return active.retry();
+    }
+
+    public List<LivenessEvent> cancel() {
+        if (phase == Phase.DONE) return Collections.emptyList();
+        return List.of(finish(LivenessEvent.Status.CANCELLED, "CANCELLED", LivenessEvent.CANCELLED_MESSAGE));
+    }
+
+    private List<LivenessEvent> passiveVerdict() {
+        Passive.FrameResult r = stream.result();
+        passiveScore = r.bonafide;
+        List<LivenessEvent> events = new ArrayList<>();
+        switch (r.decision) {
+            case ATTACK:
+                events.add(finish(LivenessEvent.Status.FAILED, "ATTACK_DETECTED", LivenessEvent.FAILED_MESSAGE));
+                break;
+            case BONAFIDE:
+                events.add(finish(LivenessEvent.Status.PASSED, "PASSIVE_BONAFIDE",
+                        resident ? "Good, face captured successfully" : "Face verified successfully"));
+                break;
+            case NON_RESPONSE:
+                if (s.failOnPassiveNoResponse) {
+                    events.add(finish(LivenessEvent.Status.FAILED, "PASSIVE_NO_RESPONSE", LivenessEvent.FAILED_MESSAGE));
+                    break;
+                }
+                events.addAll(startActive(null));
+                break;
+            default:
+                events.addAll(startActive(r.bonafide));
+        }
+        return events;
+    }
+
+    private List<LivenessEvent> startActive(Double score) {
+        if (!s.active.enabled) {
+            return List.of(finish(LivenessEvent.Status.FAILED, "ACTIVE_DISABLED", LivenessEvent.FAILED_MESSAGE));
+        }
+        active = new ActiveSession(s.active, resident, score, rng);
+        phase = Phase.ACTIVE;
+        return active.start();
+    }
+
+    private LivenessEvent fromActive(LivenessEvent e) {
+        phase = Phase.DONE;
+        decision = LivenessEvent.decision(e.status, e.reason, e.text, passiveScore);
+        return decision;
+    }
+
+    private LivenessEvent finish(LivenessEvent.Status status, String reason, String message) {
+        phase = Phase.DONE;
+        decision = LivenessEvent.decision(status, reason, message, passiveScore);
+        return decision;
+    }
+
+    /** Positioning hints from spec 10.5 for passive quality reasons. */
+    static List<String> guidance(List<Quality.Reason> reasons) {
+        List<String> out = new ArrayList<>();
+        for (Quality.Reason r : reasons) {
+            String g;
+            switch (r) {
+                case NO_FACE:
+                case FACE_CUT_OFF: g = "Keep your face within the capture area."; break;
+                case FACE_TOO_SMALL: g = "Move closer to the camera."; break;
+                case TOO_DARK:
+                case TOO_BRIGHT: g = "Improve lighting."; break;
+                case TOO_BLURRY: g = "Hold still."; break;
+                case POSE_OUT_OF_RANGE: g = "Look directly at the camera."; break;
+                case MULTIPLE_FACES: g = "Only one person should be in front of the camera."; break;
+                default: g = "Ensure your face is clearly visible.";
+            }
+            if (!out.contains(g)) out.add(g);
+        }
+        return out;
+    }
+}
