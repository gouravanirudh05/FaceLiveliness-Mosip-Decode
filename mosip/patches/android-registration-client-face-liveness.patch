--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/FaceObservation.java
@@ -0,0 +1,67 @@
+package io.mosip.registration.livenessmanager.active;
+
+import java.util.Collections;
+import java.util.Map;
+
+/**
+ * What the action detectors need from one analysed frame (port of face-liveness-active {@code FaceObservation}).
+ * Angles in degrees, camera frame: yaw &gt; 0 = face points to the subject's left, pitch &gt; 0 = up.
+ * {@code gazeHorizontal} in [-1, 1], &gt; 0 = eyes look to the subject's left.
+ */
+public final class FaceObservation {
+    public final long timestampMs;
+    public final int faceCount;
+    public final Map<String, Float> blendshapes;
+    public final double yawDeg, pitchDeg, rollDeg, gazeHorizontal;
+
+    public FaceObservation(long timestampMs, int faceCount, Map<String, Float> blendshapes, double yawDeg,
+                           double pitchDeg, double rollDeg, double gazeHorizontal) {
+        this.timestampMs = timestampMs;
+        this.faceCount = faceCount;
+        this.blendshapes = blendshapes == null ? Collections.emptyMap() : blendshapes;
+        this.yawDeg = yawDeg;
+        this.pitchDeg = pitchDeg;
+        this.rollDeg = rollDeg;
+        this.gazeHorizontal = gazeHorizontal;
+    }
+
+    public static FaceObservation noFace(long ts, int count) {
+        return new FaceObservation(ts, count, null, 0, 0, 0, 0);
+    }
+
+    private double mean(String a, String b) {
+        return (blendshapes.getOrDefault(a, 0f) + blendshapes.getOrDefault(b, 0f)) / 2.0;
+    }
+
+    public double blink() { return mean("eyeBlinkLeft", "eyeBlinkRight"); }
+    public double smile() { return mean("mouthSmileLeft", "mouthSmileRight"); }
+    public double jawOpen() { return blendshapes.getOrDefault("jawOpen", 0f); }
+    public double gazeUp() { return mean("eyeLookUpLeft", "eyeLookUpRight"); }
+    public double gazeDown() { return mean("eyeLookDownLeft", "eyeLookDownRight"); }
+
+    /** Pose from MediaPipe's 4x4 facial transformation matrix (column-major, as MediaPipe Android returns it). */
+    public static double[] poseFromMatrix(float[] m) {
+        // r[row][col] = m[col * 4 + row]; column 2 of the rotation = direction the face points
+        double fx = m[2 * 4], fy = m[2 * 4 + 1], fz = m[2 * 4 + 2];
+        double r00 = m[0], r10 = m[1];
+        double yaw = Math.toDegrees(Math.atan2(fx, fz));
+        double pitch = Math.toDegrees(Math.atan2(fy, Math.hypot(fx, fz)));
+        double roll = Math.toDegrees(Math.atan2(r10, r00));
+        return new double[]{yaw, pitch, roll};
+    }
+
+    /** Mean iris position across both eyes in [-1, 1]; &gt; 0 = towards image right. xs = landmark x coordinates. */
+    public static double gazeHorizontal(float[] xs) {
+        int[][] eyes = {{33, 133, 468}, {362, 263, 473}};
+        double sum = 0;
+        int n = 0;
+        for (int[] e : eyes) {
+            double width = xs[e[1]] - xs[e[0]];
+            if (Math.abs(width) < 1e-6) continue;
+            sum += (xs[e[2]] - xs[e[0]]) / width;
+            n++;
+        }
+        if (n == 0) return 0.0;
+        return Math.max(-1.0, Math.min(1.0, (sum / n - 0.5) * 2.0));
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/LivenessEvent.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/LivenessEvent.java
