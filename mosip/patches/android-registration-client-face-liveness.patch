+package io.mosip.registration.livenessmanager.active;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Active liveness policy (port of face-liveness-active {@code config.LivenessPolicy}); defaults equal
+ * face-liveness-active config/default.yaml.
+ */
+public final class ActivePolicy {
+
+    public enum Tier { EASY, MEDIUM, HARD }
+
+    public enum Action {
+        BLINK, SMILE, OPEN_MOUTH, TURN_LEFT, TURN_RIGHT, LOOK_UP, LOOK_DOWN, NOD, GAZE_LEFT, GAZE_RIGHT, GAZE_UP,
+        GAZE_DOWN;
+
+        /** The config / protocol name, e.g. "turn_left". */
+        public String code() { return name().toLowerCase(); }
+
+        public static Action fromCode(String code) {
+            return Action.valueOf(code.trim().toUpperCase());
+        }
+    }
+
+    public static final Map<Action, Tier> TIER_OF = new EnumMap<>(Action.class);
+    static final Map<Action, String> PHRASES = new EnumMap<>(Action.class);
+
+    static {
+        for (Action a : new Action[]{Action.BLINK, Action.SMILE, Action.OPEN_MOUTH}) TIER_OF.put(a, Tier.EASY);
+        for (Action a : new Action[]{Action.TURN_LEFT, Action.TURN_RIGHT, Action.LOOK_UP, Action.LOOK_DOWN}) {
+            TIER_OF.put(a, Tier.MEDIUM);
+        }
+        for (Action a : new Action[]{Action.NOD, Action.GAZE_LEFT, Action.GAZE_RIGHT, Action.GAZE_UP, Action.GAZE_DOWN}) {
+            TIER_OF.put(a, Tier.HARD);
+        }
+        PHRASES.put(Action.BLINK, "blink");
+        PHRASES.put(Action.SMILE, "smile");
+        PHRASES.put(Action.OPEN_MOUTH, "open your mouth");
+        PHRASES.put(Action.TURN_LEFT, "turn your head to the left");
+        PHRASES.put(Action.TURN_RIGHT, "turn your head to the right");
+        PHRASES.put(Action.LOOK_UP, "tilt your head up");
+        PHRASES.put(Action.LOOK_DOWN, "tilt your head down");
+        PHRASES.put(Action.NOD, "nod your head");
+        PHRASES.put(Action.GAZE_LEFT, "keep your head still and look to the left with your eyes");
+        PHRASES.put(Action.GAZE_RIGHT, "keep your head still and look to the right with your eyes");
+        PHRASES.put(Action.GAZE_UP, "keep your head still and look up with your eyes");
+        PHRASES.put(Action.GAZE_DOWN, "keep your head still and look down with your eyes");
+    }
+
+    public static final class StepParams {
+        public final double timeoutS, yawDeg, pitchDeg;
+
+        public StepParams(double timeoutS, double yawDeg, double pitchDeg) {
+            this.timeoutS = timeoutS;
+            this.yawDeg = yawDeg;
+            this.pitchDeg = pitchDeg;
+        }
+    }
+
+    public static final class Thresholds {
+        public double blinkClosed = 0.5, blinkOpen = 0.2, smile = 0.5, smileNeutral = 0.3, mouthOpen = 0.4,
+                mouthNeutral = 0.15, gazeHorizontal = 0.15, gazeVertical = 0.3, headStillDeg = 8, stabilityDeg = 3,
+                stabilityGaze = 0.05, nodReturnRatio = 0.5;
+        public int holdFrames = 3, neutralFrames = 3, maxInvalidFrames = 3;
+    }
+
+    public static final class Escalation {
+        public double passiveWeakThreshold = 0.5, defaultPassiveScore = 0.0, weakMargin = 0.15;
+        public int maxExtraChallenges = 2;
+    }
+
+    public boolean enabled = true;
+    public int minChallenges = 3;
+    public List<Action> challengePool = new ArrayList<>(Arrays.asList(Action.values()));
+    public boolean compoundChallenges = true;
+    public int maxRetries = 3;
+    public List<StepParams> steps = new ArrayList<>(Arrays.asList(
+            new StepParams(8, 15, 10), new StepParams(6, 20, 12), new StepParams(5, 25, 15)));
+    public Escalation escalation = new Escalation();
+    public Thresholds thresholds = new Thresholds();
+
+    public int maxAttempts() { return 1 + maxRetries; }
+
+    public StepParams stepParams(int stepIndex) { return steps.get(Math.min(stepIndex, steps.size() - 1)); }
+
+    /** Applies caller overrides (same semantics as the service's {@code apply_overrides}); null keeps the value. */
+    public ActivePolicy withOverrides(Boolean enabled, Integer minChallenges, List<String> pool, Boolean compound,
+                                      Integer maxRetries, List<Double> stepTimeoutsS) {
+        if (enabled != null) this.enabled = enabled;
+        if (minChallenges != null) {
+            if (minChallenges < 1) throw new IllegalArgumentException("min challenges must be >= 1");
+            this.minChallenges = minChallenges;
+        }
+        if (pool != null && !pool.isEmpty()) {
+            List<Action> p = new ArrayList<>();
+            for (String s : pool) {
+                Action a = Action.fromCode(s);
+                if (p.contains(a)) throw new IllegalArgumentException("duplicate challenge " + s);
+                p.add(a);
+            }
+            this.challengePool = p;
+        }
+        if (compound != null) this.compoundChallenges = compound;
+        if (maxRetries != null) {
+            if (maxRetries < 0) throw new IllegalArgumentException("max retries must be >= 0");
+            this.maxRetries = maxRetries;
+        }
+        if (stepTimeoutsS != null && !stepTimeoutsS.isEmpty()) {
+            int n = Math.max(stepTimeoutsS.size(), steps.size());
+            List<StepParams> s = new ArrayList<>();
+            for (int i = 0; i < n; i++) {
+                double t = stepTimeoutsS.get(Math.min(i, stepTimeoutsS.size() - 1));
+                if (t <= 0) throw new IllegalArgumentException("step timeouts must be > 0");
+                StepParams base = stepParams(i);
+                s.add(new StepParams(t, base.yawDeg, base.pitchDeg));
+            }
+            this.steps = s;
+        }
+        return this;
+    }
+
+    public List<Action> pool() { return Collections.unmodifiableList(challengePool); }
+}
