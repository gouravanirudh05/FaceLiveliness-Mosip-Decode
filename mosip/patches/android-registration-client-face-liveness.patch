@@ -0,0 +1,67 @@
+package io.mosip.registration.livenessmanager.core;
+
+import java.nio.FloatBuffer;
+import java.util.Collections;
+
+import ai.onnxruntime.OnnxTensor;
+import ai.onnxruntime.OrtEnvironment;
+import ai.onnxruntime.OrtException;
+import ai.onnxruntime.OrtSession;
+
+/**
+ * One FSFM model exported to ONNX (face-liveness-passive/scripts/export_onnx.py): input "input" float32
+ * [N, 3, 224, 224] (already preprocessed), output "logits". Runs on the device CPU (offline).
+ */
+public final class OnnxClassifier implements Passive.Classifier {
+
+    private final Passive.ModelSpec spec;
+    private final OrtEnvironment env;
+    private final OrtSession session;
+
+    public OnnxClassifier(Passive.ModelSpec spec, String modelPath, int threads) throws OrtException {
+        this.spec = spec;
+        this.env = OrtEnvironment.getEnvironment();
+        OrtSession.SessionOptions options = new OrtSession.SessionOptions();
+        if (threads > 0) options.setIntraOpNumThreads(threads);
+        options.setOptimizationLevel(OrtSession.SessionOptions.OptLevel.ALL_OPT);
+        this.session = env.createSession(modelPath, options);
+    }
+
+    @Override
+    public Passive.ModelSpec spec() { return spec; }
+
+    @Override
+    public synchronized float[] probabilities(float[] input) {
+        long[] shape = {1, 3, Preprocess.INPUT, Preprocess.INPUT};
+        try (OnnxTensor t = OnnxTensor.createTensor(env, FloatBuffer.wrap(input), shape);
+             OrtSession.Result r = session.run(Collections.singletonMap("input", t))) {
+            float[] logits = ((float[][]) r.get(0).getValue())[0];
+            return softmax(logits);
+        } catch (OrtException e) {
+            throw new IllegalStateException("liveness model " + spec.name + " failed: " + e.getMessage(), e);
+        }
+    }
+
+    static float[] softmax(float[] z) {
+        double max = Double.NEGATIVE_INFINITY;
+        for (float v : z) max = Math.max(max, v);
+        double sum = 0;
+        double[] e = new double[z.length];
+        for (int i = 0; i < z.length; i++) {
+            e[i] = Math.exp(z[i] - max);
+            sum += e[i];
+        }
+        float[] out = new float[z.length];
+        for (int i = 0; i < z.length; i++) out[i] = (float) (e[i] / sum);
+        return out;
+    }
+
+    @Override
+    public void close() {
+        try {
+            session.close();
+        } catch (OrtException ignored) {
+            // closing
+        }
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/Passive.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/Passive.java
new file mode 100644
index 0000000000000000000000000000000000000000..f31d36d2cfd83ffc60bcaa8a5b92263bc1985482
--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/Passive.java
@@ -0,0 +1,238 @@
+package io.mosip.registration.livenessmanager.core;
+
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Passive liveness / PAD scoring (port of face-liveness-passive {@code models.fuse}, {@code engine.decide} and the
+ * {@code PassiveStream} sampling/aggregation). Model inference is behind {@link Classifier} so the same logic runs
+ * with ONNX Runtime on Android and in JVM tests.
+ */
+public final class Passive {
+
+    public enum Decision { BONAFIDE, ATTACK, UNCERTAIN, NON_RESPONSE }
+
+    /** Fused categories, in this order: bonafide, presentation_attack, deepfake, synthetic. */
+    public static final List<String> CATEGORIES =
+            Collections.unmodifiableList(Arrays.asList("bonafide", "presentation_attack", "deepfake", "synthetic"));
+
+    /** One FSFM checkpoint's output layout. */
+    public static final class ModelSpec {
+        public final String name;
+        public final List<String> labels;
+        public final int bonafideIndex;
+        /** Index of each CATEGORIES entry in this model's outputs, or -1. */
+        final int[] categoryIndex;
+
+        ModelSpec(String name, List<String> labels, int bonafideIndex, int[] categoryIndex) {
+            this.name = name;
+            this.labels = labels;
+            this.bonafideIndex = bonafideIndex;
+            this.categoryIndex = categoryIndex;
+        }
+    }
+
+    public static final ModelSpec UNIFIED = new ModelSpec("unified",
+            Arrays.asList("bonafide", "deepfake", "synthetic", "presentation_attack"), 0, new int[]{0, 3, 1, 2});
+    public static final ModelSpec FAS = new ModelSpec("fas",
+            Arrays.asList("presentation_attack", "bonafide"), 1, new int[]{1, 0, -1, -1});
+
+    /** Maps a preprocessed input (3 x 224 x 224) to class probabilities in the spec's label order. */
+    public interface Classifier extends AutoCloseable {
+        ModelSpec spec();
+
+        float[] probabilities(float[] input);
+
+        @Override
+        default void close() {
+        }
+    }
+
+    /** Decision thresholds and stream sampling (defaults = face-liveness-passive config/default.yaml). */
+    public static final class Config {
+        public double acceptThreshold = 0.80;
+        public double rejectThreshold = 0.40;
+        public int framesRequired = 5;
+        public long minFrameIntervalMs = 150;
+        public long maxDurationMs = 10_000;
+        public double cropScale = FaceCrop.DEFAULT_SCALE;
+        public Quality.Limits quality = new Quality.Limits();
+        public Map<String, Double> weights = new LinkedHashMap<>();
+
+        public Config() {
+            weights.put("unified", 0.5);
+            weights.put("fas", 0.5);
+        }
+    }
+
+    private Passive() {
+    }
+
+    /** Fused distribution over {@link #CATEGORIES}; sums to 1. */
+    public static double[] fuse(List<ModelSpec> specs, List<float[]> probs, Map<String, Double> weights) {
+        double total = 0, bona = 0;
+        for (int i = 0; i < specs.size(); i++) {
+            double w = weights.getOrDefault(specs.get(i).name, 1.0);
+            total += w;
+            bona += w * probs.get(i)[specs.get(i).bonafideIndex];
+        }
+        bona /= total;
+        double[] split = new double[CATEGORIES.size() - 1];
+        for (int i = 0; i < specs.size(); i++) {
+            int[] idx = Arrays.copyOfRange(specs.get(i).categoryIndex, 1, CATEGORIES.size());
+            int typed = 0;
+            for (int j : idx) if (j >= 0) typed++;
+            if (typed < 2) continue;                       // a binary model says whether, not which
+            double[] cond = new double[idx.length];
+            double s = 0;
+            for (int k = 0; k < idx.length; k++) {
+                cond[k] = idx[k] >= 0 ? probs.get(i)[idx[k]] : 0.0;
+                s += cond[k];
+            }
+            if (s > 0) {
+                double w = weights.getOrDefault(specs.get(i).name, 1.0);
+                for (int k = 0; k < idx.length; k++) split[k] += w * cond[k] / s;
+            }
+        }
+        double ss = 0;
+        for (double v : split) ss += v;
+        if (ss == 0) {
+            split[0] = 1.0;
+            ss = 1.0;
+        }
+        double[] out = new double[CATEGORIES.size()];
+        out[0] = bona;
+        for (int k = 0; k < split.length; k++) out[k + 1] = split[k] / ss * (1.0 - bona);
+        return out;
+    }
+
+    public static Decision decide(Double bonafide, List<Quality.Reason> reasons, boolean enforceQuality, Config c) {
+        if (bonafide == null || reasons.contains(Quality.Reason.MULTIPLE_FACES)) return Decision.NON_RESPONSE;
+        if (!reasons.isEmpty() && enforceQuality) return Decision.NON_RESPONSE;
+        if (bonafide >= c.acceptThreshold) return Decision.BONAFIDE;
+        if (bonafide < c.rejectThreshold) return Decision.ATTACK;
+        return Decision.UNCERTAIN;
+    }
+
+    /** One analysed frame. */
+    public static final class FrameResult {
+        public final long timestampMs;
+        public final Decision decision;
+        public final Double bonafide;              // null when not scored
+        public final double[] categories;          // null when not scored
+        public final List<Quality.Reason> reasons;
+
+        FrameResult(long ts, Decision d, Double bonafide, double[] categories, List<Quality.Reason> reasons) {
+            this.timestampMs = ts;
+            this.decision = d;
+            this.bonafide = bonafide;
+            this.categories = categories;
+            this.reasons = Collections.unmodifiableList(reasons);
+        }
+    }
+
+    /** Detected face, from MediaPipe on Android or from fixtures in tests. */
+    public static final class Face {
+        public final int[] box;                     // landmark extent x0, y0, x1, y1 (px)
+        public final double yawDeg, pitchDeg;
+
+        public Face(int[] box, double yawDeg, double pitchDeg) {
+            this.box = box;
+            this.yawDeg = yawDeg;
+            this.pitchDeg = pitchDeg;
+        }
+
+        public double size() { return Math.max(box[2] - box[0], box[3] - box[1]); }
+    }
+
+    /** Scores one frame (faces sorted largest first; frame row-major RGB). Port of {@code analyze_faces}. */
+    public static FrameResult analyse(byte[] rgb, int w, int h, List<Face> faces, long ts, List<Classifier> models,
+                                      Config c) {
+        if (faces.isEmpty()) {
+            return new FrameResult(ts, Decision.NON_RESPONSE, null, null, Collections.singletonList(Quality.Reason.NO_FACE));
+        }
+        Face face = faces.get(0);
+        List<Quality.Reason> reasons = new ArrayList<>();
+        if (faces.size() > 1) reasons.add(Quality.Reason.MULTIPLE_FACES);
+        FaceCrop.Box box = FaceCrop.cropBox(face.box, w, h, c.cropScale);
+        if (box.width() < 16 || box.height() < 16) {
+            reasons.add(Quality.Reason.FACE_CUT_OFF);
+            return new FrameResult(ts, Decision.NON_RESPONSE, null, null, reasons);
+        }
+        byte[] crop = FaceCrop.extract(rgb, w, box);
+        Quality q = Quality.assess(face.size(), face.yawDeg, face.pitchDeg, crop, box.width(), box.height(), box.clip,
+                c.quality);
+        for (Quality.Reason r : q.reasons) if (!reasons.contains(r)) reasons.add(r);
+        float[] input = Preprocess.toTensor(crop, box.width(), box.height());
+        List<ModelSpec> specs = new ArrayList<>();
+        List<float[]> probs = new ArrayList<>();
+        for (Classifier m : models) {
+            specs.add(m.spec());
+            probs.add(m.probabilities(input));
+        }
+        double[] categories = fuse(specs, probs, c.weights);
+        double bona = categories[0];
+        return new FrameResult(ts, decide(bona, reasons, c.quality.enforce, c), bona, categories, reasons);
+    }
+
+    /** Per-session frame sampling and aggregation (port of {@code PassiveStream}; mean aggregation). */
+    public static final class Stream {
+        private final Config c;
+        private final List<FrameResult> used = new ArrayList<>();
+        private final List<FrameResult> frames = new ArrayList<>();
+        private Long firstTs, lastTs, lastAnalysedTs;
+        private boolean timedOut;
+
+        public Stream(Config c) {
+            this.c = c;
+        }
+
+        public boolean done() { return used.size() >= c.framesRequired || timedOut; }
+
+        public int framesUsed() { return used.size(); }
+
+        public int framesRequired() { return c.framesRequired; }
+
+        /** True if a frame with this timestamp should be analysed now (sampling interval, order, duration). */
+        public boolean due(long ts) {
+            if (lastTs != null && ts <= lastTs) return false;
+            lastTs = ts;
+            if (firstTs == null) firstTs = ts;
+            if (ts - firstTs > c.maxDurationMs) timedOut = true;
+            if (done()) return false;
+            if (lastAnalysedTs != null && ts - lastAnalysedTs < c.minFrameIntervalMs) return false;
+            lastAnalysedTs = ts;
+            return true;
+        }
+
+        public void add(FrameResult r) {
+            frames.add(r);
+            if (r.decision != Decision.NON_RESPONSE) used.add(r);
+        }
+
+        /** Aggregated result; fewer than framesRequired usable frames is a NON_RESPONSE (INSUFFICIENT_FRAMES). */
+        public FrameResult result() {
+            long ts = lastTs == null ? 0 : lastTs;
+            if (used.isEmpty() || used.size() < c.framesRequired) {
+                List<Quality.Reason> reasons = new ArrayList<>();
+                for (FrameResult f : frames) for (Quality.Reason r : f.reasons) if (!reasons.contains(r)) reasons.add(r);
+                reasons.add(Quality.Reason.INSUFFICIENT_FRAMES);
+                return new FrameResult(ts, Decision.NON_RESPONSE, null, null, reasons);
+            }
+            double bona = 0;
+            double[] cats = new double[CATEGORIES.size()];
+            for (FrameResult f : used) {
+                bona += f.bonafide;
+                for (int k = 0; k < cats.length; k++) cats[k] += f.categories[k];
+            }
+            bona /= used.size();
+            for (int k = 0; k < cats.length; k++) cats[k] /= used.size();
+            return new FrameResult(ts, decide(bona, Collections.emptyList(), false, c), bona, cats,
+                    Collections.emptyList());
+        }
+    }
+}
