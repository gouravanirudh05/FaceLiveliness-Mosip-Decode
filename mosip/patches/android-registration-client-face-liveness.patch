diff --git a/lib/utils/face_liveness.dart b/lib/utils/face_liveness.dart
new file mode 100644
index 0000000000000000000000000000000000000000..aaf77c0e5519a4899f0f2fd9c5fca302fcb7fa8e
--- /dev/null
+++ b/lib/utils/face_liveness.dart
@@ -0,0 +1,25 @@
+import 'package:flutter/material.dart';
+import 'package:registration_client/main.dart';
+
+/// Face liveness / PAD gate result handling for the biometric capture screens.
+///
+/// When face liveness does not allow a capture, the native `invokeDiscoverSbi` returns
+/// `LIVENESS_<STATUS>|<user message>` (STATUS: FAILED, TIMED_OUT, CANCELLED, ENGINE_ERROR, BLOCKED) instead of
+/// starting the SBI capture. The message is already user-safe (no PAD details). Shows it and returns true, in which
+/// case the caller must not continue with the capture (no images to extract, no capture attempt consumed).
+bool handleFaceLivenessRejection(String? sbiResult) {
+  if (sbiResult == null || !sbiResult.startsWith('LIVENESS_')) {
+    return false;
+  }
+  final int sep = sbiResult.indexOf('|');
+  final String status = sep > 0 ? sbiResult.substring(9, sep) : sbiResult.substring(9);
+  final String message = sep > 0
+      ? sbiResult.substring(sep + 1)
+      : 'Face verification could not be completed. Please try again.';
+  if (status != 'CANCELLED') {
+    rootScaffoldMessengerKey.currentState?.showSnackBar(
+      SnackBar(content: Text(message), duration: const Duration(seconds: 6)),
+    );
+  }
+  return true;
+}
