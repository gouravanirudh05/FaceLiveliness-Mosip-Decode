@@ -0,0 +1,36 @@
+package io.mosip.registration.livenessmanager.core;
+
+/**
+ * FSFM model input (port of face-liveness-passive {@code models.preprocess}): square RGB crop -> Pillow bicubic
+ * resize to 256 -> centre crop 224 -> /255 -> normalise with the VGGFace2 statistics of FSFM pre-training.
+ * Output layout: CHW float32, 3 x 224 x 224.
+ */
+public final class Preprocess {
+
+    public static final int RESIZE = 256;
+    public static final int INPUT = 224;
+    static final float[] MEAN = {0.5482207536697388f, 0.42340534925460815f, 0.3654651641845703f};
+    static final float[] STD = {0.2789176106452942f, 0.2438540756702423f, 0.23493893444538116f};
+
+    private Preprocess() {
+    }
+
+    public static float[] toTensor(byte[] cropRgb, int w, int h) {
+        byte[] r = PilResize.resize(cropRgb, w, h, RESIZE, RESIZE);
+        int off = (RESIZE - INPUT) / 2;
+        float[] out = new float[3 * INPUT * INPUT];
+        int plane = INPUT * INPUT;
+        for (int y = 0; y < INPUT; y++) {
+            for (int x = 0; x < INPUT; x++) {
+                int p = ((y + off) * RESIZE + (x + off)) * 3;
+                int o = y * INPUT + x;
+                for (int c = 0; c < 3; c++) {
+                    // numpy 2: float32 array / python float stays float32, so divide in float (bit-exact)
+                    float v = (r[p + c] & 0xff) / 255.0f;
+                    out[c * plane + o] = (v - MEAN[c]) / STD[c];
+                }
+            }
+        }
+        return out;
+    }
+}
