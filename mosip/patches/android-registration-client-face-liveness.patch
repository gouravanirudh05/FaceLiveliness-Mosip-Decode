@@ -0,0 +1,98 @@
+package io.mosip.registration.livenessmanager.android;
+
+import android.content.Context;
+import android.graphics.Bitmap;
+
+import com.google.mediapipe.framework.image.BitmapImageBuilder;
+import com.google.mediapipe.framework.image.MPImage;
+import com.google.mediapipe.tasks.components.containers.Category;
+import com.google.mediapipe.tasks.components.containers.NormalizedLandmark;
+import com.google.mediapipe.tasks.core.BaseOptions;
+import com.google.mediapipe.tasks.vision.core.RunningMode;
+import com.google.mediapipe.tasks.vision.facelandmarker.FaceLandmarker;
+import com.google.mediapipe.tasks.vision.facelandmarker.FaceLandmarkerResult;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+
+import io.mosip.registration.livenessmanager.active.FaceObservation;
+import io.mosip.registration.livenessmanager.core.Passive;
+
+/**
+ * MediaPipe FaceLandmarker (VIDEO mode, same model and options as the desktop engine): one detection per frame
+ * gives the pixel face boxes for PAD and the {@link FaceObservation} for the challenges. Frames must be upright
+ * and un-mirrored (the subject's left on the image's right), as in face-liveness-active.
+ */
+public final class MediaPipeFaces implements AutoCloseable {
+
+    public static final String MODEL_ASSET = "face_landmarker.task";
+
+    /** Result of one frame. */
+    public static final class Frame {
+        public final List<Passive.Face> faces;          // largest first, pixel boxes
+        public final FaceObservation observation;
+
+        Frame(List<Passive.Face> faces, FaceObservation observation) {
+            this.faces = faces;
+            this.observation = observation;
+        }
+    }
+
+    private final FaceLandmarker landmarker;
+
+    public MediaPipeFaces(Context context) {
+        FaceLandmarker.FaceLandmarkerOptions options = FaceLandmarker.FaceLandmarkerOptions.builder()
+                .setBaseOptions(BaseOptions.builder().setModelAssetPath(MODEL_ASSET).build())
+                .setRunningMode(RunningMode.VIDEO)
+                .setNumFaces(2)
+                .setOutputFaceBlendshapes(true)
+                .setOutputFacialTransformationMatrixes(true)
+                .build();
+        landmarker = FaceLandmarker.createFromOptions(context, options);
+    }
+
+    /** Timestamps must strictly increase. */
+    public Frame analyse(Bitmap upright, long timestampMs) {
+        MPImage image = new BitmapImageBuilder(upright).build();
+        FaceLandmarkerResult r = landmarker.detectForVideo(image, timestampMs);
+        int w = upright.getWidth(), h = upright.getHeight();
+        List<List<NormalizedLandmark>> all = r.faceLandmarks();
+        List<float[]> matrices = r.facialTransformationMatrixes().orElse(Collections.emptyList());
+        List<List<Category>> shapes = r.faceBlendshapes().orElse(Collections.emptyList());
+
+        List<Passive.Face> faces = new ArrayList<>();
+        FaceObservation obs = FaceObservation.noFace(timestampMs, all.size());
+        for (int i = 0; i < all.size(); i++) {
+            List<NormalizedLandmark> lms = all.get(i);
+            float minX = Float.MAX_VALUE, minY = Float.MAX_VALUE, maxX = -Float.MAX_VALUE, maxY = -Float.MAX_VALUE;
+            float[] xs = new float[lms.size()];
+            for (int k = 0; k < lms.size(); k++) {
+                float x = lms.get(k).x() * w, y = lms.get(k).y() * h;
+                xs[k] = lms.get(k).x();
+                minX = Math.min(minX, x);
+                minY = Math.min(minY, y);
+                maxX = Math.max(maxX, x);
+                maxY = Math.max(maxY, y);
+            }
+            double[] pose = i < matrices.size() ? FaceObservation.poseFromMatrix(matrices.get(i)) : new double[3];
+            // same rounding as the Python engine: int() of the minimum, ceil of the maximum
+            int[] box = {(int) minX, (int) minY, (int) Math.ceil(maxX), (int) Math.ceil(maxY)};
+            faces.add(new Passive.Face(box, pose[0], pose[1]));
+            if (all.size() == 1) {
+                Map<String, Float> b = new HashMap<>();
+                if (i < shapes.size()) for (Category c : shapes.get(i)) b.put(c.categoryName(), c.score());
+                obs = new FaceObservation(timestampMs, 1, b, pose[0], pose[1], pose[2], FaceObservation.gazeHorizontal(xs));
+            }
+        }
+        faces.sort((a, b) -> Double.compare(b.size(), a.size()));
+        return new Frame(faces, obs);
+    }
+
+    @Override
+    public void close() {
+        landmarker.close();
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/android/ModelStore.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/android/ModelStore.java
