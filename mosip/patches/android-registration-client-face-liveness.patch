@@ -0,0 +1,363 @@
+package io.mosip.registration.livenessmanager.android;
+
+import android.Manifest;
+import android.content.Context;
+import android.content.Intent;
+import android.content.pm.PackageManager;
+import android.graphics.Bitmap;
+import android.graphics.Canvas;
+import android.graphics.Color;
+import android.graphics.DashPathEffect;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.RectF;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.util.Log;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ProgressBar;
+import android.widget.TextView;
+
+import androidx.annotation.NonNull;
+import androidx.appcompat.app.AppCompatActivity;
+import androidx.camera.core.CameraSelector;
+import androidx.camera.core.ImageAnalysis;
+import androidx.camera.core.ImageProxy;
+import androidx.camera.core.Preview;
+import androidx.camera.lifecycle.ProcessCameraProvider;
+import androidx.camera.view.PreviewView;
+import androidx.core.app.ActivityCompat;
+import androidx.core.content.ContextCompat;
+
+import com.google.common.util.concurrent.ListenableFuture;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+
+import io.mosip.registration.livenessmanager.active.LivenessEvent;
+import io.mosip.registration.livenessmanager.core.HybridSession;
+import io.mosip.registration.livenessmanager.core.OnnxClassifier;
+import io.mosip.registration.livenessmanager.core.Passive;
+
+/**
+ * On-device face liveness screen (spec 10.1-10.7) shown before the SBI face capture: live preview with a positioning
+ * oval, "Checking face liveness…", system-selected challenge prompts, real-time feedback, retry guidance and the
+ * result. Runs passive PAD (FSFM via ONNX Runtime) and active challenges (MediaPipe) entirely on the device, so it
+ * works offline. Returns the decision to the caller (see {@link LivenessContract}).
+ */
+public class LivenessActivity extends AppCompatActivity {
+
+    private static final String TAG = "LivenessActivity";
+    private static final int CAMERA_PERMISSION = 7;
+
+    private PreviewView preview;
+    private TextView status, guidance;
+    private ProgressBar progress;
+    private OvalView oval;
+
+    private final Handler ui = new Handler(Looper.getMainLooper());
+    private final ExecutorService analysisExecutor = Executors.newSingleThreadExecutor();
+    private final ExecutorService padExecutor = Executors.newSingleThreadExecutor();
+
+    private MediaPipeFaces faces;
+    private List<Passive.Classifier> models;
+    private HybridSession session;
+    private Passive.Config passiveConfig;
+    private long retryDelayMs = 3000;
+    private long sessionTimeoutMs = 180_000;
+    private long startMs;
+    private long lastTs = -1;
+    private Future<Passive.FrameResult> monitorPad;
+    private volatile boolean finished;
+    private volatile long retryAtMs = -1;
+    private int retries, challenges;
+    private String currentPrompt = "";
+    private boolean resident;
+
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        buildUi();
+        String workflow = getIntent().getStringExtra(LivenessContract.EXTRA_WORKFLOW);
+        resident = !"operator".equals(workflow) && !"supervisor".equals(workflow);
+        retryDelayMs = getIntent().getLongExtra(LivenessContract.EXTRA_RETRY_DELAY_MS, 3000);
+        sessionTimeoutMs = 1000L * getIntent().getIntExtra(LivenessContract.EXTRA_SESSION_TIMEOUT_S, 180);
+        show("Preparing face liveness…", "", 0);
+        if (ContextCompat.checkSelfPermission(this, Manifest.permission.CAMERA) != PackageManager.PERMISSION_GRANTED) {
+            ActivityCompat.requestPermissions(this, new String[]{Manifest.permission.CAMERA}, CAMERA_PERMISSION);
+        } else {
+            prepare();
+        }
+    }
+
+    @Override
+    public void onRequestPermissionsResult(int requestCode, @NonNull String[] permissions, @NonNull int[] results) {
+        super.onRequestPermissionsResult(requestCode, permissions, results);
+        if (requestCode == CAMERA_PERMISSION && results.length > 0 && results[0] == PackageManager.PERMISSION_GRANTED) {
+            prepare();
+        } else {
+            finishWith("ENGINE_ERROR", "CAMERA_PERMISSION_DENIED", LivenessEvent.ENGINE_ERROR_MESSAGE, null, false);
+        }
+    }
+
+    /** Loads the engine off the UI thread, then starts the camera. */
+    private void prepare() {
+        analysisExecutor.execute(() -> {
+            try {
+                HybridSession.Settings settings = LivenessContract.settings(getIntent());
+                passiveConfig = settings.passive;
+                ModelStore store = new ModelStore(this);
+                if (!store.ensureInstalled()) {
+                    finishWith("ENGINE_ERROR", "MODELS_NOT_PROVISIONED", LivenessEvent.ENGINE_ERROR_MESSAGE, null, false);
+                    return;
+                }
+                int threads = Math.max(1, Runtime.getRuntime().availableProcessors() / 2);
+                models = new ArrayList<>();
+                models.add(new OnnxClassifier(Passive.UNIFIED, store.file("fsfm_unified.onnx").getPath(), threads));
+                models.add(new OnnxClassifier(Passive.FAS, store.file("fsfm_fas.onnx").getPath(), threads));
+                faces = new MediaPipeFaces(this);
+                session = new HybridSession(settings, models, resident, new SecureRandom());
+                startMs = System.currentTimeMillis();
+                post(session.start());
+                ui.post(this::startCamera);
+            } catch (Throwable t) {
+                Log.e(TAG, "liveness engine failed to start", t);
+                finishWith("ENGINE_ERROR", "ENGINE_START_FAILED: " + t.getMessage(), LivenessEvent.ENGINE_ERROR_MESSAGE,
+                        null, false);
+            }
+        });
+    }
+
+    private void startCamera() {
+        ListenableFuture<ProcessCameraProvider> future = ProcessCameraProvider.getInstance(this);
+        future.addListener(() -> {
+            try {
+                ProcessCameraProvider provider = future.get();
+                Preview p = new Preview.Builder().build();
+                p.setSurfaceProvider(preview.getSurfaceProvider());
+                ImageAnalysis analysis = new ImageAnalysis.Builder()
+                        .setOutputImageFormat(ImageAnalysis.OUTPUT_IMAGE_FORMAT_RGBA_8888)
+                        .setBackpressureStrategy(ImageAnalysis.STRATEGY_KEEP_ONLY_LATEST)
+                        .build();
+                analysis.setAnalyzer(analysisExecutor, this::analyse);
+                CameraSelector selector = provider.hasCamera(CameraSelector.DEFAULT_FRONT_CAMERA)
+                        ? CameraSelector.DEFAULT_FRONT_CAMERA : CameraSelector.DEFAULT_BACK_CAMERA;
+                provider.unbindAll();
+                provider.bindToLifecycle(this, selector, p, analysis);
+            } catch (Exception e) {
+                Log.e(TAG, "camera unavailable", e);
+                finishWith("ENGINE_ERROR", "CAMERA_UNAVAILABLE", "Camera unavailable. Please check the camera and try again.",
+                        null, false);
+            }
+        }, ContextCompat.getMainExecutor(this));
+    }
+
+    /** Camera frame -> MediaPipe -> (PAD) -> hybrid session. Runs on the analysis thread. */
+    private void analyse(ImageProxy image) {
+        try {
+            if (finished || session == null) return;
+            long ts = image.getImageInfo().getTimestamp() / 1_000_000L;
+            if (ts <= lastTs) ts = lastTs + 1;
+            lastTs = ts;
+            if (System.currentTimeMillis() - startMs > sessionTimeoutMs) {
+                finishWith("FAILED", "SESSION_TIMEOUT", LivenessEvent.FAILED_MESSAGE, null, false);
+                return;
+            }
+            if (retryAtMs > 0 && System.currentTimeMillis() >= retryAtMs && session.retryAvailable()) {
+                retryAtMs = -1;
+                post(session.retry());
+            }
+            Bitmap upright = upright(image);
+            MediaPipeFaces.Frame frame = faces.analyse(upright, ts);
+            Passive.FrameResult pad = null;
+            if (session.phase() == HybridSession.Phase.PASSIVE) {
+                if (session.needsPad(ts)) pad = Passive.analyse(rgb(upright), upright.getWidth(), upright.getHeight(),
+                        frame.faces, ts, models, passiveConfig);
+            } else if (monitorPad != null && monitorPad.isDone()) {
+                pad = monitorPad.get();                       // PAD monitoring result of an earlier frame
+                monitorPad = null;
+            } else if (monitorPad == null && session.needsPad(ts)) {
+                final byte[] rgb = rgb(upright);
+                final int w = upright.getWidth(), h = upright.getHeight();
+                final List<Passive.Face> f = frame.faces;
+                final long t = ts;
+                monitorPad = padExecutor.submit(() -> Passive.analyse(rgb, w, h, f, t, models, passiveConfig));
+            }
+            post(session.process(ts, pad, frame.observation));
+        } catch (Throwable t) {
+            Log.e(TAG, "liveness frame failed", t);
+            finishWith("ENGINE_ERROR", "FRAME_FAILED: " + t.getMessage(), LivenessEvent.ENGINE_ERROR_MESSAGE, null, false);
+        } finally {
+            image.close();
+        }
+    }
+
+    private static Bitmap upright(ImageProxy image) {
+        Bitmap b = image.toBitmap();
+        int rot = image.getImageInfo().getRotationDegrees();
+        if (rot == 0) return b;
+        Matrix m = new Matrix();
+        m.postRotate(rot);
+        return Bitmap.createBitmap(b, 0, 0, b.getWidth(), b.getHeight(), m, true);
+    }
+
+    private static byte[] rgb(Bitmap b) {
+        int w = b.getWidth(), h = b.getHeight();
+        int[] px = new int[w * h];
+        b.getPixels(px, 0, w, 0, 0, w, h);
+        byte[] out = new byte[w * h * 3];
+        for (int i = 0; i < px.length; i++) {
+            out[i * 3] = (byte) (px[i] >> 16);
+            out[i * 3 + 1] = (byte) (px[i] >> 8);
+            out[i * 3 + 2] = (byte) px[i];
+        }
+        return out;
+    }
+
+    private void post(List<LivenessEvent> events) {
+        for (LivenessEvent e : events) {
+            switch (e.kind) {
+                case CHECKING:
+                    show(e.text, String.join("  ", e.guidance), e.progress);
+                    break;
+                case CHALLENGE:
+                    challenges++;
+                    currentPrompt = e.text;
+                    show(currentPrompt, e.challengeLine(), 0);
+                    break;
+                case FEEDBACK:
+                    show(currentPrompt.isEmpty() ? e.text : currentPrompt, e.text, e.progress);
+                    break;
+                case RETRY:
+                    retries++;
+                    show(e.text, LivenessEvent.retryLine(e.retriesRemaining) + "  " + String.join("  ", e.guidance), 0);
+                    retryAtMs = System.currentTimeMillis() + retryDelayMs;
+                    break;
+                case DECISION:
+                    finishWith(e.status.name(), e.reason, e.text, e.passiveScore, e.isAttack());
+                    break;
+                default:
+                    break;
+            }
+        }
+    }
+
+    private void show(String s, String g, double p) {
+        ui.post(() -> {
+            status.setText(s);
+            guidance.setText(g);
+            progress.setProgress((int) Math.round(100 * p));
+        });
+    }
+
+    private void finishWith(String st, String reason, String message, Double score, boolean attack) {
+        if (finished) return;
+        finished = true;
+        long duration = startMs == 0 ? 0 : System.currentTimeMillis() - startMs;
+        Log.i(TAG, "liveness decision " + st + " reason=" + reason + " passiveScore=" + score + " attack=" + attack
+                + " durationMs=" + duration + " retries=" + retries + " challenges=" + challenges);
+        Intent data = new Intent()
+                .putExtra(LivenessContract.RESULT_STATUS, st)
+                .putExtra(LivenessContract.RESULT_REASON, reason)
+                .putExtra(LivenessContract.RESULT_MESSAGE, message)
+                .putExtra(LivenessContract.RESULT_ATTACK, attack)
+                .putExtra(LivenessContract.RESULT_DURATION_MS, duration)
+                .putExtra(LivenessContract.RESULT_RETRIES, retries)
+                .putExtra(LivenessContract.RESULT_CHALLENGES, challenges);
+        if (score != null) data.putExtra(LivenessContract.RESULT_PASSIVE_SCORE, score);
+        boolean passed = "PASSED".equals(st);
+        ui.post(() -> {
+            oval.setColor(passed ? Color.parseColor("#66BB6A") : Color.parseColor("#EF5350"));
+            status.setText(message);
+            guidance.setText("");
+            progress.setProgress(passed ? 100 : 0);
+            setResult(RESULT_OK, data);
+            ui.postDelayed(this::finish, passed ? 1200 : 2500);
+        });
+    }
+
+    @Override
+    public void onBackPressed() {
+        if (session != null) analysisExecutor.execute(() -> post(session.cancel()));
+        else finishWith("CANCELLED", "CANCELLED", LivenessEvent.CANCELLED_MESSAGE, null, false);
+    }
+
+    @Override
+    protected void onDestroy() {
+        super.onDestroy();
+        finished = true;
+        analysisExecutor.execute(() -> {
+            if (faces != null) faces.close();
+            if (models != null) for (Passive.Classifier m : models) m.close();
+        });
+        analysisExecutor.shutdown();
+        padExecutor.shutdownNow();
+    }
+
+    // ------------------------------------------------------------------ layout
+
+    private void buildUi() {
+        FrameLayout root = new FrameLayout(this);
+        root.setBackgroundColor(Color.BLACK);
+        preview = new PreviewView(this);
+        preview.setScaleType(PreviewView.ScaleType.FILL_CENTER);
+        root.addView(preview, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        oval = new OvalView(this);
+        root.addView(oval, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+
+        LinearLayout panel = new LinearLayout(this);
+        panel.setOrientation(LinearLayout.VERTICAL);
+        panel.setBackgroundColor(Color.parseColor("#B8000000"));
+        int pad = (int) (16 * getResources().getDisplayMetrics().density);
+        panel.setPadding(pad, pad, pad, pad);
+        status = new TextView(this);
+        status.setTextColor(Color.WHITE);
+        status.setTextSize(20);
+        guidance = new TextView(this);
+        guidance.setTextColor(Color.parseColor("#FFD54F"));
+        guidance.setTextSize(15);
+        progress = new ProgressBar(this, null, android.R.attr.progressBarStyleHorizontal);
+        progress.setMax(100);
+        panel.addView(status);
+        panel.addView(guidance);
+        panel.addView(progress);
+        FrameLayout.LayoutParams lp = new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT,
+                ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.BOTTOM);
+        root.addView(panel, lp);
+        setContentView(root);
+    }
+
+    /** Face positioning guide. */
+    static final class OvalView extends View {
+        private final Paint paint = new Paint(Paint.ANTI_ALIAS_FLAG);
+
+        OvalView(Context c) {
+            super(c);
+            paint.setStyle(Paint.Style.STROKE);
+            paint.setStrokeWidth(6);
+            paint.setColor(Color.parseColor("#CCFFFFFF"));
+            paint.setPathEffect(new DashPathEffect(new float[]{30, 20}, 0));
+        }
+
+        void setColor(int color) {
+            paint.setColor(color);
+            invalidate();
+        }
+
+        @Override
+        protected void onDraw(Canvas canvas) {
+            float w = getWidth(), h = getHeight();
+            float rx = w * 0.32f, ry = Math.min(h * 0.32f, rx * 1.35f);
+            canvas.drawOval(new RectF(w / 2 - rx, h * 0.42f - ry, w / 2 + rx, h * 0.42f + ry), paint);
+        }
+    }
+}
