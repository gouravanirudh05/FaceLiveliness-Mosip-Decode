--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/Detectors.java
@@ -0,0 +1,412 @@
+package io.mosip.registration.livenessmanager.active;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.Deque;
+import java.util.EnumMap;
+import java.util.List;
+import java.util.Map;
+import java.util.function.ToDoubleFunction;
+
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Action;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.StepParams;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Thresholds;
+
+/**
+ * Per-action detectors (port of face-liveness-active {@code detectors.py}). Life cycle: WAITING_NEUTRAL (a stable,
+ * neutral baseline is required, so a static photo of a smiling or turned face cannot pass) -&gt; IN_PROGRESS
+ * (signal relative to the baseline) -&gt; COMPLETED or WRONG_ACTION (an opposite movement defeats blind replays).
+ */
+public final class Detectors {
+
+    public enum State { WAITING_NEUTRAL, IN_PROGRESS, COMPLETED, WRONG_ACTION }
+
+    public enum Hint { HOLD_STILL, KEEP_HEAD_STILL }
+
+    public static final class Update {
+        public final State state;
+        public final double progress;
+        public final double margin;
+        public final Hint hint;
+
+        Update(State state, double progress, double margin, Hint hint) {
+            this.state = state;
+            this.progress = progress;
+            this.margin = margin;
+            this.hint = hint;
+        }
+
+        static Update of(State s) { return new Update(s, 0, 0, null); }
+        static Update progress(double p) { return new Update(State.IN_PROGRESS, p, 0, null); }
+    }
+
+    public interface Detector {
+        Update update(FaceObservation obs);
+
+        void reset();
+    }
+
+    enum Feature { YAW, PITCH, GAZE_H, GAZE_UP, GAZE_DOWN }
+
+    static final Map<Feature, ToDoubleFunction<FaceObservation>> FEATURES = new EnumMap<>(Feature.class);
+
+    static {
+        FEATURES.put(Feature.YAW, o -> o.yawDeg);
+        FEATURES.put(Feature.PITCH, o -> o.pitchDeg);
+        FEATURES.put(Feature.GAZE_H, o -> o.gazeHorizontal);
+        FEATURES.put(Feature.GAZE_UP, FaceObservation::gazeUp);
+        FEATURES.put(Feature.GAZE_DOWN, FaceObservation::gazeDown);
+    }
+
+    static double clamp01(double x) { return Math.max(0.0, Math.min(1.0, x)); }
+
+    static double margin(double peak, double threshold) { return clamp01((peak - threshold) / threshold); }
+
+    /** Base class: neutral-baseline capture and terminal states. */
+    abstract static class Base implements Detector {
+        final Thresholds t;
+        Deque<FaceObservation> window;
+        Map<Feature, Double> baseline;
+        Update fin;
+        int hold;
+        double peak;
+
+        Base(Thresholds t) {
+            this.t = t;
+        }
+
+        List<Feature> stableFeatures() { return Collections.emptyList(); }
+
+        @Override
+        public void reset() {
+            window = new ArrayDeque<>();
+            baseline = null;
+            fin = null;
+            resetTracking();
+        }
+
+        @Override
+        public Update update(FaceObservation obs) {
+            if (fin != null) return fin;
+            if (baseline == null) {
+                if (!isNeutral(obs)) {
+                    window.clear();
+                    return new Update(State.WAITING_NEUTRAL, 0, 0, Hint.HOLD_STILL);
+                }
+                window.addLast(obs);
+                while (window.size() > t.neutralFrames) window.removeFirst();
+                if (window.size() < t.neutralFrames || !windowStable()) {
+                    return new Update(State.WAITING_NEUTRAL, 0, 0, Hint.HOLD_STILL);
+                }
+                baseline = new EnumMap<>(Feature.class);
+                for (Map.Entry<Feature, ToDoubleFunction<FaceObservation>> e : FEATURES.entrySet()) {
+                    double s = 0;
+                    for (FaceObservation o : window) s += e.getValue().applyAsDouble(o);
+                    baseline.put(e.getKey(), s / window.size());
+                }
+                return Update.progress(0.0);
+            }
+            Update r = track(obs);
+            if (r.state == State.COMPLETED || r.state == State.WRONG_ACTION) fin = r;
+            return r;
+        }
+
+        boolean windowStable() {
+            for (Feature f : stableFeatures()) {
+                double min = Double.MAX_VALUE, max = -Double.MAX_VALUE;
+                for (FaceObservation o : window) {
+                    double v = FEATURES.get(f).applyAsDouble(o);
+                    min = Math.min(min, v);
+                    max = Math.max(max, v);
+                }
+                double limit = (f == Feature.YAW || f == Feature.PITCH) ? t.stabilityDeg : t.stabilityGaze;
+                if (max - min > limit) return false;
+            }
+            return true;
+        }
+
+        double delta(FaceObservation obs, Feature f) {
+            return FEATURES.get(f).applyAsDouble(obs) - baseline.get(f);
+        }
+
+        Update holdUpdate(boolean active, double value, double threshold) {
+            if (active) {
+                hold++;
+                peak = Math.max(peak, value);
+                if (hold >= t.holdFrames) return new Update(State.COMPLETED, 1.0, margin(peak, threshold), null);
+                return Update.progress(0.8 + 0.2 * hold / t.holdFrames);
+            }
+            hold = 0;
+            peak = 0.0;
+            return Update.progress(0.8 * clamp01(value / threshold));
+        }
+
+        void resetTracking() {
+            hold = 0;
+            peak = 0.0;
+        }
+
+        abstract boolean isNeutral(FaceObservation obs);
+
+        abstract Update track(FaceObservation obs);
+    }
+
+    /** Smile / open mouth: blendshape rises from below `neutral` to above `threshold`. */
+    static final class Expression extends Base {
+        private final ToDoubleFunction<FaceObservation> signal;
+        private final double threshold, neutral;
+
+        Expression(Thresholds t, ToDoubleFunction<FaceObservation> signal, double threshold, double neutral) {
+            super(t);
+            this.signal = signal;
+            this.threshold = threshold;
+            this.neutral = neutral;
+            reset();
+        }
+
+        @Override
+        boolean isNeutral(FaceObservation o) { return signal.applyAsDouble(o) < neutral; }
+
+        @Override
+        Update track(FaceObservation o) {
+            double v = signal.applyAsDouble(o);
+            return holdUpdate(v >= threshold, v, threshold);
+        }
+    }
+
+    /** Eyes open -> closed -> open. */
+    static final class Blink extends Base {
+        private boolean closedSeen;
+
+        Blink(Thresholds t) {
+            super(t);
+            reset();
+        }
+
+        @Override
+        void resetTracking() {
+            closedSeen = false;
+            peak = 0.0;
+        }
+
+        @Override
+        boolean isNeutral(FaceObservation o) { return o.blink() < t.blinkOpen; }
+
+        @Override
+        Update track(FaceObservation o) {
+            double v = o.blink();
+            if (v >= t.blinkClosed) {
+                closedSeen = true;
+                peak = Math.max(peak, v);
+                return Update.progress(0.6);
+            }
+            if (closedSeen && v < t.blinkOpen) return new Update(State.COMPLETED, 1.0, margin(peak, t.blinkClosed), null);
+            if (closedSeen) return Update.progress(0.8);
+            return Update.progress(0.5 * clamp01(v / t.blinkClosed));
+        }
+    }
+
+    /** Head yaw or pitch moves by `angle` in `sign` direction; the opposite is WRONG_ACTION. */
+    static final class HeadTurn extends Base {
+        private final Feature feature;
+        private final int sign;
+        private final double angle;
+
+        HeadTurn(Thresholds t, Feature feature, int sign, double angle) {
+            super(t);
+            this.feature = feature;
+            this.sign = sign;
+            this.angle = angle;
+            reset();
+        }
+
+        @Override
+        List<Feature> stableFeatures() { return List.of(Feature.YAW, Feature.PITCH); }
+
+        @Override
+        boolean isNeutral(FaceObservation o) { return true; }
+
+        @Override
+        Update track(FaceObservation o) {
+            double d = delta(o, feature) * sign;
+            if (d <= -angle) return Update.of(State.WRONG_ACTION);
+            return holdUpdate(d >= angle, d, angle);
+        }
+    }
+
+    /** Pitch dips down by `angle`, then comes back up at least `nodReturnRatio` of the dip. */
+    static final class Nod extends Base {
+        private final double angle;
+        private double dip;
+
+        Nod(Thresholds t, double angle) {
+            super(t);
+            this.angle = angle;
+            reset();
+        }
+
+        @Override
+        List<Feature> stableFeatures() { return List.of(Feature.YAW, Feature.PITCH); }
+
+        @Override
+        void resetTracking() { dip = 0.0; }
+
+        @Override
+        boolean isNeutral(FaceObservation o) { return true; }
+
+        @Override
+        Update track(FaceObservation o) {
+            double down = -delta(o, Feature.PITCH);
+            if (down >= angle || dip != 0.0) {
+                dip = Math.max(dip, down);
+                if (down <= dip * t.nodReturnRatio) return new Update(State.COMPLETED, 1.0, margin(dip, angle), null);
+                return Update.progress(0.6);
+            }
+            return Update.progress(0.5 * clamp01(down / angle));
+        }
+    }
+
+    /** Eyes move while the head stays within `headStillDeg` of its baseline. */
+    abstract static class Gaze extends Base {
+        Gaze(Thresholds t) {
+            super(t);
+        }
+
+        @Override
+        boolean isNeutral(FaceObservation o) { return o.blink() < t.blinkClosed; }
+
+        boolean headMoved(FaceObservation o) {
+            return Math.abs(delta(o, Feature.YAW)) > t.headStillDeg || Math.abs(delta(o, Feature.PITCH)) > t.headStillDeg;
+        }
+
+        abstract double threshold();
+
+        abstract double[] signals(FaceObservation o);   // {toward, away}
+
+        boolean eyesOk(FaceObservation o) { return true; }
+
+        @Override
+        Update track(FaceObservation o) {
+            if (headMoved(o)) {
+                hold = 0;
+                peak = 0.0;
+                return new Update(State.IN_PROGRESS, 0.0, 0, Hint.KEEP_HEAD_STILL);
+            }
+            double[] s = signals(o);
+            double thr = threshold();
+            if (s[1] >= thr) return Update.of(State.WRONG_ACTION);
+            return holdUpdate(s[0] >= thr && eyesOk(o), s[0], thr);
+        }
+    }
+
+    static final class GazeHorizontal extends Gaze {
+        private final int sign;
+
+        GazeHorizontal(Thresholds t, int sign) {
+            super(t);
+            this.sign = sign;
+            reset();
+        }
+
+        @Override
+        List<Feature> stableFeatures() { return List.of(Feature.YAW, Feature.PITCH, Feature.GAZE_H); }
+
+        @Override
+        double threshold() { return t.gazeHorizontal; }
+
+        @Override
+        double[] signals(FaceObservation o) {
+            double d = delta(o, Feature.GAZE_H) * sign;
+            return new double[]{d, -d};
+        }
+    }
+
+    static final class GazeVertical extends Gaze {
+        private final boolean up;
+
+        GazeVertical(Thresholds t, boolean up) {
+            super(t);
+            this.up = up;
+            reset();
+        }
+
+        @Override
+        List<Feature> stableFeatures() { return List.of(Feature.YAW, Feature.PITCH, Feature.GAZE_UP, Feature.GAZE_DOWN); }
+
+        @Override
+        double threshold() { return t.gazeVertical; }
+
+        @Override
+        double[] signals(FaceObservation o) {
+            double u = delta(o, Feature.GAZE_UP), d = delta(o, Feature.GAZE_DOWN);
+            return up ? new double[]{u, d} : new double[]{d, u};
+        }
+
+        @Override
+        boolean eyesOk(FaceObservation o) { return o.blink() < t.blinkClosed; }   // closed eyes are not a gaze
+    }
+
+    /** Runs several detectors strictly in order; fails as soon as any part fails. */
+    static final class Compound implements Detector {
+        private final List<Detector> parts;
+        private int index;
+        private List<Double> margins;
+
+        Compound(List<Detector> parts) {
+            this.parts = parts;
+            reset();
+        }
+
+        @Override
+        public void reset() {
+            for (Detector p : parts) p.reset();
+            index = 0;
+            margins = new ArrayList<>();
+        }
+
+        @Override
+        public Update update(FaceObservation obs) {
+            int n = parts.size();
+            if (index >= n) return new Update(State.COMPLETED, 1.0, Collections.min(margins), null);
+            Update u = parts.get(index).update(obs);
+            if (u.state == State.WRONG_ACTION) return u;
+            if (u.state == State.COMPLETED) {
+                margins.add(u.margin);
+                index++;
+                if (index == n) return new Update(State.COMPLETED, 1.0, Collections.min(margins), null);
+                return Update.progress((double) index / n);
+            }
+            State s = (index == 0 && u.state == State.WAITING_NEUTRAL) ? State.WAITING_NEUTRAL : State.IN_PROGRESS;
+            return new Update(s, (index + u.progress) / n, 0, u.hint);
+        }
+    }
+
+    static Detector create(Action a, StepParams step, Thresholds t) {
+        switch (a) {
+            case BLINK: return new Blink(t);
+            case SMILE: return new Expression(t, FaceObservation::smile, t.smile, t.smileNeutral);
+            case OPEN_MOUTH: return new Expression(t, FaceObservation::jawOpen, t.mouthOpen, t.mouthNeutral);
+            case TURN_LEFT: return new HeadTurn(t, Feature.YAW, +1, step.yawDeg);
+            case TURN_RIGHT: return new HeadTurn(t, Feature.YAW, -1, step.yawDeg);
+            case LOOK_UP: return new HeadTurn(t, Feature.PITCH, +1, step.pitchDeg);
+            case LOOK_DOWN: return new HeadTurn(t, Feature.PITCH, -1, step.pitchDeg);
+            case NOD: return new Nod(t, step.pitchDeg);
+            case GAZE_LEFT: return new GazeHorizontal(t, +1);
+            case GAZE_RIGHT: return new GazeHorizontal(t, -1);
+            case GAZE_UP: return new GazeVertical(t, true);
+            case GAZE_DOWN: return new GazeVertical(t, false);
+            default: throw new IllegalArgumentException("unsupported action " + a);
+        }
+    }
+
+    public static Detector forChallenge(List<Action> actions, StepParams step, Thresholds t) {
+        if (actions.size() == 1) return create(actions.get(0), step, t);
+        List<Detector> parts = new ArrayList<>();
+        for (Action a : actions) parts.add(create(a, step, t));
+        return new Compound(parts);
+    }
+
+    private Detectors() {
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/FaceObservation.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/FaceObservation.java
