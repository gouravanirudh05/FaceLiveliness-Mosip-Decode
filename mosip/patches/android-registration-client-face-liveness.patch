--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/ActiveSession.java
@@ -0,0 +1,247 @@
+package io.mosip.registration.livenessmanager.active;
+
+import java.security.SecureRandom;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Random;
+import java.util.Set;
+
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Action;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.StepParams;
+import io.mosip.registration.livenessmanager.active.ActivePolicy.Tier;
+
+/**
+ * Active challenge-response session (port of face-liveness-active {@code session.py} and {@code challenges.py}):
+ * dynamic, unpredictable challenge selection; escalation by tier, per step, on weakness and on retry; timeouts from
+ * frame timestamps.
+ */
+public final class ActiveSession {
+
+    public enum Status { NOT_STARTED, RUNNING, RETRY_AVAILABLE, PASSED, FAILED, CANCELLED, DISABLED }
+
+    static final String SUCCESS_RESIDENT = "Good, face captured successfully";
+    static final String SUCCESS_OTHER = "Face verified successfully";
+    static final int COMPOUND_LENGTH = 2;
+
+    private final ActivePolicy policy;
+    private final boolean resident;
+    private final Double passiveScore;
+    private final Random rng;
+
+    public Status status = Status.NOT_STARTED;
+    private int attemptIndex = -1;
+    private List<Tier> tiers;
+    private int extras;
+    private Set<Action> used;
+    private int step;
+    private List<Action> challenge;
+    private long timeoutMs;
+    private Detectors.Detector detector;
+    private Long stepStartMs;
+    private int invalidRun;
+    private String lastFeedback;
+    private Long lastTs;
+    /** Every challenge issued (for audit and tests). */
+    public final List<List<Action>> history = new ArrayList<>();
+
+    public ActiveSession(ActivePolicy policy, boolean resident, Double passiveScore, Random rng) {
+        if (passiveScore != null && (passiveScore < 0 || passiveScore > 1)) {
+            throw new IllegalArgumentException("passiveScore must be within [0, 1]");
+        }
+        this.policy = policy;
+        this.resident = resident;
+        this.passiveScore = passiveScore;
+        this.rng = rng != null ? rng : new SecureRandom();
+    }
+
+    public List<LivenessEvent> start() {
+        require(Status.NOT_STARTED);
+        if (!policy.enabled) {
+            status = Status.DISABLED;
+            return List.of(LivenessEvent.decision(LivenessEvent.Status.FAILED, "LIVENESS_DISABLED",
+                    "Liveness verification is disabled", passiveScore));
+        }
+        return beginAttempt(0);
+    }
+
+    public List<LivenessEvent> retry() {
+        require(Status.RETRY_AVAILABLE);
+        return beginAttempt(attemptIndex + 1);
+    }
+
+    public List<LivenessEvent> cancel() {
+        status = Status.CANCELLED;
+        return List.of(LivenessEvent.decision(LivenessEvent.Status.CANCELLED, "CANCELLED",
+                LivenessEvent.CANCELLED_MESSAGE, passiveScore));
+    }
+
+    public List<Tier> plannedTiers() { return Collections.unmodifiableList(tiers); }
+
+    public List<LivenessEvent> process(FaceObservation obs) {
+        require(Status.RUNNING);
+        if (lastTs != null && obs.timestampMs <= lastTs) {
+            return List.of(LivenessEvent.feedback("Frame timestamps must be strictly increasing", 0));
+        }
+        lastTs = obs.timestampMs;
+        if (stepStartMs == null) stepStartMs = obs.timestampMs;
+        if (obs.timestampMs - stepStartMs > timeoutMs) return failStep("CHALLENGE_TIMEOUT");
+        if (obs.faceCount != 1) {
+            invalidRun++;
+            if (invalidRun > policy.thresholds.maxInvalidFrames) detector.reset();
+            return feedback(obs.faceCount == 0 ? "Keep your face within the capture area"
+                    : "Only one person should be in front of the camera", 0);
+        }
+        invalidRun = 0;
+        Detectors.Update u = detector.update(obs);
+        if (u.state == Detectors.State.WRONG_ACTION) return failStep("WRONG_ACTION");
+        if (u.state == Detectors.State.COMPLETED) return completeStep(u.margin);
+        if (u.hint == Detectors.Hint.HOLD_STILL) return feedback("Hold still and look at the camera", u.progress);
+        if (u.hint == Detectors.Hint.KEEP_HEAD_STILL) return feedback("Keep your head still", u.progress);
+        return feedback("Please continue", u.progress);
+    }
+
+    // ------------------------------------------------------------------ planning (challenges.py)
+
+    List<Tier> tiersForAttempt(int attemptIndex) {
+        int n = policy.minChallenges;
+        List<Tier> base = new ArrayList<>();
+        Tier[] order = {Tier.EASY, Tier.MEDIUM, Tier.HARD};
+        for (int i = 0; i < Math.min(n, 3); i++) base.add(order[i]);
+        for (int i = 3; i < n; i++) base.add(Tier.HARD);
+        List<Tier> out = new ArrayList<>();
+        for (Tier t : base) out.add(Tier.values()[Math.min(t.ordinal() + attemptIndex, Tier.HARD.ordinal())]);
+        if (passiveIsWeak() && policy.escalation.maxExtraChallenges > 0) out.add(Tier.HARD);
+        return out;
+    }
+
+    boolean passiveIsWeak() {
+        double score = passiveScore == null ? policy.escalation.defaultPassiveScore : passiveScore;
+        return score < policy.escalation.passiveWeakThreshold;
+    }
+
+    List<Action> pick(Tier tier, Set<Action> usedSet) {
+        for (Tier t : tierPreference(tier)) {
+            List<Object> options = options(t, usedSet);
+            if (!options.isEmpty()) {
+                Object o = options.get(rng.nextInt(options.size()));
+                if ("compound".equals(o)) {
+                    List<Action> parts = compoundParts(usedSet);
+                    Collections.shuffle(parts, rng);
+                    return new ArrayList<>(parts.subList(0, COMPOUND_LENGTH));
+                }
+                return List.of((Action) o);
+            }
+        }
+        if (!usedSet.isEmpty()) return pick(tier, new HashSet<>());
+        throw new IllegalStateException("challenge pool is empty");
+    }
+
+    private List<Tier> tierPreference(Tier tier) {
+        List<Tier> out = new ArrayList<>();
+        for (int t = tier.ordinal(); t <= Tier.HARD.ordinal(); t++) out.add(Tier.values()[t]);
+        for (int t = tier.ordinal() - 1; t >= 0; t--) out.add(Tier.values()[t]);
+        return out;
+    }
+
+    private List<Object> options(Tier tier, Set<Action> usedSet) {
+        List<Object> out = new ArrayList<>();
+        for (Action a : policy.challengePool) {
+            if (ActivePolicy.TIER_OF.get(a) == tier && !usedSet.contains(a)) out.add(a);
+        }
+        if (tier == Tier.HARD && policy.compoundChallenges && compoundParts(usedSet).size() >= COMPOUND_LENGTH) {
+            out.add("compound");
+        }
+        return out;
+    }
+
+    private List<Action> compoundParts(Set<Action> usedSet) {
+        List<Action> out = new ArrayList<>();
+        for (Action a : policy.challengePool) {
+            Tier t = ActivePolicy.TIER_OF.get(a);
+            if ((t == Tier.EASY || t == Tier.MEDIUM) && !usedSet.contains(a)) out.add(a);
+        }
+        return out;
+    }
+
+    static String prompt(List<Action> actions) {
+        StringBuilder sb = new StringBuilder("Please ");
+        for (int i = 0; i < actions.size(); i++) {
+            if (i > 0) sb.append(", then ");
+            sb.append(ActivePolicy.PHRASES.get(actions.get(i)));
+        }
+        return sb.toString();
+    }
+
+    // ------------------------------------------------------------------ session (session.py)
+
+    private List<LivenessEvent> beginAttempt(int index) {
+        attemptIndex = index;
+        status = Status.RUNNING;
+        tiers = tiersForAttempt(index);
+        extras = tiers.size() - policy.minChallenges;
+        used = new HashSet<>();
+        step = 0;
+        return List.of(beginStep());
+    }
+
+    private LivenessEvent beginStep() {
+        challenge = pick(tiers.get(step), used);
+        used.addAll(challenge);
+        history.add(challenge);
+        StepParams p = policy.stepParams(step);
+        timeoutMs = (long) (p.timeoutS * 1000);
+        detector = Detectors.forChallenge(challenge, p, policy.thresholds);
+        stepStartMs = null;
+        invalidRun = 0;
+        lastFeedback = null;
+        return LivenessEvent.challenge(prompt(challenge), timeoutMs, challenge).withSteps(step + 1, tiers.size());
+    }
+
+    private List<LivenessEvent> completeStep(double margin) {
+        List<LivenessEvent> events = new ArrayList<>();
+        events.add(LivenessEvent.feedback("Action detected", 1.0));
+        events.add(LivenessEvent.challengeResult(true, null));
+        ActivePolicy.Escalation esc = policy.escalation;
+        if (margin < esc.weakMargin && extras < esc.maxExtraChallenges) {
+            tiers.add(Tier.HARD);
+            extras++;
+        }
+        step++;
+        if (step < tiers.size()) {
+            events.add(beginStep());
+        } else {
+            status = Status.PASSED;
+            events.add(LivenessEvent.decision(LivenessEvent.Status.PASSED, "ACTIVE_PASSED",
+                    resident ? SUCCESS_RESIDENT : SUCCESS_OTHER, passiveScore));
+        }
+        return events;
+    }
+
+    private List<LivenessEvent> failStep(String reason) {
+        List<LivenessEvent> events = new ArrayList<>();
+        events.add(LivenessEvent.challengeResult(false, reason));
+        int remaining = policy.maxAttempts() - (attemptIndex + 1);
+        if (remaining > 0) {
+            status = Status.RETRY_AVAILABLE;
+            events.add(LivenessEvent.retry(remaining));
+        } else {
+            status = Status.FAILED;
+            events.add(LivenessEvent.decision(LivenessEvent.Status.FAILED, "ACTIVE_FAILED",
+                    LivenessEvent.MAX_RETRIES_MESSAGE, passiveScore));
+        }
+        return events;
+    }
+
+    private List<LivenessEvent> feedback(String text, double progress) {
+        String key = text + "|" + Math.round(progress * 10) / 10.0;
+        if (key.equals(lastFeedback)) return Collections.emptyList();
+        lastFeedback = key;
+        return List.of(LivenessEvent.feedback(text, progress));
+    }
+
+    private void require(Status s) {
+        if (status != s) throw new IllegalStateException("expected " + s + ", session is " + status);
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/Detectors.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/active/Detectors.java
