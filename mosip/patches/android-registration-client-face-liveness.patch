@@ -0,0 +1,71 @@
+plugins {
+    id 'com.android.library'
+}
+
+apply from: '../jacoco.gradle'
+
+// On-device face liveness / PAD for the Android Registration Client: passive (FSFM ViT-B/16 via ONNX Runtime) and
+// active challenge-response (MediaPipe FaceLandmarker), ported from face-liveness-passive / face-liveness-active.
+android {
+    lintOptions {
+        abortOnError false
+        ignoreWarnings true
+    }
+    namespace 'io.mosip.registration.livenessmanager'
+    compileSdk rootProject.ext.compileSdkVersion
+
+    defaultConfig {
+        minSdk rootProject.ext.minSdkVersion
+        targetSdk rootProject.ext.targetSdkVersion
+        testInstrumentationRunner "androidx.test.runner.AndroidJUnitRunner"
+        consumerProguardFiles "consumer-rules.pro"
+        versionCode 1
+        versionName '1.0'
+    }
+
+    buildTypes {
+        debug {
+            testCoverageEnabled true
+        }
+        release {
+            minifyEnabled false
+            proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'
+        }
+    }
+    compileOptions {
+        sourceCompatibility JavaVersion.VERSION_21
+        targetCompatibility JavaVersion.VERSION_21
+    }
+    buildToolsVersion buildToolsVersion
+
+    testOptions {
+        unitTests.all {
+            // Parity fixtures and ONNX models exported by face-liveness-passive/scripts/export_onnx.py
+            systemProperty 'liveness.onnx.dir',
+                    "${rootProject.rootDir}/../../../face-liveness-passive/models/onnx"
+            maxHeapSize = "3g"
+        }
+    }
+}
+
+// JVM unit tests use the desktop ONNX Runtime (same ai.onnxruntime API); keep the Android AAR off their classpath.
+configurations.configureEach {
+    if (name.toLowerCase().contains('unittest')) {
+        exclude group: 'com.microsoft.onnxruntime', module: 'onnxruntime-android'
+    }
+}
+
+dependencies {
+    implementation "androidx.appcompat:appcompat:${rootProject.ext.appcompatVersion}"
+    implementation "androidx.camera:camera-core:1.3.4"
+    implementation "androidx.camera:camera-camera2:1.3.4"
+    implementation "androidx.camera:camera-lifecycle:1.3.4"
+    implementation "androidx.camera:camera-view:1.3.4"
+    implementation "com.google.mediapipe:tasks-vision:1.0.0"
+    implementation "com.microsoft.onnxruntime:onnxruntime-android:1.30.0"
+
+    testImplementation "junit:junit:${rootProject.ext.junitVersion}"
+    // JVM build of the same ONNX Runtime, to check the exported models and the Java preprocessing on the desktop
+    testImplementation "com.microsoft.onnxruntime:onnxruntime:1.30.0"
+    androidTestImplementation "androidx.test.ext:junit:${rootProject.ext.androidxJunitVersion}"
+}
