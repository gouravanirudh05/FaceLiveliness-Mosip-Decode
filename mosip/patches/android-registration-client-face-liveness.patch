@@ -0,0 +1,56 @@
+package io.mosip.registration.livenessmanager.core;
+
+/**
+ * Square model-input crop around a face (port of face-liveness-passive {@code face.crop_box / extract_crop}):
+ * side = landmark extent x {@code scale} (1.17 = dlib's 1.3 x 0.90, see the passive module), clipped like the
+ * FSFM reference {@code get_boundingbox} (top-left clamped at 0, then shrunk to fit).
+ */
+public final class FaceCrop {
+
+    public static final double DEFAULT_SCALE = 1.17;
+
+    /** Crop box {x0, y0, x1, y1} and the fraction of the ideal square that fell outside the frame. */
+    public static final class Box {
+        public final int x0, y0, x1, y1;
+        public final double clip;
+
+        Box(int x0, int y0, int x1, int y1, double clip) {
+            this.x0 = x0;
+            this.y0 = y0;
+            this.x1 = x1;
+            this.y1 = y1;
+            this.clip = clip;
+        }
+
+        public int width() { return x1 - x0; }
+        public int height() { return y1 - y0; }
+    }
+
+    private FaceCrop() {
+    }
+
+    /** {@code faceBox} = landmark extent {x0, y0, x1, y1} in pixels. */
+    public static Box cropBox(int[] faceBox, int frameW, int frameH, double scale) {
+        int fx0 = faceBox[0], fy0 = faceBox[1], fx1 = faceBox[2], fy1 = faceBox[3];
+        int side = (int) (Math.max(fx1 - fx0, fy1 - fy0) * scale);
+        int cx = Math.floorDiv(fx0 + fx1, 2), cy = Math.floorDiv(fy0 + fy1, 2);
+        int ix = cx - Math.floorDiv(side, 2), iy = cy - Math.floorDiv(side, 2);
+        int insideW = Math.max(0, Math.min(ix + side, frameW) - Math.max(ix, 0));
+        int insideH = Math.max(0, Math.min(iy + side, frameH) - Math.max(iy, 0));
+        double clip = side > 0 ? 1.0 - (insideW * (double) insideH) / ((double) side * side) : 1.0;
+        int x = Math.max(ix, 0), y = Math.max(iy, 0);
+        side = Math.min(frameW - x, side);
+        side = Math.min(frameH - y, side);
+        return new Box(x, y, x + side, y + side, Math.round(clip * 1e4) / 1e4);
+    }
+
+    /** Copies the box out of a row-major RGB frame. */
+    public static byte[] extract(byte[] rgb, int frameW, Box b) {
+        int w = b.width(), h = b.height();
+        byte[] out = new byte[w * h * 3];
+        for (int y = 0; y < h; y++) {
+            System.arraycopy(rgb, ((b.y0 + y) * frameW + b.x0) * 3, out, y * w * 3, w * 3);
+        }
+        return out;
+    }
+}
diff --git a/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/HybridSession.java b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/HybridSession.java
