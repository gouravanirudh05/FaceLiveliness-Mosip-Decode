@@ -0,0 +1,113 @@
+package io.mosip.registration.livenessmanager.active;
+
+import java.util.Arrays;
+import java.util.Collections;
+import java.util.List;
+
+/**
+ * Progress and result events of a liveness session, for the capture screen and the audit trail. Texts are the
+ * spec's user messages; they never mention attack detection (spec 10.6).
+ */
+public final class LivenessEvent {
+
+    public enum Kind { CHECKING, CHALLENGE, FEEDBACK, CHALLENGE_RESULT, RETRY, DECISION }
+
+    public enum Status { PASSED, FAILED, CANCELLED }
+
+    public static final String CHECKING_TEXT = "Checking face liveness…";
+    public static final String RETRY_MESSAGE = "We could not verify face liveness. Please try again.";
+    public static final List<String> RETRY_GUIDANCE = Collections.unmodifiableList(Arrays.asList(
+            "Look directly at the camera.", "Ensure your face is clearly visible.", "Improve lighting.",
+            "Keep your face within the capture area.", "Follow the prompted action."));
+    public static final String MAX_RETRIES_MESSAGE =
+            "Face verification could not be completed. Please follow the applicable recovery process.";
+    public static final String FAILED_MESSAGE = MAX_RETRIES_MESSAGE;
+    public static final String ENGINE_ERROR_MESSAGE = "Face verification could not be completed. Please try again.";
+    public static final String CANCELLED_MESSAGE = "Face verification was cancelled";
+
+    public final Kind kind;
+    public final String text;
+    public final double progress;
+    public final List<String> guidance;
+    public final long timeoutMs;
+    public final int retriesRemaining;
+    public final boolean passed;
+    public final Status status;
+    /** Machine-readable reason for audit (e.g. ATTACK_DETECTED); never shown to the user. */
+    public final String reason;
+    public final Double passiveScore;
+    public final List<ActivePolicy.Action> actions;
+    /** CHALLENGE only: 1-based step and number of steps in this attempt (may grow by escalation); else 0. */
+    public int step;
+    public int totalSteps;
+
+    private LivenessEvent(Kind kind, String text, double progress, List<String> guidance, long timeoutMs,
+                          int retriesRemaining, boolean passed, Status status, String reason, Double passiveScore,
+                          List<ActivePolicy.Action> actions) {
+        this.kind = kind;
+        this.text = text == null ? "" : text;
+        this.progress = progress;
+        this.guidance = guidance == null ? Collections.emptyList() : guidance;
+        this.timeoutMs = timeoutMs;
+        this.retriesRemaining = retriesRemaining;
+        this.passed = passed;
+        this.status = status;
+        this.reason = reason;
+        this.passiveScore = passiveScore;
+        this.actions = actions == null ? Collections.emptyList() : actions;
+    }
+
+    public static LivenessEvent checking(double progress, List<String> guidance) {
+        return new LivenessEvent(Kind.CHECKING, CHECKING_TEXT, progress, guidance, 0, -1, false, null, null, null, null);
+    }
+
+    public static LivenessEvent challenge(String prompt, long timeoutMs, List<ActivePolicy.Action> actions) {
+        return new LivenessEvent(Kind.CHALLENGE, prompt, 0, null, timeoutMs, -1, false, null, null, null, actions);
+    }
+
+    LivenessEvent withSteps(int step, int totalSteps) {
+        this.step = step;
+        this.totalSteps = totalSteps;
+        return this;
+    }
+
+    /** "Step 2 of 3 · 6 s": challenge progress and time limit (same text as the desktop client). */
+    public String challengeLine() {
+        String time = Math.max(1, timeoutMs / 1000) + " s";
+        return totalSteps > 0 ? "Step " + step + " of " + totalSteps + " \u00b7 " + time : time;
+    }
+
+    /** Spec 10.7: say clearly that a retry is available, and how many are left (same text as the desktop client). */
+    public static String retryLine(int retriesRemaining) {
+        if (retriesRemaining < 0) return "Retrying…";
+        return "Retry available \u2013 starting again shortly"
+                + (retriesRemaining == 0 ? " (last attempt)." : " (" + retriesRemaining + " more after this).");
+    }
+
+    public static LivenessEvent feedback(String text, double progress) {
+        return new LivenessEvent(Kind.FEEDBACK, text, progress, null, 0, -1, false, null, null, null, null);
+    }
+
+    public static LivenessEvent challengeResult(boolean passed, String reason) {
+        return new LivenessEvent(Kind.CHALLENGE_RESULT, passed ? "Action detected" : reason, passed ? 1 : 0, null, 0,
+                -1, passed, null, reason, null, null);
+    }
+
+    public static LivenessEvent retry(int remaining) {
+        return new LivenessEvent(Kind.RETRY, RETRY_MESSAGE, 0, RETRY_GUIDANCE, 0, remaining, false, null, null, null, null);
+    }
+
+    public static LivenessEvent decision(Status status, String reason, String message, Double passiveScore) {
+        return new LivenessEvent(Kind.DECISION, message, status == Status.PASSED ? 1 : 0, null, 0, -1,
+                status == Status.PASSED, status, reason, passiveScore, null);
+    }
+
+    public boolean isAttack() {
+        return "ATTACK_DETECTED".equals(reason) || "ATTACK_DETECTED_DURING_ACTIVE".equals(reason);
+    }
+
+    @Override
+    public String toString() {
+        return kind + (status != null ? "/" + status : "") + ": " + text + (reason != null ? " [" + reason + "]" : "");
+    }
+}
