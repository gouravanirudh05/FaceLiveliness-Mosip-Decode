index 0000000000000000000000000000000000000000..eacab1c90a881e76689c29b2597ebb9b88e88f94
--- /dev/null
+++ b/android/livenessmanager/src/main/java/io/mosip/registration/livenessmanager/core/PilResize.java
@@ -0,0 +1,153 @@
+package io.mosip.registration.livenessmanager.core;
+
+/**
+ * Bicubic resize of 8-bit RGB images, bit-exact with Pillow's {@code Image.resize(size, Image.BICUBIC)}
+ * (libImaging/Resample.c: separable two-pass resampling, cubic kernel a = -0.5 widened by the scale factor when
+ * downscaling, coefficients normalised to 22-bit fixed point, horizontal pass first).
+ *
+ * <p>The FSFM models were validated with Pillow's resize, so the Android preprocessing must reproduce it exactly.
+ */
+public final class PilResize {
+
+    private static final int PRECISION_BITS = 32 - 8 - 2;
+    private static final double SUPPORT = 2.0;
+
+    private PilResize() {
+    }
+
+    private static double bicubic(double x) {
+        final double a = -0.5;
+        if (x < 0.0) x = -x;
+        if (x < 1.0) return ((a + 2.0) * x - (a + 3.0)) * x * x + 1;
+        if (x < 2.0) return (((x - 5) * x + 8) * x - 4) * a;
+        return 0.0;
+    }
+
+    /** Coefficients for one axis: bounds[2*i] = first source index, bounds[2*i+1] = count; kk is outSize x ksize. */
+    private static final class Coeffs {
+        int ksize;
+        int[] bounds;
+        int[] kk;
+    }
+
+    private static Coeffs precompute(int inSize, double in0, double in1, int outSize) {
+        double scale = (in1 - in0) / outSize;
+        double filterscale = scale < 1.0 ? 1.0 : scale;
+        double support = SUPPORT * filterscale;
+        int ksize = (int) Math.ceil(support) * 2 + 1;
+        double[] k = new double[outSize * ksize];
+        int[] bounds = new int[outSize * 2];
+        for (int xx = 0; xx < outSize; xx++) {
+            double center = in0 + (xx + 0.5) * scale;
+            double ww = 0.0;
+            double ss = 1.0 / filterscale;
+            int xmin = (int) (center - support + 0.5);
+            if (xmin < 0) xmin = 0;
+            int xmax = (int) (center + support + 0.5);
+            if (xmax > inSize) xmax = inSize;
+            xmax -= xmin;
+            int base = xx * ksize;
+            int x;
+            for (x = 0; x < xmax; x++) {
+                double w = bicubic((x + xmin - center + 0.5) * ss);
+                k[base + x] = w;
+                ww += w;
+            }
+            for (x = 0; x < xmax; x++) {
+                if (ww != 0.0) k[base + x] /= ww;
+            }
+            for (; x < ksize; x++) k[base + x] = 0;
+            bounds[xx * 2] = xmin;
+            bounds[xx * 2 + 1] = xmax;
+        }
+        Coeffs c = new Coeffs();
+        c.ksize = ksize;
+        c.bounds = bounds;
+        c.kk = new int[k.length];
+        for (int i = 0; i < k.length; i++) {
+            c.kk[i] = k[i] < 0 ? (int) (-0.5 + k[i] * (1 << PRECISION_BITS)) : (int) (0.5 + k[i] * (1 << PRECISION_BITS));
+        }
+        return c;
+    }
+
+    private static int clip8(long in) {
+        if (in >= (1L << PRECISION_BITS << 8)) return 255;
+        if (in <= 0) return 0;
+        return (int) (in >> PRECISION_BITS);
+    }
+
+    /**
+     * Resizes {@code rgb} (row-major, 3 bytes per pixel) of {@code w x h} to {@code outW x outH}.
+     *
+     * @return the resized image, row-major RGB
+     */
+    public static byte[] resize(byte[] rgb, int w, int h, int outW, int outH) {
+        if (rgb.length < w * h * 3) throw new IllegalArgumentException("buffer smaller than w*h*3");
+        boolean needH = outW != w;
+        boolean needV = outH != h;
+        Coeffs ch = precompute(w, 0, w, outW);
+        Coeffs cv = precompute(h, 0, h, outH);
+
+        byte[] src = rgb;
+        int srcW = w;
+        int rows = h;
+        int[] vBounds = cv.bounds.clone();
+        if (needH) {
+            int yFirst = cv.bounds[0];
+            int yLast = cv.bounds[outH * 2 - 2] + cv.bounds[outH * 2 - 1];
+            if (!needV) {
+                yFirst = 0;
+                yLast = h;
+            }
+            for (int i = 0; i < outH; i++) vBounds[i * 2] -= yFirst;
+            rows = yLast - yFirst;
+            byte[] tmp = new byte[outW * rows * 3];
+            for (int yy = 0; yy < rows; yy++) {
+                int inRow = (yy + yFirst) * w * 3;
+                int outRow = yy * outW * 3;
+                for (int xx = 0; xx < outW; xx++) {
+                    int xmin = ch.bounds[xx * 2];
+                    int xmax = ch.bounds[xx * 2 + 1];
+                    int kb = xx * ch.ksize;
+                    long s0 = 1L << (PRECISION_BITS - 1), s1 = s0, s2 = s0;
+                    for (int x = 0; x < xmax; x++) {
+                        int p = inRow + (x + xmin) * 3;
+                        int k = ch.kk[kb + x];
+                        s0 += (long) (src[p] & 0xff) * k;
+                        s1 += (long) (src[p + 1] & 0xff) * k;
+                        s2 += (long) (src[p + 2] & 0xff) * k;
+                    }
+                    tmp[outRow + xx * 3] = (byte) clip8(s0);
+                    tmp[outRow + xx * 3 + 1] = (byte) clip8(s1);
+                    tmp[outRow + xx * 3 + 2] = (byte) clip8(s2);
+                }
+            }
+            src = tmp;
+            srcW = outW;
+        }
+        if (!needV) {
+            return needH ? src : src.clone();
+        }
+        byte[] out = new byte[outW * outH * 3];
+        for (int yy = 0; yy < outH; yy++) {
+            int ymin = vBounds[yy * 2];
+            int ymax = vBounds[yy * 2 + 1];
+            int kb = yy * cv.ksize;
+            for (int xx = 0; xx < outW; xx++) {
+                long s0 = 1L << (PRECISION_BITS - 1), s1 = s0, s2 = s0;
+                for (int y = 0; y < ymax; y++) {
+                    int p = ((y + ymin) * srcW + xx) * 3;
+                    int k = cv.kk[kb + y];
+                    s0 += (long) (src[p] & 0xff) * k;
+                    s1 += (long) (src[p + 1] & 0xff) * k;
+                    s2 += (long) (src[p + 2] & 0xff) * k;
+                }
+                int o = (yy * outW + xx) * 3;
+                out[o] = (byte) clip8(s0);
+                out[o + 1] = (byte) clip8(s1);
+                out[o + 2] = (byte) clip8(s2);
+            }
+        }
+        return out;
+    }
+}
