+++ b/android/clientmanager/src/main/java/io/mosip/registration/clientmanager/interceptor/MockBackendInterceptor.java
@@ -0,0 +1,330 @@
+package io.mosip.registration.clientmanager.interceptor;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.util.Log;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.Reader;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.util.HashSet;
+import java.util.Properties;
+import java.util.Set;
+
+import io.mosip.registration.keymanager.dto.CryptoRequestDto;
+import io.mosip.registration.keymanager.dto.CryptoResponseDto;
+import io.mosip.registration.keymanager.spi.ClientCryptoManagerService;
+import io.mosip.registration.keymanager.util.CryptoUtil;
+import okhttp3.Interceptor;
+import okhttp3.MediaType;
+import okhttp3.Protocol;
+import okhttp3.Request;
+import okhttp3.Response;
+import okhttp3.ResponseBody;
+import okio.Buffer;
+
+/**
+ * MOCK BACKEND -- LOCAL DEVELOPMENT / DEMO USE ONLY (Android counterpart of the desktop client's
+ * {@code -Dmosip.mock.backend=true}).
+ *
+ * <p>Enabled at build time with the Gradle property {@code mosipMockBackend=true} (BuildConfig.MOCK_BACKEND). It is
+ * the first interceptor of the app's only HTTP client, so no request ever reaches the network: every MOSIP endpoint
+ * the client calls is answered here, in the same shapes the real services return, and the app's own sync code stores
+ * the data exactly as after a real sync.
+ * <ul>
+ * <li>Login accepts any user / password and returns a locally made JWT with the officer and supervisor roles.</li>
+ * <li>Client settings (master data), configuration and user details are encrypted with this device's own key, like
+ * the server does with the registered machine key, so the normal decryption path runs.</li>
+ * <li>Data comes from the assets under {@code mock-backend/}: MOSIP's published sample data (mosip-data release-1.2.0:
+ * ID schema + UI specs, master data, applicant type script), the same files as the desktop mock backend.</li>
+ * </ul>
+ * Never enable this for a real deployment: it accepts any credentials.
+ */
+public class MockBackendInterceptor implements Interceptor {
+
+    private static final String TAG = "MockBackend";
+
+    public static final String MOCK_CENTER_ID = "10001";
+    public static final String MOCK_MACHINE_ID = "10001";
+    private static final String[] LANGUAGES = {"eng", "fra"};
+    private static final String[] ROLES = {"REGISTRATION_OFFICER", "REGISTRATION_SUPERVISOR", "REGISTRATION_OPERATOR"};
+    private static final String ASSETS = "mock-backend/";
+    private static final String PREFS = "mock_backend";
+    private static final String PREF_USERS = "users";
+    private static final MediaType JSON = MediaType.parse("application/json");
+    private static final MediaType TEXT = MediaType.parse("text/plain");
+
+    private final Context context;
+    private final ClientCryptoManagerService crypto;
+
+    public MockBackendInterceptor(Context context, ClientCryptoManagerService crypto) {
+        this.context = context.getApplicationContext();
+        this.crypto = crypto;
+    }
+
+    @Override
+    public Response intercept(Chain chain) throws IOException {
+        Request request = chain.request();
+        String path = request.url().encodedPath();
+        Log.i(TAG, "Answering " + request.method() + " " + path + " locally (mock backend)");
+        try {
+            if (path.endsWith("/v1/syncdata/authenticate/useridpwd")) {
+                return json(request, envelope(login(request)));
+            }
+            if (path.endsWith("/v1/syncdata/v2/clientsettings") || path.endsWith("/v1/syncdata/clientsettings")) {
+                return json(request, envelope(clientSettings(request)));
+            }
+            if (path.contains("/v1/syncdata/configs/")) {
+                return json(request, envelope(configs()));
+            }
+            if (path.endsWith("/v1/syncdata/v2/userdetails") || path.endsWith("/v1/syncdata/userdetails")) {
+                return json(request, envelope(userDetails()));
+            }
+            if (path.endsWith("/v1/syncdata/latestidschema")) {
+                JSONObject schema = new JSONObject(asset("mock-id-schema.json"));
+                schema.put("effectiveFrom", Instant.now().minusSeconds(60).toString());
+                return json(request, envelope(schema));
+            }
+            if (path.endsWith("/v1/syncdata/getCertificate") || path.endsWith("/registrationstatus/getCertificate")) {
+                return json(request, envelope(new JSONObject().put("certificate", asset("mock-certificate.pem"))));
+            }
+            if (path.endsWith("/v1/syncdata/getcacertificates")) {
+                return json(request, envelope(new JSONObject().put("lastSyncTime", now())
+                        .put("certificateDTOList", new JSONArray())));
+            }
+            if (path.contains("/v1/syncdata/scripts/")) {
+                String script = asset("mock-" + path.substring(path.lastIndexOf('/') + 1));
+                return response(request, script, TEXT)
+                        .header("file-signature", "mock-backend-unsigned")
+                        .header("content-length", String.valueOf(script.getBytes(StandardCharsets.UTF_8).length))
+                        .build();
+            }
+            if (path.endsWith("/registrationstatus/auth")) {
+                // operator onboarding: the server would match the operator's biometrics against the ID repository
+                return json(request, envelope(new JSONObject().put("authStatus", true)));
+            }
+            if (path.endsWith("/registrationstatus/syncV2") || path.endsWith("/registrationstatus/sync")
+                    || path.endsWith("/registrationstatus/packetexternalstatus")
+                    || path.endsWith("/registrationstatus/search")) {
+                return json(request, envelope(new JSONArray()));
+            }
+            if (path.endsWith("/packetreceiver/registrationpackets")) {
+                return json(request, envelope(new JSONObject().put("status", "PUSHED")
+                        .put("message", "mock-backend: packet not uploaded anywhere")));
+            }
+            if (path.contains("/preregistration/v1/sync")) {
+                return json(request, envelope(new JSONObject().put("preRegistrationIds", new JSONObject())
+                        .put("countOfPreRegIds", "0")));
+            }
+            return json(request, envelope(new JSONObject().put("status", "SUCCESS")
+                    .put("message", "mock-backend: no real server call was made")));
+        } catch (Exception e) {
+            Log.e(TAG, "Mock backend failed for " + path, e);
+            JSONObject error = new JSONObject();
+            try {
+                error.put("response", JSONObject.NULL);
+                error.put("errors", new JSONArray().put(new JSONObject().put("errorCode", "MOCK-BACKEND-ERROR")
+                        .put("message", String.valueOf(e.getMessage()))));
+            } catch (JSONException ignored) {
+                // keep the empty object
+            }
+            return json(request, error);
+        }
+    }
+
+    // ------------------------------------------------------------------ endpoints
+
+    /** Any user id / password is accepted; returns the token response encrypted with this device's key. */
+    private String login(Request request) throws Exception {
+        String userId = userIdFromAuthRequest(request);
+        rememberUser(userId);
+        long now = Instant.now().getEpochSecond();
+        long expiry = now + 12 * 60 * 60;
+        String token = jwt(userId, now, expiry);
+        JSONObject tokens = new JSONObject()
+                .put("token", token)
+                .put("refreshToken", jwt(userId, now, expiry))
+                .put("expiryTime", String.valueOf(expiry))
+                .put("refreshExpiryTime", String.valueOf(expiry));
+        Log.i(TAG, "Login accepted for " + userId + " (mock backend, roles " + String.join(",", ROLES) + ")");
+        return encrypt(tokens.toString());
+    }
+
+    /** The {@code /clientsettings} payload: every entity encrypted with this device's key, as the server does. */
+    private JSONObject clientSettings(Request request) throws Exception {
+        JSONArray dataToSync = new JSONArray();
+        JSONArray masterData = new JSONArray(asset("mock-master-data.json"));
+        for (int i = 0; i < masterData.length(); i++) {
+            JSONObject entity = masterData.getJSONObject(i);
+            JSONArray rows = entity.getJSONArray("rows");
+            if ("Location".equals(entity.getString("entityName"))) {
+                for (int r = 0; r < rows.length(); r++) {
+                    // the root location has no parent; the server sends null, which this client reads with getString
+                    if (!rows.getJSONObject(r).has("parentLocCode")) {
+                        rows.getJSONObject(r).put("parentLocCode", JSONObject.NULL);
+                    }
+                }
+            }
+            dataToSync.put(entity(entity.getString("entityName"), entity.getString("entityType"), rows));
+        }
+
+        String machineName = crypto.getMachineName();
+        dataToSync.put(entity("Machine", "structured", new JSONArray().put(new JSONObject()
+                .put("id", MOCK_MACHINE_ID).put("name", machineName).put("isActive", true)
+                .put("regCenterId", MOCK_CENTER_ID).put("langCode", LANGUAGES[0]))));
+        JSONArray centers = new JSONArray();
+        JSONArray languages = new JSONArray();
+        for (String lang : LANGUAGES) {
+            centers.put(new JSONObject().put("id", MOCK_CENTER_ID).put("langCode", lang)
+                    .put("name", "Mock Registration Center").put("latitude", "12.9716").put("longitude", "77.5946")
+                    .put("locationCode", "MOCK").put("isActive", true));
+            languages.put(new JSONObject().put("code", lang).put("name", "eng".equals(lang) ? "English" : "French")
+                    .put("nativeName", "eng".equals(lang) ? "English" : "Français")
+                    .put("isActive", true).put("isDeleted", false));
+        }
+        dataToSync.put(entity("RegistrationCenter", "structured", centers));
+        dataToSync.put(entity("RegistrationCenterMachine", "structured", new JSONArray().put(new JSONObject()
+                .put("regCenterId", MOCK_CENTER_ID).put("machineId", MOCK_MACHINE_ID)
+                .put("isActive", true).put("langCode", LANGUAGES[0]))));
+        dataToSync.put(entity("Language", "structured", languages));
+
+        // the applicant type script is downloaded from a URL the server sends (answered by this interceptor too)
+        String base = request.url().scheme() + "://" + request.url().host()
+                + (request.url().port() == 443 || request.url().port() == 80 ? "" : ":" + request.url().port());
+        JSONObject script = new JSONObject()
+                .put("url", base + "/v1/syncdata/scripts/applicanttype.mvel")
+                .put("headers", "").put("auth-required", true).put("auth-token", "").put("encrypted", false);
+        dataToSync.put(new JSONObject().put("entityName", "applicanttype.mvel").put("entityType", "script")
+                .put("data", encrypt(script.toString())));
+
+        return new JSONObject().put("lastSyncTime", now()).put("dataToSync", dataToSync);
+    }
+
+    /** {@code /configs}: the client configuration as one encrypted JSON object. */
+    private JSONObject configs() throws Exception {
+        Properties properties = new Properties();
+        try (Reader reader = new InputStreamReader(context.getAssets().open(ASSETS + "mock-global-config.properties"),
+                StandardCharsets.UTF_8)) {
+            properties.load(reader);
+        }
+        JSONObject config = new JSONObject();
+        for (String key : properties.stringPropertyNames()) {
+            config.put(key, properties.getProperty(key).trim());
+        }
+        JSONObject configDetail = new JSONObject()
+                .put("globalConfiguration", encrypt(config.toString()))
+                .put("registrationConfiguration", encrypt("{}"));
+        return new JSONObject().put("configDetail", configDetail);
+    }
+
+    /** {@code /userdetails}: every user that logged in on this device, mapped to the mock center. */
+    private JSONObject userDetails() throws Exception {
+        JSONArray users = new JSONArray();
+        for (String userId : users()) {
+            users.put(new JSONObject().put("userId", userId).put("name", userId).put("isActive", true)
+                    .put("isDeleted", false).put("regCenterId", MOCK_CENTER_ID));
+        }
+        return new JSONObject().put("lastSyncTime", now()).put("userDetails", encrypt(users.toString()));
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private JSONObject entity(String name, String type, JSONArray rows) throws Exception {
+        return new JSONObject().put("entityName", name).put("entityType", type).put("data", encrypt(rows.toString()));
+    }
+
+    /** Encrypts like the server encrypts for a registered machine; the app decrypts it with its own private key. */
+    private String encrypt(String plain) {
+        CryptoRequestDto request = new CryptoRequestDto();
+        request.setValue(CryptoUtil.base64encoder.encodeToString(plain.getBytes(StandardCharsets.UTF_8)));
+        CryptoResponseDto response = crypto.encrypt(request);
+        if (response == null) {
+            throw new IllegalStateException("device key encryption failed");
+        }
+        return response.getValue();
+    }
+
+    /** Unsigned JWT (the app only decodes tokens, it never verifies their signature). */
+    private static String jwt(String userId, long issuedAt, long expiry) throws JSONException {
+        JSONArray roles = new JSONArray();
+        for (String role : ROLES) {
+            roles.put(role);
+        }
+        JSONObject payload = new JSONObject()
+                .put("sub", userId).put("name", userId).put("preferred_username", userId)
+                .put("email", userId + "@mock-backend.invalid")
+                .put("iat", issuedAt).put("exp", expiry)
+                .put("realm_access", new JSONObject().put("roles", roles));
+        return b64("{\"alg\":\"none\",\"typ\":\"JWT\"}") + "." + b64(payload.toString()) + "."
+                + b64("mock-signature-not-verified");
+    }
+
+    private static String b64(String s) {
+        return CryptoUtil.base64encoder.encodeToString(s.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** The login request carries {@code header.payload.signature}; the payload holds the user id. */
+    private static String userIdFromAuthRequest(Request request) throws Exception {
+        Buffer buffer = new Buffer();
+        if (request.body() != null) {
+            request.body().writeTo(buffer);
+        }
+        String signed = new JSONObject(buffer.readUtf8()).getString("request");
+        String[] parts = signed.split("\\.");
+        JSONObject payload = new JSONObject(new String(CryptoUtil.base64decoder.decode(parts[1]), StandardCharsets.UTF_8));
+        return payload.getString("userId");
+    }
+
+    private void rememberUser(String userId) {
+        SharedPreferences prefs = context.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+        Set<String> users = new HashSet<>(prefs.getStringSet(PREF_USERS, new HashSet<>()));
+        users.add(userId);
+        prefs.edit().putStringSet(PREF_USERS, users).apply();
+    }
+
+    private Set<String> users() {
+        return context.getSharedPreferences(PREFS, Context.MODE_PRIVATE).getStringSet(PREF_USERS, new HashSet<>());
+    }
+
+    private String asset(String name) throws IOException {
+        try (InputStream in = context.getAssets().open(ASSETS + name)) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] chunk = new byte[8192];
+            int n;
+            while ((n = in.read(chunk)) > 0) {
+                out.write(chunk, 0, n);
+            }
+            return out.toString(StandardCharsets.UTF_8.name());
+        }
+    }
+
+    private static String now() {
+        return Instant.now().toString();
+    }
+
+    private static JSONObject envelope(Object response) throws JSONException {
+        return new JSONObject().put("id", JSONObject.NULL).put("version", "1.0").put("responsetime", now())
+                .put("metadata", JSONObject.NULL).put("response", response).put("errors", new JSONArray());
+    }
+
+    private static Response json(Request request, JSONObject body) {
+        return response(request, body.toString(), JSON).build();
+    }
+
+    private static Response.Builder response(Request request, String body, MediaType type) {
+        return new Response.Builder()
+                .request(request)
+                .protocol(Protocol.HTTP_1_1)
+                .code(200)
+                .message("OK")
+                .body(ResponseBody.create(type, body));
+    }
+}
