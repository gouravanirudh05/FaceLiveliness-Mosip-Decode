diff --git a/android/clientmanager/src/main/java/io/mosip/registration/clientmanager/interceptor/MockBackendInterceptor.java b/android/clientmanager/src/main/java/io/mosip/registration/clientmanager/interceptor/MockBackendInterceptor.java
