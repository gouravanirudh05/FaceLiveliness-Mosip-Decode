+	/**
+	 * Trusts MockMDS's device root CA (mosip-mock-services MockMDS "Biometric Devices/rootca.cer",
+	 * which signs its Registration-purpose device keys) in the DEVICE partner domain. The client
+	 * always validates device info, digital id and capture signatures with trust; the real CA
+	 * certificate sync (CertificateSyncServiceImpl#getCACertificates) stores these the same way.
+	 */
+	private void seedDeviceTrust() {
+		try (InputStream in = MockDataSeeder.class.getResourceAsStream(DEVICE_ROOT_CA_RESOURCE)) {
+			if (in == null) {
+				LOGGER.error("[MOCK SEED] {} not found on classpath", DEVICE_ROOT_CA_RESOURCE);
+				return;
+			}
+			CACertificateRequestDto request = new CACertificateRequestDto();
+			request.setCertificateData(new String(in.readAllBytes(), StandardCharsets.UTF_8));
+			request.setPartnerDomain(DEVICE_TRUST_DOMAIN);
+			partnerCertificateManagerService.uploadCACertificate(request);
+			LOGGER.info("[MOCK SEED] Trusted MockMDS root CA for domain {}", DEVICE_TRUST_DOMAIN);
+		} catch (Exception e) {
+			// also thrown when the certificate is already stored
+			LOGGER.info("[MOCK SEED] MockMDS root CA not uploaded: {}", e.getMessage());
+		}
+	}
+
+	/** Generates an RSA key pair, stores a self-signed certificate for it as another domain's certificate. */
+	private KeyPair uploadSelfSignedCertificate(String applicationId, String referenceId) throws Exception {
+		KeyPairGenerator generator = KeyPairGenerator.getInstance("RSA");
+		generator.initialize(2048);
+		KeyPair keyPair = generator.generateKeyPair();
+
+		X500Name subject = new X500Name("CN=" + referenceId + ",OU=MOCK,O=MOSIP");
+		Date notBefore = Date.from(Instant.now().minus(1, ChronoUnit.DAYS));
+		Date notAfter = Date.from(Instant.now().plus(3650, ChronoUnit.DAYS));
+		X509CertificateHolder holder = new JcaX509v3CertificateBuilder(subject,
+				BigInteger.valueOf(System.currentTimeMillis()), notBefore, notAfter, subject, keyPair.getPublic())
+				.build(new JcaContentSignerBuilder("SHA256withRSA").build(keyPair.getPrivate()));
+
+		String pem = "-----BEGIN CERTIFICATE-----\n"
+				+ Base64.getMimeEncoder(64, "\n".getBytes(StandardCharsets.US_ASCII)).encodeToString(holder.getEncoded())
+				+ "\n-----END CERTIFICATE-----\n";
+
+		UploadCertificateRequestDto request = new UploadCertificateRequestDto();
+		request.setApplicationId(applicationId);
+		request.setReferenceId(referenceId);
+		request.setCertificateData(pem);
+		keymanagerService.uploadOtherDomainCertificate(request);
+		return keyPair;
+	}
+
+	private static String b64Url(byte[] data) {
+		return Base64.getUrlEncoder().withoutPadding().encodeToString(data);
+	}
+
+	/**
+	 * Inserts every default from mock-global-config.properties that is not yet in
+	 * reg.global_param and publishes it to the live ApplicationContext map. Existing
+	 * rows are never overwritten.
+	 */
+	private void seedGlobalParams() {
+		Set<String> existing = new HashSet<>();
+		for (GlobalParam param : globalParamDAO.getAllEntries()) {
+			existing.add(param.getGlobalParamId().getCode());
+		}
+
+		List<GlobalParam> toSave = new ArrayList<>();
+		for (Map.Entry<String, String> entry : MockBackend.defaultGlobalConfig().entrySet()) {
+			if (existing.contains(entry.getKey()))
+				continue;
+			// the client reads these with (Long)/(Integer) casts and relies on its built-in defaults
+			// when they are absent; a String value loaded back from the DB would fail at startup
+			if (entry.getKey().startsWith("mosip.registration.retry."))
+				continue;
+
+			GlobalParamId id = new GlobalParamId();
+			id.setCode(entry.getKey());
+			id.setLangCode(RegistrationConstants.ENGLISH_LANG_CODE);
+
+			GlobalParam param = new GlobalParam();
+			param.setGlobalParamId(id);
+			param.setName(entry.getKey());
+			param.setTyp(RegistrationConstants.CONFIGURATION);
+			param.setVal(entry.getValue());
+			stamp(param);
+			toSave.add(param);
+
+			ApplicationContext.setGlobalConfigValueOf(entry.getKey(), entry.getValue());
+		}
+
+		if (!toSave.isEmpty()) {
+			globalParamDAO.saveAll(toSave);
+			newParamsInserted = true;
+			LOGGER.info("[MOCK SEED] Inserted {} global params", toSave.size());
+		}
+	}
+
