+	private void seedScreens() {
+		for (String role : ROLES) {
+			for (String screen : SCREENS) {
+				ScreenAuthorizationId id = new ScreenAuthorizationId();
+				id.setScreenId(screen);
+				id.setRoleCode(role);
+
+				if (screenAuthorizationRepository.findById(ScreenAuthorization.class, id) != null)
+					continue;
+
+				ScreenAuthorization auth = new ScreenAuthorization();
+				auth.setScreenAuthorizationId(id);
+				auth.setLangCode(RegistrationConstants.ENGLISH_LANG_CODE);
+				auth.setIsPermitted(Boolean.TRUE);
+				auth.setIsDeleted(Boolean.FALSE);
+				stamp(auth);
+				screenAuthorizationRepository.save(auth);
+			}
+		}
+	}
+
+	/**
+	 * Runs the real ID schema sync against {@link MockBackend#identitySchema()}, so the
+	 * schema and process specs (the home screen's registration tasks) are stored by
+	 * the client's own createIdentitySchema / saveProcessSpec code.
+	 */
+	private void seedIdentitySchema() {
+		if (identitySchemaRepository.findLatestEffectiveIdVersion(null) != null)
+			return;
+		try {
+			clientSettingSyncHelper.syncSchema(RegistrationConstants.JOB_TRIGGER_POINT_SYSTEM).get();
+			LOGGER.info("[MOCK SEED] Stored ID schema and process specs");
+		} catch (Exception e) {
+			LOGGER.error("[MOCK SEED] ID schema seeding failed", e);
+		}
+	}
+
+	/**
+	 * Feeds {@link MockBackend#masterData()} through the real master sync storage
+	 * (ClientSettingSyncHelper#saveClientSettings): each entity is encrypted with this
+	 * machine's key, as the server does, so dynamic fields (gender, preferredLang, ...),
+	 * locations, documents, templates etc. are decrypted and stored by the client's own code.
+	 */
+	private void seedMasterData() {
+		if (dynamicFieldRepository.count() > 0)
+			return;
+		try {
+			ObjectMapper mapper = new ObjectMapper();
+			byte[] publicKey = clientCryptoFacade.getClientSecurity().getEncryptionPublicPart();
+			List<SyncDataBaseDto> dataToSync = new ArrayList<>();
+			for (Map<String, Object> entity : MockBackend.masterData()) {
+				byte[] rows = mapper.writeValueAsBytes(entity.get("rows"));
+				dataToSync.add(new SyncDataBaseDto((String) entity.get("entityName"), (String) entity.get("entityType"),
+						CryptoUtil.encodeToURLSafeBase64(clientCryptoFacade.encrypt(publicKey, rows))));
+			}
+			clientSettingSyncHelper.saveClientSettings(new SyncDataResponseDto(null, dataToSync));
+			LOGGER.info("[MOCK SEED] Stored {} master data entities", dataToSync.size());
+		} catch (Exception e) {
+			LOGGER.error("[MOCK SEED] Master data seeding failed", e);
+		}
+	}
+
+	/**
+	 * Stores a pre-registration packet the way a download from the pre-registration service would
+	 * (PreRegistrationDataSyncServiceImpl#downloadAndSavePacket): the zip (ID.json plus documents) is
+	 * encrypted for this machine, then re-encrypted and saved by the real PreRegZipHandlingService. "Fetch
+	 * Data" with {@link #MOCK_PRE_REG_ID} then goes through the unchanged decrypt / extract path.
+	 */
+	private void seedPreRegistration() {
+		PreRegistrationList existing = preRegistrationDAO.get(MOCK_PRE_REG_ID);
+		if (existing != null && new File(existing.getPacketPath()).exists())
+			return;
+		try {
+			ByteArrayOutputStream zip = new ByteArrayOutputStream();
+			try (ZipOutputStream out = new ZipOutputStream(zip)) {
+				out.putNextEntry(new ZipEntry("ID.json"));
+				out.write(readResource(PRE_REG_ID_JSON_RESOURCE));
+				out.closeEntry();
+				byte[] document = readResource(PRE_REG_DOCUMENT_RESOURCE);
+				for (String name : PRE_REG_DOCUMENTS) {
+					out.putNextEntry(new ZipEntry(name));
+					out.write(document);
+					out.closeEntry();
+				}
+			}
+			ApplicationContext.map().putIfAbsent(RegistrationConstants.PRE_REG_PACKET_LOCATION,
+					MockBackend.defaultGlobalConfig().get(RegistrationConstants.PRE_REG_PACKET_LOCATION));
+			byte[] publicKey = clientCryptoFacade.getClientSecurity().getEncryptionPublicPart();
+			PreRegistrationDTO saved = preRegZipHandlingService.encryptAndSavePreRegPacket(MOCK_PRE_REG_ID,
+					clientCryptoFacade.encrypt(publicKey, zip.toByteArray()));
+
+			SyncTransaction syncTransaction = syncManager.createSyncTransaction(
+					RegistrationConstants.RETRIEVED_PRE_REG_ID, RegistrationConstants.RETRIEVED_PRE_REG_ID,
+					RegistrationConstants.JOB_TRIGGER_POINT_SYSTEM, RegistrationConstants.OPT_TO_REG_PDS_J00003);
+			PreRegistrationList preRegistration = existing != null ? existing : new PreRegistrationList();
+			if (existing == null) {
+				preRegistration.setId(UUID.randomUUID().toString());
+				preRegistration.setPreRegId(MOCK_PRE_REG_ID);
+				preRegistration.setIsActive(true);
+				preRegistration.setIsDeleted(false);
+				preRegistration.setCrBy(SEEDER);
+				preRegistration.setCrDtime(Timestamp.valueOf(DateUtils.getUTCCurrentDateTime()));
+			}
+			preRegistration.setPacketSymmetricKey(saved.getSymmetricKey());
+			preRegistration.setPacketPath(saved.getPacketPath());
+			preRegistration.setStatusCode(syncTransaction.getStatusCode());
+			preRegistration.setStatusComment(syncTransaction.getStatusComment());
+			preRegistration.setsJobId(syncTransaction.getSyncJobId());
+			preRegistration.setSynctrnId(syncTransaction.getId());
+			preRegistration.setLangCode(syncTransaction.getLangCode());
+			preRegistration.setLastUpdatedPreRegTimeStamp(Timestamp.valueOf(DateUtils.getUTCCurrentDateTime()));
+			if (existing == null)
+				preRegistrationDAO.save(preRegistration);
+			else
+				preRegistrationDAO.update(preRegistration);
+			LOGGER.info("[MOCK SEED] Stored pre-registration {} at {}", MOCK_PRE_REG_ID, saved.getPacketPath());
+		} catch (Exception e) {
+			LOGGER.error("[MOCK SEED] Pre-registration seeding failed", e);
+		}
+	}
+
+	// ------------------------------------------------------------------
+
+	private static byte[] readResource(String resource) throws java.io.IOException {
+		try (InputStream in = MockDataSeeder.class.getResourceAsStream(resource)) {
+			if (in == null)
+				throw new java.io.IOException(resource + " not found on classpath");
+			return in.readAllBytes();
+		}
+	}
+
+	private static String lang() {
+		String lang = ApplicationContext.applicationLanguage();
+		return lang == null ? RegistrationConstants.ENGLISH_LANG_CODE : lang;
+	}
+
+	private static void stamp(io.mosip.registration.entity.RegistrationCommonFields entity) {
+		entity.setIsActive(Boolean.TRUE);
+		entity.setCrBy(SEEDER);
+		entity.setCrDtime(Timestamp.valueOf(DateUtils.getUTCCurrentDateTime()));
+	}
+}
