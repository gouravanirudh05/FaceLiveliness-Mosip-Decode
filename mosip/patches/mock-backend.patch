+/**
+ * Seeds the local Derby DB with the data a real server sync would normally
+ * deliver, so that login and the home screen work with no MOSIP backend.
+ * Active only when {@link MockBackend#isEnabled()}. Every step is idempotent
+ * (insert-if-absent), so it is safe to call repeatedly and across restarts.
+ *
+ * Seeded: machine_master, registration_center, global_param (client config),
+ * app_authentication_method (password login), screen_authorization, and, on
+ * request, a user with roles + user/machine mapping.
+ */
+@Component
+public class MockDataSeeder {
+
+	private static final Logger LOGGER = AppConfig.getLogger(MockDataSeeder.class);
+
+	public static final String MOCK_MACHINE_ID = "10001";
+	public static final String MOCK_CENTER_ID = "10001";
+	private static final String MOCK_MACHINE_SPEC_ID = "1001";
+	private static final String SEEDER = "MockSeeder";
+	private static final String APP_ID = "REGISTRATION";
+	private static final String PWD_METHOD = "PWD";
+
+	private static final List<String> ROLES = Arrays.asList(Role.REGISTRATION_OFFICER.name(),
+			Role.REGISTRATION_SUPERVISOR.name());
+
+	/** process ids from io.mosip.registration.constants.ProcessNames */
+	private static final List<String> AUTH_PROCESSES = Arrays.asList("login_auth", "packet_auth", "eod_auth",
+			"exception_auth", "onboard_auth");
+
+	/** root ids of the screens checked via BaseController#validateScreenAuthorization */
+	private static final List<String> SCREENS = Arrays.asList("newRegistrationRoot", "uinUpdateRoot", "lostUINRoot",
+			"correctionRoot", "uploadPacketRoot", "syncServerClientRoot", "eodRoot", "onBoardRoot",
+			"deviceSettingsRoot", "reRegistrationRootPane");
+
+	@Autowired
+	private MachineMasterRepository machineMasterRepository;
+	@Autowired
+	private RegistrationCenterRepository registrationCenterRepository;
+	@Autowired
+	private UserMachineMappingRepository userMachineMappingRepository;
+	@Autowired
+	private AppAuthenticationRepository appAuthenticationRepository;
+	@Autowired
+	private ScreenAuthorizationRepository screenAuthorizationRepository;
+	@Autowired
+	private UserDetailDAO userDetailDAO;
+	@Autowired
+	private GlobalParamDAO globalParamDAO;
+	@Autowired
+	private ClientCryptoFacade clientCryptoFacade;
+
+	private boolean baseSeeded = false;
+	private boolean newParamsInserted = false;
+
+	/** True if this JVM session inserted client config that needs an app restart to fully apply. */
+	public synchronized boolean hasInsertedNewParams() {
+		return newParamsInserted;
+	}
+
+	/** Seeds everything that is not user specific. Idempotent and cheap after the first call. */
+	public synchronized void ensureSeeded() {
+		if (!MockBackend.isEnabled() || baseSeeded)
+			return;
+
+		LOGGER.info("[MOCK SEED] Seeding base data into local DB");
+		String keyIndex = seedMachine();
+		seedCenter();
+		seedGlobalParams();
+		seedAuthMethods();
+		seedScreens();
+
+		// Normally set at the end of the first sync step of the real initialSync()
+		ApplicationContext.map().put(RegistrationConstants.KEY_INDEX, keyIndex);
+
+		baseSeeded = true;
+		LOGGER.info("[MOCK SEED] Base data seeded (machine {}, center {})", MOCK_MACHINE_ID, MOCK_CENTER_ID);
+	}
+
+	/** Seeds base data and makes sure the given user exists, is mapped to this machine and has roles. */
+	public synchronized void ensureUser(String userId) {
+		if (!MockBackend.isEnabled() || userId == null || userId.trim().isEmpty())
+			return;
+		ensureSeeded();
+
+		UserDetail existing = userDetailDAO.getUserDetail(userId);
+		if (existing == null) {
+			UserDetailDto dto = new UserDetailDto();
+			dto.setUserId(userId);
+			dto.setIsActive(Boolean.TRUE);
+			dto.setIsDeleted(Boolean.FALSE);
+			dto.setRegCenterId(MOCK_CENTER_ID);
+			userDetailDAO.save(dto);
+			LOGGER.info("[MOCK SEED] Created user {}", userId);
+		} else if (!MOCK_CENTER_ID.equals(existing.getRegCenterId())) {
+			// user left over from an earlier attempt, pointing at some other center
+			existing.setRegCenterId(MOCK_CENTER_ID);
+			userDetailDAO.update(existing);
+			LOGGER.info("[MOCK SEED] Re-pointed user {} to center {}", userId, MOCK_CENTER_ID);
+		}
+
+		if (userDetailDAO.getUserRoleByUserId(userId).isEmpty()) {
+			userDetailDAO.updateUserRolesAndUsername(userId, userId, new ArrayList<>(ROLES));
+		}
+
+		if (userMachineMappingRepository.findByUserMachineMappingIdUsrIdIgnoreCase(userId) == null) {
+			UserMachineMappingID id = new UserMachineMappingID();
+			id.setUsrId(userId);
+			id.setCntrId(MOCK_CENTER_ID);
+			id.setMachineId(MOCK_MACHINE_ID);
+
+			UserMachineMapping mapping = new UserMachineMapping();
+			mapping.setUserMachineMappingId(id);
+			mapping.setLangCode(lang());
+			mapping.setIsDeleted(Boolean.FALSE);
+			stamp(mapping);
+			userMachineMappingRepository.save(mapping);
+			LOGGER.info("[MOCK SEED] Mapped user {} to machine {}", userId, MOCK_MACHINE_ID);
+		}
+	}
+
+	// ------------------------------------------------------------------
+
+	/** @return the machine key index (fingerprint of the client encryption public key) */
+	private String seedMachine() {
+		byte[] encryptionPublicKey = clientCryptoFacade.getClientSecurity().getEncryptionPublicPart();
+		String keyIndex = CryptoUtil.computeFingerPrint(encryptionPublicKey, null);
+
+		String machineName = RegistrationSystemPropertiesChecker.getMachineId();
+		MachineMaster machine = machineMasterRepository.findByNameIgnoreCase(machineName);
+
+		if (machine == null) {
+			machine = new MachineMaster();
+			machine.setId(MOCK_MACHINE_ID);
+			machine.setName(machineName);
+			machine.setSerialNum("MOCK-SERIAL");
+			machine.setIpAddress("127.0.0.1");
+			machine.setMacAddress("00:00:00:00:00:00");
+			machine.setMachineSpecId(MOCK_MACHINE_SPEC_ID);
+			machine.setValidityDateTime(LocalDateTime.now().plusYears(10));
+			machine.setPublicKey(CryptoUtil.encodeToURLSafeBase64(encryptionPublicKey));
+			machine.setKeyIndex(keyIndex);
+			machine.setRegCenterId(MOCK_CENTER_ID);
+			stamp(machine);
+			machineMasterRepository.save(machine);
+			LOGGER.info("[MOCK SEED] Created machine {} ({})", MOCK_MACHINE_ID, machineName);
+		} else {
+			// keys are regenerated whenever .mosipkeys is wiped; keep the row in step with them
+			boolean dirty = false;
+			if (!keyIndex.equals(machine.getKeyIndex())) {
+				machine.setKeyIndex(keyIndex);
+				machine.setPublicKey(CryptoUtil.encodeToURLSafeBase64(encryptionPublicKey));
+				dirty = true;
+			}
+			if (!MOCK_CENTER_ID.equals(machine.getRegCenterId())) {
+				machine.setRegCenterId(MOCK_CENTER_ID);
+				dirty = true;
+			}
+			if (!Boolean.TRUE.equals(machine.getIsActive())) {
+				machine.setIsActive(Boolean.TRUE);
+				dirty = true;
+			}
+			if (dirty) {
+				machineMasterRepository.save(machine);
+				LOGGER.info("[MOCK SEED] Refreshed machine {}", machine.getId());
+			}
+		}
+		return keyIndex;
+	}
+
+	private void seedCenter() {
+		Set<String> langs = new HashSet<>(Arrays.asList(RegistrationConstants.ENGLISH_LANG_CODE, lang()));
+		for (String lang : langs) {
+			RegistartionCenterId id = new RegistartionCenterId();
+			id.setId(MOCK_CENTER_ID);
+			id.setLangCode(lang);
+
+			RegistrationCenter center = registrationCenterRepository.findById(RegistrationCenter.class, id);
+			if (center == null) {
+				center = new RegistrationCenter();
+				center.setRegistartionCenterId(id);
+				center.setName("Mock Registration Center");
+				center.setCenterTypeCode("REG");
+				center.setAddressLine1("Mock Address");
+				center.setLatitude("12.9716");
+				center.setLongitude("77.5946");
+				center.setLocationCode("MOCK");
+				center.setContactPerson("Mock Operator");
+				center.setContactPhone("9999999999");
+				center.setNumberOfKiosks(1);
+				center.setWorkingHours("8");
+				center.setPerKioskProcessTime(Time.valueOf("00:15:00"));
+				center.setCenterStartTime(Time.valueOf("09:00:00"));
+				center.setCenterEndTime(Time.valueOf("17:00:00"));
+				center.setLunchStartTime(Time.valueOf("13:00:00"));
+				center.setLunchEndTime(Time.valueOf("14:00:00"));
+				center.setTimeZone("UTC");
+				center.setIsDeleted(Boolean.FALSE);
+				stamp(center);
+				registrationCenterRepository.save(center);
+				LOGGER.info("[MOCK SEED] Created registration center {} ({})", MOCK_CENTER_ID, lang);
+			}
+		}
+	}
+
+	/**
+	 * Inserts every default from mock-global-config.properties that is not yet in
+	 * reg.global_param and publishes it to the live ApplicationContext map. Existing
+	 * rows are never overwritten.
+	 */
+	private void seedGlobalParams() {
+		Set<String> existing = new HashSet<>();
+		for (GlobalParam param : globalParamDAO.getAllEntries()) {
+			existing.add(param.getGlobalParamId().getCode());
+		}
+
+		List<GlobalParam> toSave = new ArrayList<>();
+		for (Map.Entry<String, String> entry : MockBackend.defaultGlobalConfig().entrySet()) {
+			if (existing.contains(entry.getKey()))
+				continue;
+			// the client reads these with (Long)/(Integer) casts and relies on its built-in defaults
+			// when they are absent; a String value loaded back from the DB would fail at startup
+			if (entry.getKey().startsWith("mosip.registration.retry."))
+				continue;
+
+			GlobalParamId id = new GlobalParamId();
+			id.setCode(entry.getKey());
+			id.setLangCode(RegistrationConstants.ENGLISH_LANG_CODE);
+
+			GlobalParam param = new GlobalParam();
+			param.setGlobalParamId(id);
+			param.setName(entry.getKey());
+			param.setTyp(RegistrationConstants.CONFIGURATION);
+			param.setVal(entry.getValue());
+			stamp(param);
+			toSave.add(param);
+
+			ApplicationContext.setGlobalConfigValueOf(entry.getKey(), entry.getValue());
+		}
+
+		if (!toSave.isEmpty()) {
+			globalParamDAO.saveAll(toSave);
+			newParamsInserted = true;
+			LOGGER.info("[MOCK SEED] Inserted {} global params", toSave.size());
+		}
+	}
+
+	private void seedAuthMethods() {
+		for (String process : AUTH_PROCESSES) {
+			for (String role : ROLES) {
+				AppAuthenticationMethodId id = new AppAuthenticationMethodId();
+				id.setAppId(APP_ID);
+				id.setProcessId(process);
+				id.setRoleCode(role);
+				id.setAuthMethodCode(PWD_METHOD);
+
+				if (appAuthenticationRepository.findById(AppAuthenticationMethod.class, id) != null)
+					continue;
+
+				AppAuthenticationMethod method = new AppAuthenticationMethod();
+				method.setAppAuthenticationMethodId(id);
+				method.setMethodSequence(1);
+				method.setLangCode(RegistrationConstants.ENGLISH_LANG_CODE);
+				stamp(method);
+				appAuthenticationRepository.save(method);
+			}
+		}
+	}
+
+	private void seedScreens() {
+		for (String role : ROLES) {
+			for (String screen : SCREENS) {
+				ScreenAuthorizationId id = new ScreenAuthorizationId();
+				id.setScreenId(screen);
+				id.setRoleCode(role);
+
+				if (screenAuthorizationRepository.findById(ScreenAuthorization.class, id) != null)
+					continue;
+
+				ScreenAuthorization auth = new ScreenAuthorization();
+				auth.setScreenAuthorizationId(id);
+				auth.setLangCode(RegistrationConstants.ENGLISH_LANG_CODE);
+				auth.setIsPermitted(Boolean.TRUE);
+				auth.setIsDeleted(Boolean.FALSE);
+				stamp(auth);
+				screenAuthorizationRepository.save(auth);
+			}
+		}
+	}
+
+	// ------------------------------------------------------------------
+
+	private static String lang() {
+		String lang = ApplicationContext.applicationLanguage();
+		return lang == null ? RegistrationConstants.ENGLISH_LANG_CODE : lang;
+	}
+
+	private static void stamp(io.mosip.registration.entity.RegistrationCommonFields entity) {
+		entity.setIsActive(Boolean.TRUE);
+		entity.setCrBy(SEEDER);
+		entity.setCrDtime(Timestamp.valueOf(DateUtils.getUTCCurrentDateTime()));
+	}
+}
