+	/** @return the machine key index (fingerprint of the client encryption public key) */
+	private String seedMachine() {
+		byte[] encryptionPublicKey = clientCryptoFacade.getClientSecurity().getEncryptionPublicPart();
+		String keyIndex = CryptoUtil.computeFingerPrint(encryptionPublicKey, null);
+
+		String machineName = RegistrationSystemPropertiesChecker.getMachineId();
+		MachineMaster machine = machineMasterRepository.findByNameIgnoreCase(machineName);
+
+		if (machine == null) {
+			machine = new MachineMaster();
+			machine.setId(MOCK_MACHINE_ID);
+			machine.setName(machineName);
+			machine.setSerialNum("MOCK-SERIAL");
+			machine.setIpAddress("127.0.0.1");
+			machine.setMacAddress("00:00:00:00:00:00");
+			machine.setMachineSpecId(MOCK_MACHINE_SPEC_ID);
+			machine.setValidityDateTime(LocalDateTime.now().plusYears(10));
+			machine.setPublicKey(CryptoUtil.encodeToURLSafeBase64(encryptionPublicKey));
+			machine.setKeyIndex(keyIndex);
+			machine.setRegCenterId(MOCK_CENTER_ID);
+			stamp(machine);
+			machineMasterRepository.save(machine);
+			LOGGER.info("[MOCK SEED] Created machine {} ({})", MOCK_MACHINE_ID, machineName);
+		} else {
+			// keys are regenerated whenever .mosipkeys is wiped; keep the row in step with them
+			boolean dirty = false;
+			if (!keyIndex.equals(machine.getKeyIndex())) {
+				machine.setKeyIndex(keyIndex);
+				machine.setPublicKey(CryptoUtil.encodeToURLSafeBase64(encryptionPublicKey));
+				dirty = true;
+			}
+			if (!MOCK_CENTER_ID.equals(machine.getRegCenterId())) {
+				machine.setRegCenterId(MOCK_CENTER_ID);
+				dirty = true;
+			}
+			if (!Boolean.TRUE.equals(machine.getIsActive())) {
+				machine.setIsActive(Boolean.TRUE);
+				dirty = true;
+			}
+			if (dirty) {
+				machineMasterRepository.save(machine);
+				LOGGER.info("[MOCK SEED] Refreshed machine {}", machine.getId());
+			}
+		}
+		return keyIndex;
+	}
