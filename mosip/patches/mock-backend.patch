+	/**
+	 * Stores a machine policy key certificate for REGISTRATION / {center}_{machine}, the
+	 * key packets are encrypted with. Normally the server issues it and fetchPolicy()
+	 * uploads it; here a self-signed one is generated and uploaded the same way.
+	 */
+	private void seedPolicyKey() {
+		MachineMaster machine = machineMasterRepository
+				.findByNameIgnoreCase(RegistrationSystemPropertiesChecker.getMachineId().toLowerCase());
+		if (machine == null)
+			return;
+		String refId = machine.getRegCenterId() + RegistrationConstants.UNDER_SCORE + machine.getId();
+
+		try {
+			KeyPairGenerateResponseDto existing = keymanagerService.getCertificate(RegistrationConstants.REG_APP_ID,
+					Optional.of(refId));
+			if (existing != null && existing.getCertificate() != null)
+				return;
+		} catch (Exception e) {
+			// not stored yet
+		}
+
+		try {
+			uploadSelfSignedCertificate(RegistrationConstants.REG_APP_ID, refId);
+			LOGGER.info("[MOCK SEED] Stored policy key for {}", refId);
+		} catch (Exception e) {
+			LOGGER.error("[MOCK SEED] Policy key seeding failed", e);
+		}
+	}
