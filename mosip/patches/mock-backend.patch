+	/**
+	 * Stores MOSIP's applicant type script (mosip-config release-1.2.0 applicanttype.mvel),
+	 * which picks the valid documents for an applicant. The real sync downloads it with a
+	 * "file-signature" header (a JWT over {"hash": sha256}) that RequiredFieldValidator
+	 * verifies against the SERVER-RESPONSE/SIGN-VERIFY certificate; here a self-signed
+	 * response-signing certificate is stored and the script is signed with it the same way.
+	 */
+	private void seedApplicantTypeScript() {
+		Path path = Paths.get(System.getProperty("user.dir"), APPLICANT_TYPE_SCRIPT);
+		if (path.toFile().exists() && fileSignatureRepository.findByFileName(APPLICANT_TYPE_SCRIPT).isPresent())
+			return;
+
+		try (InputStream in = MockDataSeeder.class.getResourceAsStream("/mock-" + APPLICANT_TYPE_SCRIPT)) {
+			if (in == null) {
+				LOGGER.error("[MOCK SEED] mock-{} not found on classpath", APPLICANT_TYPE_SCRIPT);
+				return;
+			}
+			byte[] script = in.readAllBytes();
+			Files.write(path, script);
+
+			KeyPair signer = uploadSelfSignedCertificate(RegistrationConstants.RESPONSE_SIGNATURE_PUBLIC_KEY_APP_ID,
+					RegistrationConstants.RESPONSE_SIGNATURE_PUBLIC_KEY_REF_ID);
+
+			// same signing input the verifier rebuilds: header . base64url(actual data)
+			String actualData = String.format("{\"hash\":\"%s\"}", HMACUtils2.digestAsPlainText(script));
+			String signingInput = b64Url("{\"alg\":\"RS256\"}".getBytes(StandardCharsets.UTF_8)) + "."
+					+ CryptoUtil.encodeToURLSafeBase64(actualData.getBytes(StandardCharsets.UTF_8));
+			Signature rsa = Signature.getInstance("SHA256withRSA");
+			rsa.initSign(signer.getPrivate());
+			rsa.update(signingInput.getBytes(StandardCharsets.US_ASCII));
+
+			FileSignature fileSignature = new FileSignature();
+			fileSignature.setFileName(APPLICANT_TYPE_SCRIPT);
+			fileSignature.setSignature(signingInput + "." + b64Url(rsa.sign()));
+			fileSignature.setEncrypted(Boolean.FALSE);
+			fileSignature.setContentLength(script.length);
+			fileSignatureRepository.save(fileSignature);
+			LOGGER.info("[MOCK SEED] Stored signed {}", APPLICANT_TYPE_SCRIPT);
+		} catch (Exception e) {
+			LOGGER.error("[MOCK SEED] Applicant type script seeding failed", e);
+		}
+	}
