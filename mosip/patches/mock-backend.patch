+package io.mosip.registration.util.restclient;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.time.Instant;
+import java.time.ZoneOffset;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Properties;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+
+import io.mosip.kernel.core.logger.spi.Logger;
+import io.mosip.registration.config.AppConfig;
+import io.mosip.registration.constants.RegistrationConstants;
+
+/**
+ * MOCK BACKEND -- LOCAL DEVELOPMENT / DEMO USE ONLY.
+ *
+ * Enabled with the JVM flag {@code -Dmosip.mock.backend=true}. When enabled:
+ * <ul>
+ * <li>{@link ServiceDelegateUtil} never makes an HTTP call; it returns the
+ * envelopes built here ({@code {"response": {...}, "errors": null}}, the same
+ * shape the real MOSIP services return).</li>
+ * <li>{@link AuthTokenUtilService} fabricates JWTs locally.</li>
+ * <li>The sync services (public key, TPM key, global params, master data, user
+ * details, CA certs, policy) short-circuit to "success" so they can never
+ * overwrite the locally seeded data.</li>
+ * <li>{@link MockDataSeeder} seeds the local Derby DB (machine, registration
+ * center, user, roles, login methods, screen permissions, global params, ID
+ * schema + process specs, master data).</li>
+ * </ul>
+ *
+ * Never enable this against a real deployment: it accepts any credentials.
+ */
+public final class MockBackend {
+
+	private static final Logger LOGGER = AppConfig.getLogger(MockBackend.class);
+
+	private static final String GLOBAL_CONFIG_RESOURCE = "/mock-global-config.properties";
+
+	private static final String ID_SCHEMA_RESOURCE = "/mock-id-schema.json";
+
+	private static final String MASTER_DATA_RESOURCE = "/mock-master-data.json";
+
+	private MockBackend() {
+	}
+
+	public static boolean isEnabled() {
+		return Boolean.parseBoolean(System.getProperty("mosip.mock.backend", "false"));
+	}
+
+	/**
+	 * Returns what {@code responseMap.get("responseBody")} would have been for the
+	 * given service, i.e. the full MOSIP envelope.
+	 */
+	public static Object mockResponseBody(String serviceName) {
+		LOGGER.info("[MOCK BACKEND] Faking response for service: {}", serviceName);
+
+		Map<String, Object> body;
+		switch (serviceName) {
+		case RegistrationConstants.MASTER_VALIDATOR_SERVICE_NAME:
+			body = new LinkedHashMap<>();
+			body.put("lastSyncTime", isoTimestampNow());
+			body.put("dataToSync", new ArrayList<Map<String, Object>>());
+			break;
+		case RegistrationConstants.GET_GLOBAL_CONFIG:
+			body = new LinkedHashMap<>();
+			body.put("configDetail", new LinkedHashMap<String, Object>());
+			break;
+		case RegistrationConstants.ID_SCHEMA_SYNC_SERVICE:
+			body = identitySchema();
+			break;
+		default:
+			body = new LinkedHashMap<>();
+			body.put("status", "SUCCESS");
+			body.put("message", "mock-backend: no real server call was made");
+		}
+		return envelope(body);
+	}
+
+	private static Map<String, Object> envelope(Object response) {
+		Map<String, Object> envelope = new LinkedHashMap<>();
+		envelope.put("id", null);
+		envelope.put("version", "1.0");
+		envelope.put("responsetime", isoTimestampNow());
+		envelope.put("metadata", null);
+		envelope.put(RegistrationConstants.RESPONSE, response);
+		envelope.put(RegistrationConstants.ERRORS, null);
+		return envelope;
+	}
+
+	/**
+	 * Default client configuration (what the config server would normally push).
+	 * Loaded from {@code mock-global-config.properties} on the classpath.
+	 */
+	public static Map<String, String> defaultGlobalConfig() {
+		Map<String, String> config = new LinkedHashMap<>();
+		try (InputStream in = MockBackend.class.getResourceAsStream(GLOBAL_CONFIG_RESOURCE)) {
+			if (in == null) {
+				LOGGER.error("[MOCK BACKEND] {} not found on classpath", GLOBAL_CONFIG_RESOURCE);
+				return config;
+			}
+			Properties properties = new Properties();
+			properties.load(in);
+			for (String key : properties.stringPropertyNames()) {
+				config.put(key, properties.getProperty(key).trim());
+			}
+		} catch (IOException e) {
+			LOGGER.error("[MOCK BACKEND] Failed to load " + GLOBAL_CONFIG_RESOURCE, e);
+		}
+		return config;
+	}
+
+	/**
+	 * The latest ID schema response, shaped like masterdata's
+	 * {@code /idschema/latest?domain=registration-client} (id, idVersion, schemaJson,
+	 * one key per UI spec type: settings, screens, schema, newProcess, ...).
+	 * Built from MOSIP's published sample data (mosip-data release-1.2.0,
+	 * identity_schema.csv + ui_spec.csv) and loaded from
+	 * {@code mock-id-schema.json} on the classpath.
+	 */
+	@SuppressWarnings("unchecked")
+	public static Map<String, Object> identitySchema() {
+		try (InputStream in = MockBackend.class.getResourceAsStream(ID_SCHEMA_RESOURCE)) {
+			if (in == null) {
+				LOGGER.error("[MOCK BACKEND] {} not found on classpath", ID_SCHEMA_RESOURCE);
+				return null;
+			}
+			Map<String, Object> schema = new ObjectMapper().readValue(in, LinkedHashMap.class);
+			// effective_from is now() in the published data
+			schema.put("effectiveFrom", DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS")
+					.withZone(ZoneOffset.UTC).format(Instant.now().minusSeconds(60)));
+			return schema;
+		} catch (IOException e) {
+			LOGGER.error("[MOCK BACKEND] Failed to load " + ID_SCHEMA_RESOURCE, e);
+			return null;
+		}
+	}
+
+	/**
+	 * Master data entities for the client sync, before encryption: a list of
+	 * {@code {entityName, entityType, rows}} where entityType is "structured" (rows are
+	 * entity JSON) or "dynamic" (rows are DynamicFieldDto per language). Built from
+	 * MOSIP's published sample data (mosip-data release-1.2.0, master CSVs) and loaded
+	 * from {@code mock-master-data.json} on the classpath.
+	 */
+	@SuppressWarnings("unchecked")
+	public static List<Map<String, Object>> masterData() {
+		try (InputStream in = MockBackend.class.getResourceAsStream(MASTER_DATA_RESOURCE)) {
+			if (in == null) {
+				LOGGER.error("[MOCK BACKEND] {} not found on classpath", MASTER_DATA_RESOURCE);
+				return new ArrayList<>();
+			}
+			return new ObjectMapper().readValue(in, List.class);
+		} catch (IOException e) {
+			LOGGER.error("[MOCK BACKEND] Failed to load " + MASTER_DATA_RESOURCE, e);
+			return new ArrayList<>();
+		}
+	}
+
+	/**
+	 * Builds a structurally valid, unsigned JWT (12h expiry) carrying the roles as
+	 * {@code realm_access.roles}. The client only ever calls {@code JWT.decode}
+	 * on tokens, never a verifier, so no real signature is needed.
+	 */
+	public static String buildMockJwt(String userId, String... roles) {
+		long now = Instant.now().getEpochSecond();
+		long exp = now + (12 * 60 * 60);
+		StringBuilder roleJson = new StringBuilder();
+		for (String role : roles) {
+			if (roleJson.length() > 0)
+				roleJson.append(',');
+			roleJson.append('"').append(esc(role)).append('"');
+		}
+		String header = "{\"alg\":\"none\",\"typ\":\"JWT\"}";
+		String payload = String.format(
+				"{\"sub\":\"%s\",\"name\":\"%s\",\"preferred_username\":\"%s\",\"iat\":%d,\"exp\":%d,"
+						+ "\"realm_access\":{\"roles\":[%s]}}",
+				esc(userId), esc(userId), esc(userId), now, exp, roleJson);
+		return b64(header) + "." + b64(payload) + "." + b64("mock-signature-not-verified");
+	}
+
+	private static String esc(String s) {
+		return s == null ? "" : s.replace("\\", "\\\\").replace("\"", "\\\"");
+	}
+
+	private static String b64(String s) {
+		return Base64.getUrlEncoder().withoutPadding().encodeToString(s.getBytes(StandardCharsets.UTF_8));
+	}
+
+	private static String isoTimestampNow() {
+		return DateTimeFormatter.ofPattern("yyyy-MM-dd'T'HH:mm:ss.SSS'Z'").withZone(ZoneOffset.UTC)
+				.format(Instant.now());
+	}
+}
